<script server>
useHead({
  htmlAttrs: { lang: 'en' },
  meta: [
    { name: 'color-scheme', content: 'light dark' },
    { name: 'theme-color', content: '#1f6bff' },
  ],
})
</script>
@appearanceBootstrap({
  storageKey: 'library-appearance',
  colorMode: { key: 'colorMode', attribute: 'color-mode', default: 'system' },
})
<style>
  /*
   * Library's design tokens. Two themes (light, dark), one accent, one radius
   * scale: 10px for controls and rows, 16px for sheets, full for circles and chips.
   * Text pairs are AA on their surfaces; the accent button's ink flips in dark mode
   * because white on the lighter dark-mode blue would not be.
   */
  :root {
    color-scheme: light;
    --bg: #fefefe;
    --bg-side: #f6f6f7;
    --bg-raised: #fefefe;
    --bg-field: #f1f3f6;
    --line: #e2e5ea;
    --text: #1c1f24;
    --text-2: #4d5562;
    --text-3: #626a78;
    --accent: #1f6bff;
    --accent-ink: #ffffff;
    --accent-soft: #e6eeff;
    --accent-text: #1856d6;
    --sel: #e1e4ea;
    --hover: #eef0f3;
    --star: #b87900;
    --danger: #c9291d;
    --danger-soft: #fdeceb;
    --ring: #8a93a3;
    --shadow: 0 10px 40px rgb(20 28 46 / .16), 0 2px 8px rgb(20 28 46 / .08);
    --font: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro', system-ui, 'Segoe UI', Roboto, sans-serif;
  }
  html.dark {
    color-scheme: dark;
    --bg: #1b1c1f;
    --bg-side: #232427;
    --bg-raised: #242629;
    --bg-field: #23272e;
    --line: #2b3038;
    --text: #e9ebef;
    --text-2: #b4bac6;
    --text-3: #9aa2b1;
    --accent: #4b8dff;
    --accent-ink: #08101f;
    --accent-soft: #1d2b49;
    --accent-text: #8db4ff;
    --sel: #262b34;
    --hover: #20242b;
    --star: #ffd24a;
    --danger: #ff8178;
    --danger-soft: #3a1f1e;
    --ring: #7b8494;
    --shadow: 0 12px 44px rgb(0 0 0 / .55), 0 2px 8px rgb(0 0 0 / .4);
  }
  html, body { margin: 0; background: var(--bg); color: var(--text); font-family: var(--font); font-size: 15px; line-height: 1.45; -webkit-font-smoothing: antialiased; }
  *, *::before, *::after { box-sizing: border-box; }
  button, input, select, textarea { font: inherit; color: inherit; }
  button { cursor: pointer; background: none; border: 0; padding: 0; }
  [hidden] { display: none !important; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 6px; }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; padding: 0; }

  /* Shell: three panes on a wide window, two on a tablet, one on a phone. */
  .k-shell { display: grid; grid-template-columns: 260px minmax(340px, 1fr) minmax(380px, 1.15fr); height: 100dvh; grid-template-rows: minmax(0, 1fr); overflow: hidden; }
  [data-stx-component-wrapper] { display: contents; }
  .k-pane { display: flex; flex-direction: column; min-width: 0; min-height: 0; overflow: hidden; }
  .k-side { background: var(--bg-side); border-right: 1px solid var(--line); }
  .k-main { background: var(--bg); border-right: 1px solid var(--line); }
  .k-detail { background: var(--bg-raised); }
  .k-shell[data-section='todos'], .k-shell[data-section='home'] { grid-template-columns: 260px minmax(0, 1fr); }
  @media (min-width: 720px) and (max-width: 1099px) {
    .k-shell { grid-template-columns: 240px 1fr; }
    .k-main { border-right: 0; }
    .k-shell .k-detail { display: none; }
    .k-shell[data-panel='detail'] .k-main { display: none; }
    .k-shell[data-panel='detail'] .k-detail { display: flex; }
  }
  @media (max-width: 719px) {
    .k-shell, .k-shell[data-section='todos'], .k-shell[data-section='home'] { grid-template-columns: 1fr; }
    .k-shell .k-pane { display: none; }
    .k-shell[data-panel='sidebar'] .k-side, .k-shell[data-panel='list'] .k-main, .k-shell[data-panel='detail'] .k-detail { display: flex; }
    .k-main, .k-side { border-right: 0; }
  }
  .k-icon-btn.k-back { display: none; }
  @media (max-width: 719px) { .k-icon-btn.k-back-main { display: inline-flex; } }
  @media (max-width: 1099px) { .k-icon-btn.k-back-detail { display: inline-flex; } }

  .k-scroll { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; }
  .k-head { display: flex; align-items: center; gap: 10px; padding: 18px 20px 8px; min-height: 64px; }
  .k-title { margin: 0; font-size: 26px; line-height: 1.15; font-weight: 700; letter-spacing: -.02em; flex: 1; min-width: 0; overflow-wrap: anywhere; }
  .k-title-input { width: 100%; background: transparent; border: 0; padding: 0; font-size: 26px; font-weight: 700; letter-spacing: -.02em; line-height: 1.15; }
  .k-sub { color: var(--text-3); font-size: 13px; }
  .k-section { margin: 0; padding: 18px 20px 6px; font-size: 13px; font-weight: 600; color: var(--text-2); display: flex; align-items: baseline; gap: 8px; }
  .k-section .k-sub { font-weight: 400; }
  .k-gap { height: 12px; }
  .k-sep { border: 0; border-top: 1px solid var(--line); margin: 12px 20px; }

  /* Buttons and fields */
  .k-btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 36px; padding: 0 14px; border-radius: 10px; font-weight: 600; font-size: 14px; white-space: nowrap; background: var(--bg-field); color: var(--text); transition: background-color .15s, transform .12s; }
  .k-btn:hover { background: var(--sel); }
  .k-btn:active { transform: scale(.98); }
  .k-btn-primary { background: var(--accent); color: var(--accent-ink); }
  .k-btn-primary:hover { background: var(--accent); filter: brightness(.94); }
  .k-btn-danger { background: var(--danger-soft); color: var(--danger); }
  .k-btn-quiet { background: transparent; color: var(--text-2); }
  .k-btn[disabled], .k-icon-btn[disabled] { opacity: .4; cursor: default; }
  .k-icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 10px; color: var(--text-2); flex: none; transition: background-color .15s; }
  .k-icon-btn:hover { background: var(--hover); color: var(--text); }
  .k-icon-btn[aria-pressed='true'] { color: var(--accent-text); }
  .k-input, .k-select, .k-textarea { width: 100%; min-height: 40px; padding: 8px 12px; background: var(--bg-field); border: 1px solid transparent; border-radius: 10px; color: var(--text); }
  .k-input::placeholder, .k-textarea::placeholder { color: var(--text-3); }
  .k-input:focus, .k-select:focus, .k-textarea:focus { outline: 2px solid var(--accent); outline-offset: 0; background: var(--bg-raised); }
  .k-label { display: block; margin-bottom: 6px; font-size: 13px; font-weight: 600; color: var(--text-2); }
  .k-field { margin-bottom: 14px; }
  .k-err { color: var(--danger); font-size: 13px; margin: 8px 0 0; }
  .k-chip { display: inline-flex; align-items: center; gap: 4px; min-height: 24px; padding: 0 10px; border-radius: 999px; font-size: 12px; font-weight: 500; background: var(--bg-field); color: var(--text-2); white-space: nowrap; }
  .k-chip-accent { background: var(--accent-soft); color: var(--accent-text); }
  .k-chip-danger { background: var(--danger-soft); color: var(--danger); }
  .k-chip-var { background: var(--accent-soft); color: var(--accent-text); border-radius: 6px; padding: 0 6px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; }
  .k-ico { display: inline-block; width: 18px; height: 18px; flex: none; }
  .k-ico-lg { width: 22px; height: 22px; }

  /* Sidebar */
  .k-nav { padding: 6px 10px 12px; }
  .k-nav-item { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 36px; padding: 0 10px; border-radius: 10px; color: var(--text); text-align: left; font-size: 15px; }
  .k-nav-item:hover { background: var(--hover); }
  .k-nav-item[aria-current='page'] { background: var(--sel); font-weight: 600; }
  .k-nav-item .k-count { margin-left: auto; color: var(--text-3); font-size: 13px; font-variant-numeric: tabular-nums; }
  .k-nav-group { padding: 14px 10px 4px; display: flex; align-items: center; justify-content: space-between; color: var(--text-3); font-size: 12px; font-weight: 600; }
  .k-nav-add { display: flex; align-items: center; gap: 8px; width: 100%; min-height: 34px; padding: 0 10px; border-radius: 10px; color: var(--text-3); font-size: 14px; }
  .k-nav-add:hover { background: var(--hover); color: var(--text-2); }
  .k-star { color: var(--star); }
  .k-over { color: var(--danger); }
  .k-foot { display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-top: 1px solid var(--line); }
  .k-avatar { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%; background: var(--accent-soft); color: var(--accent-text); font-size: 12px; font-weight: 700; flex: none; }
  .k-ring { width: 18px; height: 18px; flex: none; transform: rotate(-90deg); }
  .k-ring .k-ring-track { fill: none; stroke: var(--accent); stroke-width: 1.4; opacity: .55; }
  .k-ring .k-ring-pie { fill: none; stroke: var(--accent); stroke-width: 6.8; }

  /* To-do rows */
  .k-quick { display: flex; align-items: center; gap: 12px; margin: 4px 12px 8px; padding: 0 10px; min-height: 44px; border-radius: 10px; background: var(--bg-field); }
  .k-quick:focus-within { outline: 2px solid var(--accent); background: var(--bg-raised); }
  .k-quick input { flex: 1; min-width: 0; background: transparent; border: 0; outline: 0; min-height: 44px; }
  .k-quick input::placeholder { color: var(--text-3); }
  .k-rows { list-style: none; margin: 0; padding: 0 8px; }
  .k-row { position: relative; display: flex; align-items: flex-start; gap: 12px; padding: 10px 10px; margin: 1px 0; border-radius: 10px; min-height: 44px; cursor: default; transition: background-color .12s, opacity .25s ease, transform .25s ease, max-height .25s ease; max-height: 200px; }
  .k-row:hover { background: var(--hover); }
  .k-row[data-cursor='true'] { background: var(--hover); box-shadow: inset 0 0 0 1px var(--line); }
  .k-row[data-open='true'] { background: var(--sel); }
  .k-row[data-leaving='true'] { opacity: 0; transform: translateX(10px); max-height: 0; padding-top: 0; padding-bottom: 0; margin: 0; overflow: hidden; }
  .k-row[data-drop='before']::before, .k-row[data-drop='after']::after { content: ''; position: absolute; left: 10px; right: 10px; height: 2px; border-radius: 2px; background: var(--accent); }
  .k-row[data-drop='before']::before { top: -2px; }
  .k-row[data-drop='after']::after { bottom: -2px; }
  .k-row-body { flex: 1; min-width: 0; padding-top: 1px; }
  .k-row-title { display: block; width: 100%; text-align: left; font-size: 15px; line-height: 1.35; overflow-wrap: anywhere; }
  .k-row[data-done='true'] .k-row-title { color: var(--text-3); text-decoration: line-through; transition: color .3s; }
  .k-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 4px; }
  /* The checkbox is Things' rounded square on a wide window and a circle on a phone. */
  .k-check { position: relative; display: inline-flex; align-items: center; justify-content: center; flex: none; width: 16px; height: 16px; margin-top: 3px; border-radius: 4px; border: 1.5px solid var(--ring); color: var(--accent-ink); transition: background-color .2s ease, border-color .2s ease; }
  .k-check::after { content: ''; position: absolute; inset: -10px; }
  .k-check:hover { border-color: var(--text-2); }
  .k-check .k-tick { width: 12px; height: 12px; opacity: 0; transform: scale(.4); transition: opacity .16s ease, transform .22s cubic-bezier(.2, 1.4, .4, 1); }
  .k-check[aria-checked='true'] { background: var(--accent); border-color: var(--accent); animation: k-pop .34s cubic-bezier(.2, 1.3, .4, 1); }
  .k-check[aria-checked='true'] .k-tick { opacity: 1; transform: scale(1); }
  .k-check-sm { width: 14px; height: 14px; margin-top: 0; }
  .k-check-sm .k-tick { width: 10px; height: 10px; }
  @media (max-width: 719px) {
    .k-check { width: 26px; height: 26px; border-radius: 50%; margin-top: 0; }
    .k-check .k-tick { width: 16px; height: 16px; }
    .k-check-sm { width: 24px; height: 24px; }
  }
  @keyframes k-pop { 0% { transform: scale(.85); } 55% { transform: scale(1.14); } 100% { transform: scale(1); } }
  .k-handle { display: none; color: var(--text-3); cursor: grab; }
  .k-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; flex: 1; padding: 40px 28px; color: var(--text-3); text-align: center; }
  .k-empty .k-ico { width: 32px; height: 32px; opacity: .8; }
  .k-empty p { margin: 0; max-width: 28ch; font-size: 15px; }

  /* Detail */
  .k-detail-body { padding: 8px 22px 28px; }
  .k-pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .k-pill { display: inline-flex; align-items: center; gap: 6px; min-height: 34px; padding: 0 12px; border-radius: 999px; background: var(--bg-field); color: var(--text-2); font-size: 14px; }
  .k-pill:hover { background: var(--sel); }
  .k-pill[aria-checked='true'], .k-pill[aria-pressed='true'] { background: var(--accent-soft); color: var(--accent-text); font-weight: 600; }
  .k-row-field { display: flex; align-items: center; gap: 12px; min-height: 44px; border-top: 1px solid var(--line); }
  .k-row-field > .k-ico { color: var(--text-3); }
  .k-row-field > label, .k-row-field > .k-fieldname { width: 86px; flex: none; color: var(--text-2); font-size: 14px; }
  .k-row-field .k-control { flex: 1; min-width: 0; }
  .k-bare { background: transparent; border: 0; padding: 6px 0; width: 100%; min-height: 36px; }
  .k-bare:focus { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 6px; }
  .k-notes { width: 100%; resize: none; background: transparent; border: 0; padding: 8px 0; min-height: 96px; line-height: 1.55; field-sizing: content; }
  .k-notes:focus { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 6px; }
  .k-check-item { display: flex; align-items: center; gap: 10px; min-height: 40px; }
  .k-check-item input.k-bare { flex: 1; }
  .k-check-item[data-done='true'] input { color: var(--text-3); text-decoration: line-through; }
  .k-check-item .k-item-tools { display: none; gap: 0; }
  .k-check-item:hover .k-item-tools, .k-check-item:focus-within .k-item-tools { display: inline-flex; }
  .k-item-tools .k-icon-btn { width: 30px; height: 30px; }

  /* Rendered markdown */
  .md { line-height: 1.6; overflow-wrap: anywhere; }
  .md p { margin: 0; }
  .md h2, .md h3, .md h4 { margin: .6em 0 .15em; line-height: 1.25; font-weight: 700; letter-spacing: -.01em; }
  .md h2 { font-size: 1.45em; } .md h3 { font-size: 1.2em; } .md h4 { font-size: 1.05em; }
  .md ul, .md ol { margin: .2em 0; padding-left: 1.4em; }
  .md ul.md-checks { list-style: none; padding-left: 0; }
  .md-gap { height: .7em; }
  .md code { padding: 1px 5px; border-radius: 5px; background: var(--bg-field); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .92em; }
  .md a { color: var(--accent-text); text-underline-offset: 2px; }
  .md-check { display: flex; align-items: flex-start; gap: 10px; padding: 2px 0; }
  .md-box { position: relative; flex: none; width: 20px; height: 20px; margin-top: 2px; border-radius: 50%; border: 1.5px solid var(--ring); transition: background-color .2s, border-color .2s; }
  .md-box::before { content: ''; position: absolute; inset: -12px; }
  .md-box:hover { border-color: var(--accent); }
  .md-check.is-done .md-box { background: var(--accent); border-color: var(--accent); }
  .md-check.is-done .md-box::after { content: ''; position: absolute; left: 6px; top: 2.5px; width: 5px; height: 10px; border: solid var(--accent-ink); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .md-check.is-done span { color: var(--text-3); text-decoration: line-through; }

  /* Notes */
  .k-note { display: block; width: 100%; padding: 10px 14px; border-radius: 10px; text-align: left; }
  .k-note:hover { background: var(--hover); }
  .k-note[aria-current='true'] { background: var(--accent); color: var(--accent-ink); }
  .k-note[aria-current='true'] .k-sub, .k-note[aria-current='true'] .k-note-snippet { color: var(--accent-ink); opacity: .85; }
  .k-note-title { display: block; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .k-note-line { display: flex; gap: 8px; margin-top: 2px; font-size: 13px; }
  .k-note-snippet { color: var(--text-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .k-editor { flex: 1; min-height: 0; display: flex; flex-direction: column; }
  .k-editor textarea { flex: 1; width: 100%; resize: none; background: transparent; border: 0; outline: 0; padding: 4px 24px 24px; line-height: 1.6; font-size: 16px; }
  .k-editor .md { flex: 1; overflow-y: auto; padding: 4px 24px 24px; font-size: 16px; }
  .k-toolbar { display: flex; align-items: center; gap: 2px; padding: 8px 14px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .k-seg { display: inline-flex; padding: 2px; border-radius: 10px; background: var(--bg-field); }
  .k-seg button { min-height: 30px; padding: 0 12px; border-radius: 8px; font-size: 13px; font-weight: 600; color: var(--text-2); }
  .k-seg button[aria-pressed='true'] { background: var(--bg-raised); color: var(--text); box-shadow: 0 1px 2px rgb(0 0 0 / .12); }
  .k-search { display: flex; align-items: center; gap: 8px; margin: 4px 12px 8px; padding: 0 10px; min-height: 38px; border-radius: 10px; background: var(--bg-field); color: var(--text-3); }
  .k-search:focus-within { outline: 2px solid var(--accent); }
  .k-search input { flex: 1; min-width: 0; background: transparent; border: 0; outline: 0; min-height: 38px; color: var(--text); }

  /* Prompts */
  .k-prompt { display: block; width: 100%; padding: 12px 14px; border-radius: 10px; text-align: left; }
  .k-prompt:hover { background: var(--hover); }
  .k-prompt[aria-current='true'] { background: var(--sel); }
  .k-lib-badge { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 8px; flex: none; color: #fdfdfe; background: var(--accent); }
  .k-lib-badge .k-ico { width: 18px; height: 18px; }
  .k-body-edit { position: relative; }
  .k-body-edit textarea { min-height: 220px; line-height: 1.6; field-sizing: content; }
  .k-vars { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .k-filled { padding: 14px; border-radius: 10px; background: var(--bg-field); white-space: pre-wrap; line-height: 1.6; overflow-wrap: anywhere; }
  .k-filled mark { background: var(--accent-soft); color: var(--accent-text); border-radius: 4px; padding: 0 3px; }
  .k-person { display: flex; align-items: center; gap: 10px; min-height: 48px; }
  .k-person .k-grow { flex: 1; min-width: 0; }
  .k-person .k-name { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .k-switch { position: relative; width: 44px; height: 26px; border-radius: 999px; background: var(--ring); transition: background-color .2s; flex: none; }
  .k-switch::after { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fdfdfe; transition: transform .2s; }
  .k-switch[aria-checked='true'] { background: var(--accent); }
  .k-switch[aria-checked='true']::after { transform: translateX(18px); }

  .k-menu { position: relative; }
  .k-menu-panel { position: absolute; right: 0; top: calc(100% + 4px); z-index: 30; min-width: 190px; padding: 6px; border-radius: 12px; background: var(--bg-raised); border: 1px solid var(--line); box-shadow: var(--shadow); }
  .k-menu-panel button { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 38px; padding: 0 10px; border-radius: 8px; text-align: left; font-size: 14px; }
  .k-menu-panel button:hover { background: var(--hover); }
  .k-menu-panel button.is-danger { color: var(--danger); }

  /* Sheets, toasts */
  .k-scrim { position: fixed; inset: 0; z-index: 40; display: flex; align-items: flex-end; justify-content: center; background: rgb(10 14 22 / .45); }
  .k-sheet { width: 100%; max-width: 520px; max-height: 90dvh; overflow-y: auto; padding: 22px; background: var(--bg-raised); border-radius: 16px 16px 0 0; box-shadow: var(--shadow); animation: k-rise .22s cubic-bezier(.16, 1, .3, 1); }
  @media (min-width: 720px) { .k-scrim { align-items: center; } .k-sheet { border-radius: 16px; } }
  .k-drawer { align-items: stretch; justify-content: flex-end; }
  .k-drawer .k-sheet { max-width: 420px; max-height: none; height: 100%; border-radius: 0; animation: k-slide .24s cubic-bezier(.16, 1, .3, 1); }
  @keyframes k-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes k-slide { from { opacity: 0; transform: translateX(24px); } to { opacity: 1; transform: none; } }
  .k-sheet h2 { margin: 0 0 4px; font-size: 20px; font-weight: 700; letter-spacing: -.01em; }
  .k-sheet-head { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
  .k-sheet-head h2 { flex: 1; margin: 0; }
  .k-toasts { position: fixed; z-index: 60; left: 50%; bottom: 20px; transform: translateX(-50%); display: flex; flex-direction: column; gap: 8px; align-items: center; pointer-events: none; width: max-content; max-width: calc(100vw - 32px); }
  .k-toast { padding: 10px 16px; border-radius: 12px; background: var(--text); color: var(--bg); font-size: 14px; box-shadow: var(--shadow); animation: k-rise .2s ease; }
  .k-toast[data-tone='error'] { background: var(--danger); color: #fdfdfe; }
  .k-version { padding: 12px 0; border-top: 1px solid var(--line); }
  .k-version pre { margin: 8px 0 0; white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; font-size: 13px; color: var(--text-2); max-height: 110px; overflow: hidden; }

  /* Sign in */
  .k-auth { min-height: 100dvh; display: grid; place-items: center; padding: 24px 16px; }
  .k-auth-card { width: 100%; max-width: 380px; }
  .k-auth h1 { margin: 0 0 6px; font-size: 28px; font-weight: 700; letter-spacing: -.02em; }
  .k-mark { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 12px; background: var(--accent); color: var(--accent-ink); margin-bottom: 18px; }

  /* Phones: larger touch targets */
  @media (max-width: 719px) {
    .k-row { padding: 12px 10px; min-height: 52px; }
    .k-nav-item { min-height: 48px; font-size: 16px; }
    .k-nav-add { min-height: 44px; }
    .k-icon-btn { width: 44px; height: 44px; }
    .k-btn { min-height: 44px; }
    .k-pill { min-height: 44px; }
    .k-input, .k-select { min-height: 48px; font-size: 16px; }
    .k-check { width: 26px; height: 26px; }
    .k-note, .k-prompt { padding: 14px; }
    .k-check-item { min-height: 48px; }
    .k-quick, .k-quick input { min-height: 50px; }
    .k-title, .k-title-input { font-size: 24px; }
    .k-handle { display: none !important; }
    .k-item-tools { display: inline-flex !important; }
    .k-item-tools .k-icon-btn { width: 44px; height: 44px; }
  }
  @media (hover: hover) and (min-width: 720px) { .k-row[draggable='true'] .k-handle { display: inline-flex; position: absolute; left: -6px; top: 12px; opacity: 0; } .k-row:hover .k-handle { opacity: 1; } }

  /* Things look: sidebar glyphs, the main column, the toolbar, the inline editor. */
  .k-wrap { width: 100%; max-width: 780px; margin: 0 auto; padding-left: 28px; padding-right: 28px; }
  .k-pane.k-main > .k-head { padding: 34px 0 6px; max-width: 780px; margin: 0 auto; width: 100%; padding-left: 28px; padding-right: 28px; align-items: center; }
  .k-title { font-size: 26px; letter-spacing: -.015em; }
  .k-gl { display: inline-flex; width: 20px; height: 20px; flex: none; }
  .k-gl-inbox { color: #3d9be9; } .k-gl-today { color: #f5c518; } .k-gl-upcoming { color: #e2455c; }
  .k-gl-anytime { color: #4aa89b; } .k-gl-someday { color: #c8b06a; } .k-gl-logbook { color: #59b96a; } .k-gl-evening { color: #5b6fb8; }
  .k-gl-xl { width: 26px; height: 26px; }
  .k-nav-item { min-height: 32px; font-weight: 500; font-size: 14.5px; border-radius: 8px; }
  .k-nav-gap { height: 14px; }
  .k-sbar { display: flex; align-items: center; justify-content: space-between; padding: 6px 10px; border-top: 1px solid var(--line); min-height: 44px; }
  .k-bar { display: flex; align-items: center; justify-content: center; gap: 36px; min-height: 48px; border-top: 1px solid var(--line); flex: none; background: var(--bg); }
  .k-bar .k-icon-btn { color: var(--text-3); }
  .k-bar .k-icon-btn:hover { color: var(--text); }
  .k-menu-up .k-menu-panel { top: auto; bottom: calc(100% + 6px); left: 0; right: auto; }
  .k-menu-label { padding: 6px 10px 4px; color: var(--text-3); font-size: 12px; }
  .k-card { list-style: none; margin: 10px -12px; padding: 14px 16px 8px; border-radius: 10px; background: var(--bg-raised); box-shadow: 0 0 0 1px var(--line), 0 8px 28px rgb(20 28 46 / .10); animation: k-rise .16s ease; }
  html.dark .k-card { box-shadow: 0 0 0 1px var(--line), 0 8px 28px rgb(0 0 0 / .4); }
  .k-card-title { width: 100%; background: transparent; border: 0; padding: 0; min-height: 28px; font-size: 16px; font-weight: 600; outline: 0; }
  .k-card-title::placeholder { color: var(--text-3); font-weight: 500; }
  .k-card-tools { display: flex; align-items: center; gap: 2px; margin: 8px -6px 0; padding-top: 6px; }
  .k-card-tools .k-icon-btn { width: 32px; height: 32px; color: var(--text-3); }
  .k-card-tools .k-icon-btn[aria-pressed='true'] { color: var(--accent-text); background: var(--accent-soft); }
  .k-card-panel { padding: 10px 0 4px; }
  .k-note-icon { width: 14px; height: 14px; color: var(--text-3); margin-left: 6px; vertical-align: -1px; }
  .k-row { content-visibility: auto; contain-intrinsic-size: auto 36px; }
  @media (min-width: 720px) { .k-row { padding: 6px 10px; min-height: 32px; gap: 10px; } .k-row-body { padding-top: 0; } }
  .k-row-title { font-size: 15px; line-height: 1.4; }
  .k-more { display: block; margin: 8px auto 0; }

  /* Ghost text: a copy of the textarea's text, drawn behind it, with the suggestion in grey after the caret. */
  .k-ghost-wrap { position: relative; display: flex; flex: 1; min-height: 0; flex-direction: column; }
  .k-ghost { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
  .k-ghost-flow { white-space: pre-wrap; overflow-wrap: break-word; word-break: normal; line-height: 1.6; }
  .k-ghost-note .k-ghost-flow { padding: 4px 24px 24px; font-size: 16px; }
  .k-ghost-prompt .k-ghost-flow { padding: 9px 13px; font-size: 15px; }
  .k-ghost-before { color: transparent; }
  .k-ghost-text { color: var(--text-3); }
  .k-ghost-hint { display: inline-block; margin-left: 6px; padding: 0 5px; border-radius: 4px; border: 1px solid var(--line); color: var(--text-3); font-size: 11px; line-height: 16px; vertical-align: 2px; }
  .k-ghost-ta { position: relative; z-index: 1; background: transparent !important; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
  }
</style>
<div class="k-root">
  @slot('content')
</div>
