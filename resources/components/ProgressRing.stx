<script>
interface ProgressRingProps { value?: number, size?: number }
const { value = 0, size = 18 } = defineProps<ProgressRingProps>()
</script>
<script client>
  const prValue = useReactiveProp('value', 0)
  const prSize = useReactiveProp('size', 18)
  // Things draws a project's progress as a pie: a thin ring with a wedge filled inside it.
  // The wedge is a circle of radius 3.4 stroked 6.8 wide, so its dash length is a share of 2 * pi * 3.4 = 21.36.
  const prDash = derived(() => (21.36 * Math.max(0, Math.min(1, Number(prValue()) || 0))).toFixed(2) + ' 21.36')
</script>
<svg class="k-ring" viewBox="0 0 18 18" :width="prSize()" :height="prSize()" aria-hidden="true">
  <circle class="k-ring-track" cx="9" cy="9" r="7.6"></circle>
  <circle class="k-ring-pie" cx="9" cy="9" r="3.4" :stroke-dasharray="prDash()"></circle>
</svg>
