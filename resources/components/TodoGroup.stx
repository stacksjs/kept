<script>
interface TodoGroupProps { group?: any, projectNames?: boolean }
const { group = null, projectNames = true } = defineProps<TodoGroupProps>()
</script>
<script client>
  import { focusField } from '../functions/kept/client'
  import { deadlineLabel, deadlineState } from '../functions/kept/format'
  import { safe } from '../functions/kept/safe'

  const tgGroup = useReactiveProp('group', null)
  const tgNames = useReactiveProp('projectNames', true)
  const tgItems = derived(() => (tgGroup() ? tgGroup().items : []))
  const tgLabel = derived(() => (tgGroup() ? tgGroup().label : ''))
  const tgKind = derived(() => (tgGroup() ? tgGroup().kind : 'plain'))
  const tgBucket = derived(() => (tgGroup() ? tgGroup().bucket : ''))
  const tgReorder = derived(() => !!tgGroup() && tgGroup().reorder)
  const tgTasks = useStore('tasks')
  const tgWs = useStore('workspace')
  const tgDrop = state(null)

  const tgOpenId = derived(() => { const r = tgWs.route(); return r.section === 'todos' ? r.item : null })
  const tgCanDrag = derived(() => tgReorder() === true)
  const tgInToday = (todo) => {
    const view = tgWs.view()
    if (view.kind === 'list' && view.name === 'today') return false
    return todo.when === 'today' || todo.when === 'evening' || (todo.when === 'anytime' && !!todo.start_date && todo.start_date <= tgTasks.today())
  }
  const tgProjectOf = derived(() => (tgGroup() && tgKind() === 'project' ? tgWs.projects().find(p => p.id === tgGroup().ref) : null))
  function tgOpenProject() { if (tgKind() === 'project') tgWs.open({ section: 'todos', view: { kind: 'project', id: tgGroup().ref }, item: null }); else if (tgKind() === 'area') tgWs.open({ section: 'todos', view: { kind: 'area', id: tgGroup().ref }, item: null }) }
  const tgIsDone = (todo) => !!todo.completed_at || tgTasks.fading()[todo.id] !== undefined
  const tgLeaving = (todo) => tgTasks.fading()[todo.id] === 'leaving'
  const tgDeadline = (todo) => (todo.deadline ? deadlineLabel(todo.deadline, tgTasks.today()) : '')
  const tgDeadlineState = (todo) => (todo.deadline ? deadlineState(todo.deadline, tgTasks.today()) : 'later')
  const tgProject = (todo) => {
    if (!(tgNames() === true)) return ''
    const project = tgWs.projects().find(p => p.id === todo.project_id)
    if (project) return project.title
    const area = tgWs.areas().find(a => a.id === todo.area_id)
    return area ? area.title : ''
  }
  const tgChecks = (todo) => {
    const total = todo.checklist.length
    return total ? todo.checklist.filter(item => item.done).length + '/' + total : ''
  }
  const tgDropState = (todo) => { const d = tgDrop(); return d && d.id === todo.id ? (d.after ? 'after' : 'before') : null }

  // One list of chips per row (deadline, project, checklist progress, repeat, tags), so a row has a single loop instead of five conditionals.
  function tgChips(todo) {
    const chips = []
    if (todo.deadline && !todo.completed_at) chips.push({ key: 'due', icon: 'i-hugeicons-flag-02', text: tgDeadline(todo), tone: tgDeadlineState(todo) === 'overdue' ? 'k-chip-danger' : tgDeadlineState(todo) === 'today' ? 'k-chip-accent' : '' })
    const project = tgProject(todo)
    if (project) chips.push({ key: 'project', icon: 'i-hugeicons-folder-02', text: safe(project), tone: '' })
    const checks = tgChecks(todo)
    if (checks) chips.push({ key: 'checks', icon: 'i-hugeicons-check-list', text: checks, tone: '' })
    if (todo.repeat !== 'none') chips.push({ key: 'repeat', icon: 'i-hugeicons-repeat', text: todo.repeat, tone: '' })
    for (const tag of todo.tags) chips.push({ key: 'tag:' + tag, icon: 'i-hugeicons-tag-01', text: safe(tag), tone: '' })
    return chips
  }

  // One attribute carries every visual state of a row (cursor, done, leaving, drop line), so a row costs one binding for them, not four.
  function tgRowState(todo) {
    let state = ''
    if (tgTasks.cursor() === todo.id) state += ' cursor'
    if (tgIsDone(todo)) state += ' done'
    if (tgLeaving(todo)) state += ' leaving'
    const drop = tgDropState(todo)
    if (drop) state += ' drop-' + drop
    return state.trim()
  }

  function tgOpen(todo) { tgTasks.cursor.set(todo.id); tgWs.openItem(todo.id); focusField('todo-title') }
  function tgToggle(event, todo) { event.stopPropagation(); tgTasks.toggle(todo) }
  function tgDragStart(event, todo) {
    if (!tgCanDrag()) { event.preventDefault(); return }
    tgTasks.dragging.set(todo.id)
    event.dataTransfer.effectAllowed = 'move'
    event.dataTransfer.setData('text/plain', String(todo.id))
  }
  function tgDragOver(event, todo) {
    if (tgTasks.dragging() === null) return
    event.preventDefault()
    const box = event.currentTarget.getBoundingClientRect()
    tgDrop.set({ id: todo.id, after: event.clientY > box.top + box.height / 2 })
  }
  function tgDragEnd() { tgTasks.dragging.set(null); tgDrop.set(null) }
  function tgDropOn(event, todo) {
    event.preventDefault()
    const dragged = tgTasks.dragging()
    const spot = tgDrop()
    if (dragged !== null) tgTasks.dropOn(tgItems(), tgBucket(), dragged, todo.id, !!(spot && spot.after))
    tgDragEnd()
  }
  function tgDropEmpty(event) {
    event.preventDefault()
    const dragged = tgTasks.dragging()
    const todo = dragged === null ? null : tgTasks.find(dragged)
    if (todo && tgItems().length === 0) tgTasks.dropOn([], tgBucket(), dragged, -1, false)
    tgDragEnd()
  }
</script>

<section>
  <div class="k-day" :if="tgKind() === 'day'">
    <span class="k-day-num" :if="tgGroup().number" :text="tgGroup().number"></span>
    <span class="k-day-name" :text="tgLabel()"></span>
    <span class="k-day-rule"></span>
  </div>
  <div class="k-proj-head" :if="tgKind() === 'project' || tgKind() === 'area'">
    <ProgressRing :if="tgKind() === 'project'" :value="tgTasks.ring(tgGroup().ref)" :size="20" />
    <i class="i-hugeicons-folder-02 k-ico" :if="tgKind() === 'area'" style="color: var(--text-3)" aria-hidden="true"></i>
    <button type="button" :text="safe(tgLabel())" @click="tgOpenProject()"></button>
  </div>
  <h2 class="k-section" :if="tgKind() === 'plain' && tgLabel()">
    <i class="i-f7-moon-fill k-gl k-gl-evening" :if="tgBucket() === 'evening'" style="width: 16px; height: 16px" aria-hidden="true"></i>
    <span :text="tgLabel()"></span>
  </h2>
  <div class="k-day-empty" :if="tgKind() === 'day' && tgItems().length === 0"></div>
  <p class="k-sub" :if="tgItems().length === 0 && tgLabel() && tgBucket()" style="padding: 8px 10px 12px" @dragover="tgTasks.dragging() !== null && $event.preventDefault()" @drop="tgDropEmpty($event)">Drag a to-do here.</p>
  <ul class="k-rows" role="list" :if="tgItems().length > 0" style="padding: 0">
    <template :for="todo in tgItems()" :key="todo.id">
      <li class="k-row" :if="tgOpenId() !== todo.id" role="listitem" draggable="true"
          :data-state="tgRowState(todo)" @click="tgOpen(todo)" @dragstart="tgDragStart($event, todo)" @dragover="tgDragOver($event, todo)" @drop="tgDropOn($event, todo)" @dragend="tgDragEnd()">
        <button type="button" class="k-check" role="checkbox" :aria-checked="tgIsDone(todo) ? 'true' : 'false'" :aria-label="safe((tgIsDone(todo) ? 'Mark not done: ' : 'Complete: ') + todo.title)" @click="tgToggle($event, todo)">
          <i class="i-hugeicons-tick-02 k-tick" aria-hidden="true"></i>
        </button>
        <div class="k-row-body">
          <button type="button" class="k-row-title"><i class="i-f7-star-fill k-ico k-today-star" :if="tgInToday(todo)" aria-label="In Today"></i><span :text="safe(todo.title || 'New to-do')"></span><i class="i-hugeicons-file-01 k-ico k-note-icon" :if="todo.notes" aria-hidden="true"></i></button>
          <div class="k-meta" :if="tgChips(todo).length"><span class="k-chip" :for="chip in tgChips(todo)" :key="chip.key" :class="chip.tone"><i class="k-ico" :class="chip.icon" style="width: 13px; height: 13px" aria-hidden="true"></i><span :text="chip.text"></span></span></div>
        </div>
      </li>
      <li class="k-card" :if="tgOpenId() === todo.id"><TodoEditor /></li>
    </template>
  </ul>
  <button type="button" class="k-show-more" :if="tgGroup() && tgGroup().more > 0" @click="tgTasks.expand(tgGroup().ref)" :text="'Show ' + tgGroup().more + ' more'"></button>
</section>
