<script>
interface TodoGroupProps { items?: any[], label?: string, sub?: string, icon?: string, bucket?: string, reorder?: boolean, projectNames?: boolean }
const { items = [], label = '', sub = '', icon = '', bucket = '', reorder = false, projectNames = true } = defineProps<TodoGroupProps>()
</script>
<script client>
  import { safe } from '../functions/kept/safe'
  import { focusField } from '../functions/kept/client'
  import { deadlineLabel, deadlineState } from '../functions/kept/format'

  const tgItems = useReactiveProp('items', [])
  const tgLabel = useReactiveProp('label', '')
  const tgSub = useReactiveProp('sub', '')
  const tgIcon = useReactiveProp('icon', '')
  const tgBucket = useReactiveProp('bucket', '')
  const tgReorder = useReactiveProp('reorder', false)
  const tgNames = useReactiveProp('projectNames', true)
  const tgTasks = useStore('tasks')
  const tgWs = useStore('workspace')
  const tgDrop = state(null)

  const tgOpenId = derived(() => { const r = tgWs.route(); return r.section === 'todos' ? r.item : null })
  const tgCanDrag = derived(() => tgReorder() === true || tgReorder() === 'true')
  const tgIsDone = (todo) => !!todo.completed_at || tgTasks.fading()[todo.id] !== undefined
  const tgLeaving = (todo) => tgTasks.fading()[todo.id] === 'leaving'
  const tgDeadline = (todo) => (todo.deadline ? deadlineLabel(todo.deadline, tgTasks.today()) : '')
  const tgDeadlineState = (todo) => (todo.deadline ? deadlineState(todo.deadline, tgTasks.today()) : 'later')
  const tgProject = (todo) => {
    if (!(tgNames() === true || tgNames() === 'true')) return ''
    const project = tgWs.projects().find(p => p.id === todo.project_id)
    if (project) return project.title
    const area = tgWs.areas().find(a => a.id === todo.area_id)
    return area ? area.title : ''
  }
  const tgChecks = (todo) => {
    const total = todo.checklist.length
    return total ? todo.checklist.filter(item => item.done).length + '/' + total : ''
  }
  const tgDropState = (todo) => { const d = tgDrop(); return d && d.id === todo.id ? (d.after ? 'after' : 'before') : null }

  function tgOpen(todo) { tgTasks.cursor.set(todo.id); tgWs.openItem(todo.id); focusField('todo-title') }
  function tgToggle(event, todo) { event.stopPropagation(); tgTasks.toggle(todo) }
  function tgDragStart(event, todo) {
    if (!tgCanDrag()) { event.preventDefault(); return }
    tgTasks.dragging.set(todo.id)
    event.dataTransfer.effectAllowed = 'move'
    event.dataTransfer.setData('text/plain', String(todo.id))
  }
  function tgDragOver(event, todo) {
    if (tgTasks.dragging() === null) return
    event.preventDefault()
    const box = event.currentTarget.getBoundingClientRect()
    tgDrop.set({ id: todo.id, after: event.clientY > box.top + box.height / 2 })
  }
  function tgDragEnd() { tgTasks.dragging.set(null); tgDrop.set(null) }
  function tgDropOn(event, todo) {
    event.preventDefault()
    const dragged = tgTasks.dragging()
    const spot = tgDrop()
    if (dragged !== null) tgTasks.dropOn(tgItems(), tgBucket(), dragged, todo.id, !!(spot && spot.after))
    tgDragEnd()
  }
  function tgDropEmpty(event) {
    event.preventDefault()
    const dragged = tgTasks.dragging()
    const todo = dragged === null ? null : tgTasks.find(dragged)
    if (todo && tgItems().length === 0) tgTasks.dropOn([], tgBucket(), dragged, -1, false)
    tgDragEnd()
  }
</script>

<section>
  <h2 class="k-section" :if="tgLabel()">
    <i class="k-gl i-f7-moon-fill k-gl-evening" :if="tgBucket() === 'evening'" style="width: 16px; height: 16px" aria-hidden="true"></i>
    <span :text="tgLabel()"></span>
    <span class="k-sub" :if="tgSub()" :text="tgSub()"></span>
  </h2>
  <p class="k-sub" :if="tgItems().length === 0 && tgLabel() && tgBucket()" style="padding: 8px 10px 12px" @dragover="tgTasks.dragging() !== null && $event.preventDefault()" @drop="tgDropEmpty($event)">Drag a to-do here.</p>
  <ul class="k-rows" role="list" :if="tgItems().length > 0" style="padding: 0">
    <template :for="todo in tgItems()" :key="todo.id">
      <li class="k-row" :if="tgOpenId() !== todo.id" role="listitem"
          :data-cursor="tgTasks.cursor() === todo.id ? 'true' : 'false'" :data-done="tgIsDone(todo) ? 'true' : 'false'" :data-leaving="tgLeaving(todo) ? 'true' : 'false'" :data-drop="tgDropState(todo)"
          :draggable="tgCanDrag() ? 'true' : 'false'" @click="tgOpen(todo)" @dragstart="tgDragStart($event, todo)" @dragover="tgDragOver($event, todo)" @drop="tgDropOn($event, todo)" @dragend="tgDragEnd()">
        <button type="button" class="k-check" role="checkbox" :aria-checked="tgIsDone(todo) ? 'true' : 'false'" :aria-label="safe((tgIsDone(todo) ? 'Mark not done: ' : 'Complete: ') + todo.title)" @click="tgToggle($event, todo)">
          <i class="k-tick i-hugeicons-tick-02" aria-hidden="true"></i>
        </button>
        <div class="k-row-body">
          <button type="button" class="k-row-title" :aria-label="safe('Open: ' + todo.title)"><span :text="safe(todo.title || 'New to-do')"></span><i class="k-ico k-note-icon i-hugeicons-file-01" :if="todo.notes" aria-hidden="true"></i></button>
          <div class="k-meta" :if="todo.deadline || todo.tags.length || tgProject(todo) || tgChecks(todo) || todo.repeat !== 'none'">
            <span class="k-chip" :class="tgDeadlineState(todo) === 'overdue' ? 'k-chip-danger' : tgDeadlineState(todo) === 'today' ? 'k-chip-accent' : ''" :if="todo.deadline && !todo.completed_at">
              <i class="k-ico i-hugeicons-flag-02" style="width: 13px; height: 13px" aria-hidden="true"></i><span :text="tgDeadline(todo)"></span>
            </span>
            <span class="k-chip" :if="tgProject(todo)"><i class="k-ico i-hugeicons-folder-02" style="width: 13px; height: 13px" aria-hidden="true"></i><span :text="safe(tgProject(todo))"></span></span>
            <span class="k-chip" :if="tgChecks(todo)"><i class="k-ico i-hugeicons-check-list" style="width: 13px; height: 13px" aria-hidden="true"></i><span :text="tgChecks(todo)"></span></span>
            <span class="k-chip" :if="todo.repeat !== 'none'"><i class="k-ico i-hugeicons-repeat" style="width: 13px; height: 13px" aria-hidden="true"></i><span :text="todo.repeat"></span></span>
            <span class="k-chip" :for="tag in todo.tags" :key="tag"><i class="k-ico i-hugeicons-tag-01" style="width: 13px; height: 13px" aria-hidden="true"></i><span :text="safe(tag)"></span></span>
          </div>
        </div>
      </li>
      <li class="k-card" :if="tgOpenId() === todo.id"><TodoEditor /></li>
    </template>
  </ul>
</section>
