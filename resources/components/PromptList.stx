<script client>
  import { libraryColor, libraryIcon } from '../functions/kept/promptview'
  import { initials } from '../functions/kept/format'

  const plWs = useStore('workspace')
  const plPrompts = useStore('prompts')
  const plNew = state(false)
  const plTitle = state('')
  const plEditSheet = state(false)
  const plLibrary = plPrompts.library
  const plId = plPrompts.libraryId
  const plOpenId = derived(() => { const r = plWs.route(); return r.section === 'prompts' ? r.item : null })
  const plOwned = derived(() => plWs.libraries().owned)
  const plShared = derived(() => plWs.libraries().shared)
  const plRoleText = derived(() => (plPrompts.role() === 'viewer' ? 'You can view and copy prompts' : plPrompts.role() === 'editor' ? 'You can edit prompts' : ''))
  const plSub = derived(() => {
    const lib = plLibrary()
    if (!lib) return ''
    return lib.shared ? 'Shared by ' + (lib.owner || 'someone') + '. ' + plRoleText() : lib.description
  })
  const plEmptyText = derived(() => (plPrompts.search().trim() || plPrompts.favoritesOnly() ? 'No prompts match.' : plPrompts.canEdit() ? 'No prompts yet. Add the first one with the plus button.' : 'This library has no prompts yet.'))

  effect(() => { if (plId()) { plPrompts.search.set(''); } })

  const plPreview = (prompt) => prompt.description || prompt.body.replace(/\s+/g, ' ').slice(0, 120) || 'Empty prompt'

  async function plCreateLibrary(event) {
    event.preventDefault()
    const title = plTitle()
    plTitle.set('')
    plNew.set(false)
    await plWs.createLibrary(title)
  }
  function plAskDelete() {
    plWs.confirm('Delete this library?', 'Every prompt in it, and anyone it is shared with, loses access.', 'Delete library', () => plPrompts.removeLibrary())
  }
</script>

<section class="k-main k-pane" aria-label="Prompts">
  <!-- Library overview -->
  <div :if="!plId()" class="k-pane" style="flex: 1">
    <header class="k-head">
      <button type="button" class="k-back k-back-main k-icon-btn" aria-label="Back to lists" @click="plWs.back()"><i class="i-hugeicons-arrow-left-01 k-ico" aria-hidden="true"></i></button>
      <h1 class="k-title">Prompt libraries</h1>
      <button type="button" class="k-icon-btn" aria-label="New library" title="New library" @click="plNew.set(true)"><i class="i-hugeicons-plus-sign k-ico k-ico-lg" aria-hidden="true"></i></button>
    </header>
    <div class="k-scroll">
      <form class="k-quick" :if="plNew()" @submit="plCreateLibrary($event)">
        <label class="sr-only" for="pl-new">Library name</label>
        <input id="pl-new" type="text" data-autofocus x-model="plTitle" placeholder="Library name" @keydown="$event.key === 'Escape' && plNew.set(false)">
      </form>
      <ul class="k-rows" role="list">
        <li :for="lib in plOwned()" :key="lib.id" role="listitem">
          <button type="button" class="k-prompt" style="display: flex; gap: 12px; align-items: center" @click="plWs.open({ section: 'prompts', library: lib.id, item: null })">
            <span class="k-lib-badge" :style="'background:' + libraryColor(lib.color)"><i class="k-ico" :class="libraryIcon(lib.icon)" aria-hidden="true"></i></span>
            <span style="flex: 1; min-width: 0"><strong style="display: block" :text="lib.title"></strong><span class="k-sub" :text="lib.description || (lib.prompts || 0) + ' prompts'"></span></span>
            <i class="i-hugeicons-link-02 k-ico" :if="lib.linked" style="color: var(--text-3)" aria-label="Has a public link"></i>
          </button>
        </li>
      </ul>
      <h2 class="k-section" :if="plShared().length">Shared with me</h2>
      <ul class="k-rows" role="list" :if="plShared().length">
        <li :for="lib in plShared()" :key="'s' + lib.id" role="listitem">
          <button type="button" class="k-prompt" style="display: flex; gap: 12px; align-items: center" @click="plWs.open({ section: 'prompts', library: lib.id, item: null })">
            <span class="k-lib-badge" :style="'background:' + libraryColor(lib.color)"><i class="k-ico" :class="libraryIcon(lib.icon)" aria-hidden="true"></i></span>
            <span style="flex: 1; min-width: 0"><strong style="display: block" :text="lib.title"></strong><span class="k-sub" :text="'From ' + (lib.owner || 'someone')"></span></span>
            <span class="k-chip" :text="lib.role"></span>
          </button>
        </li>
      </ul>
      <EmptyState :if="plWs.loaded() && !plOwned().length && !plShared().length" icon="i-hugeicons-book-02" text="Create a library to keep the prompts you reuse." />
    </div>
  </div>

  <!-- One library -->
  <div :if="plId()" class="k-pane" style="flex: 1">
    <header class="k-head">
      <button type="button" class="k-back k-back-main k-icon-btn" aria-label="Back to lists" @click="plWs.back()"><i class="i-hugeicons-arrow-left-01 k-ico" aria-hidden="true"></i></button>
      <span class="k-lib-badge" :if="plLibrary()" :style="'background:' + libraryColor(plLibrary().color)"><i class="k-ico" :class="libraryIcon(plLibrary().icon)" aria-hidden="true"></i></span>
      <div style="flex: 1; min-width: 0">
        <h1 class="k-title" style="font-size: 22px" :text="plLibrary() ? plLibrary().title : ''"></h1>
        <p class="k-sub" :if="plSub()" style="margin: 2px 0 0" :text="plSub()"></p>
      </div>
      <button type="button" class="k-icon-btn" :if="plPrompts.isOwner()" aria-label="Share library" title="Share" @click="plPrompts.showShare()"><i class="i-hugeicons-share-08 k-ico k-ico-lg" aria-hidden="true"></i></button>
      <button type="button" class="k-icon-btn" :if="plPrompts.canEdit()" aria-label="New prompt" title="New prompt (N)" @click="plPrompts.create()"><i class="i-hugeicons-plus-sign k-ico k-ico-lg" aria-hidden="true"></i></button>
      <MoreMenu :if="plPrompts.isOwner()" label="Library options">
        <button type="button" role="menuitem" @click="plEditSheet.set(true)"><i class="i-hugeicons-pencil-edit-02 k-ico" aria-hidden="true"></i>Edit library</button>
        <button type="button" role="menuitem" class="is-danger" @click="plAskDelete()"><i class="i-hugeicons-delete-02 k-ico" aria-hidden="true"></i>Delete library</button>
      </MoreMenu>
    </header>

    <div style="display: flex; align-items: center; gap: 8px; padding-right: 12px">
      <div class="k-search" style="flex: 1">
        <i class="i-hugeicons-search-01 k-ico" aria-hidden="true"></i>
        <label class="sr-only" for="pl-search">Search prompts</label>
        <input id="pl-search" type="search" data-focus="search" x-model="plPrompts.search" placeholder="Search prompts" autocomplete="off">
      </div>
      <button type="button" class="k-pill" :aria-pressed="plPrompts.favoritesOnly() ? 'true' : 'false'" @click="plPrompts.favoritesOnly.update(v => !v)"><i class="i-hugeicons-favourite k-ico" style="width: 15px; height: 15px" aria-hidden="true"></i>Favorites</button>
    </div>

    <div class="k-scroll">
      <ul class="k-rows" role="list">
        <li :for="prompt in plPrompts.visible()" :key="prompt.id" role="listitem" style="position: relative">
          <button type="button" class="k-prompt" :aria-current="plOpenId() === prompt.id ? 'true' : 'false'" @click="plPrompts.open(prompt.id)">
            <strong style="display: block; padding-right: 40px" :text="prompt.title"></strong>
            <span class="k-sub" style="display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap" :text="plPreview(prompt)"></span>
            <span class="k-meta" :if="prompt.tags.length || prompt.model"><span class="k-chip k-chip-accent" :if="prompt.model" :text="prompt.model"></span><span class="k-chip" :for="tag in prompt.tags" :key="tag" :text="tag"></span></span>
          </button>
          <button type="button" class="k-icon-btn" style="position: absolute; right: 6px; top: 8px" :aria-pressed="prompt.favorite ? 'true' : 'false'" :aria-label="(prompt.favorite ? 'Remove from favorites: ' : 'Add to favorites: ') + prompt.title" :disabled="!plPrompts.canEdit()" @click="plPrompts.toggleFavorite(prompt.id)">
            <i class="k-ico" :class="prompt.favorite ? 'i-hugeicons-favourite' : 'i-hugeicons-favourite'" :style="prompt.favorite ? 'color: var(--accent-text)' : 'opacity: .55'" aria-hidden="true"></i>
          </button>
        </li>
      </ul>
      <EmptyState :if="plPrompts.loadedFor() && plPrompts.visible().length === 0" icon="i-hugeicons-sparkles" :text="plEmptyText()" />
      <div class="k-gap"></div>
    </div>
  </div>

  <LibraryEditSheet :open="plEditSheet()" @close="plEditSheet.set(false)" />
</section>
