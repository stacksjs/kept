<script client>
  import { safe } from '../functions/kept/safe'
  import { noteDate } from '../functions/kept/format'
  import { daysLeft } from '../functions/kept/trash'

  const nlWs = useStore('workspace')
  const nlNotes = useStore('notes')
  const nlSearch = state('')
  const nlFolder = nlNotes.folder
  const nlTitle = derived(() => {
    const folder = nlFolder()
    if (folder === 'all') return 'All notes'
    if (folder === 'trash') return 'Recently deleted'
    if (typeof folder === 'string') return '#' + folder.slice(4)
    const found = nlWs.folders().find(f => f.id === folder)
    return found ? found.title : 'Notes'
  })
  const nlOpenId = derived(() => { const r = nlWs.route(); return r.section === 'notes' ? r.item : null })
  const nlFolderName = (note) => {
    if (nlFolder() !== 'all' || !note.note_folder_id) return ''
    const found = nlWs.folders().find(f => f.id === note.note_folder_id)
    return found ? found.title : ''
  }
  const nlEmpty = derived(() => nlNotes.loaded() && nlNotes.visible().length === 0)
  const nlEmptyText = derived(() => (nlNotes.searching() ? 'No notes match your search.' : nlFolder() === 'all' ? 'No notes yet. Start one with the plus button.' : nlFolder() === 'trash' ? 'Deleted notes stay here for 30 days.' : typeof nlFolder() === 'string' ? 'No notes use this tag.' : 'This folder is empty.'))

  effect(() => { nlNotes.search.set(nlSearch()) })

  const nlDate = (note) => {
    if (nlFolder() === 'trash') { const entry = nlNotes.deletedEntry(note.id); return entry ? daysLeft(entry) + ' days left' : '' }
    return noteDate(note.updated_at)
  }
  const nlIsFolder = derived(() => typeof nlFolder() === 'number')
  function nlScroll(event) {
    const box = event.target
    if (nlNotes.hasMore() && box.scrollHeight - box.scrollTop - box.clientHeight < 400) nlNotes.more()
  }
  const nlPreview = (note) => safe(nlNotes.snippetFor(note) || 'No additional text')
  function nlAskDelete() {
    const id = nlFolder()
    if (typeof id !== 'number') return
    nlWs.confirm('Delete this folder?', 'Notes inside it move to All notes.', 'Delete folder', () => nlWs.removeFolder(id))
  }
</script>

<section class="k-main k-pane" aria-label="Notes">
  <header class="k-head">
    <button type="button" class="k-back k-back-main k-icon-btn" aria-label="Back to lists" @click="nlWs.back()"><i class="i-hugeicons-arrow-left-01 k-ico" aria-hidden="true"></i></button>
    <h1 class="k-title" :text="safe(nlTitle())"></h1>
    <MoreMenu :if="nlIsFolder()" label="Folder options">
      <button type="button" role="menuitem" class="is-danger" @click="nlAskDelete()"><i class="i-hugeicons-delete-02 k-ico" aria-hidden="true"></i>Delete folder</button>
    </MoreMenu>
    <button type="button" class="k-icon-btn" :if="!nlNotes.inTrash()" aria-label="New note" title="New note (N)" @click="nlNotes.create()"><i class="i-hugeicons-note-add k-ico k-ico-lg" aria-hidden="true"></i></button>
  </header>

  <div class="k-search">
    <i class="i-hugeicons-search-01 k-ico" aria-hidden="true"></i>
    <label class="sr-only" for="nl-search">Search notes</label>
    <input id="nl-search" type="search" data-focus="search" x-model="nlSearch" placeholder="Search notes" autocomplete="off">
  </div>

  <div class="k-scroll" @scroll="nlScroll($event)">
    <div :for="section in nlNotes.sections()" :key="section.key">
      <h2 class="k-section" :if="section.label"><i class="i-hugeicons-pin k-ico" :if="section.key === 'pinned'" style="width: 14px; height: 14px" aria-hidden="true"></i><span :text="section.label"></span></h2>
      <ul class="k-rows" role="list">
        <li :for="note in section.notes" :key="note.id" role="listitem">
          <button type="button" class="k-note" :aria-current="nlOpenId() === note.id ? 'true' : 'false'" @click="nlNotes.open(note.id)">
            <span class="k-note-title" :text="safe(note.title || 'New note')"></span>
            <span class="k-note-line">
              <span class="k-sub" :text="nlDate(note)"></span>
              <span class="k-note-snippet" :text="nlPreview(note)"></span>
              <span class="k-sub" :if="nlFolderName(note)" style="margin-left: auto; white-space: nowrap" :text="safe(nlFolderName(note))"></span>
            </span>
          </button>
        </li>
      </ul>
    </div>
    <button type="button" class="k-btn k-btn-quiet k-more" :if="nlNotes.hasMore()" @click="nlNotes.more()">Show more</button>
    <EmptyState :if="nlEmpty()" icon="i-hugeicons-note-01" :text="nlEmptyText()" />
    <div class="k-gap"></div>
  </div>
</section>
