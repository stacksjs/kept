<script client>
  import { dayLabel, shortDate } from '../functions/kept/format'
  import { renderMarkdown, toggleCheckLine } from '../functions/kept/markdown'
  import { parseTagInput, whenPatch } from '../functions/kept/todos'

  const tdWs = useStore('workspace')
  const tdTasks = useStore('tasks')
  const tdTodo = tdTasks.selected
  const tdTitle = state('')
  const tdNotes = state('')
  const tdEditNotes = state(false)
  const tdTagText = state('')
  const tdCheckText = state('')
  let tdLast = 0

  effect(() => {
    const todo = tdTodo()
    if (todo && todo.id !== tdLast) {
      tdLast = todo.id
      tdTitle.set(todo.title)
      tdNotes.set(todo.notes)
      tdEditNotes.set(false)
      tdTagText.set('')
      tdCheckText.set('')
    }
    if (!todo) tdLast = 0
  })

  const tdDone = derived(() => !!(tdTodo() && tdTodo().completed_at))
  const tdRendered = derived(() => renderMarkdown(tdNotes()))
  const tdShowRendered = derived(() => !tdEditNotes() && tdNotes().trim().length > 0)
  const tdToday = tdTasks.today
  const tdIsToday = derived(() => { const t = tdTodo(); return !!t && (t.when === 'today' || (t.when === 'anytime' && !!t.start_date && t.start_date <= tdToday())) })
  const tdIsAnytime = derived(() => { const t = tdTodo(); return !!t && t.when === 'anytime' && !t.start_date })
  const tdScheduled = derived(() => { const t = tdTodo(); return t && t.start_date && t.start_date > tdToday() ? t.start_date : '' })
  const tdPlace = derived(() => { const t = tdTodo(); return t ? (t.project_id ? 'p:' + t.project_id : t.area_id ? 'a:' + t.area_id : '') : '' })
  const tdCompletedLabel = derived(() => { const t = tdTodo(); return t && t.completed_at ? dayLabel(t.completed_at.slice(0, 10), tdToday()) : '' })
  const tdCheckDone = derived(() => (tdTodo() ? tdTodo().checklist.filter(i => i.done).length : 0))

  function tdTitleInput(event) {
    tdTitle.set(event.target.value)
    if (tdTodo()) tdTasks.update(tdTodo().id, { title: event.target.value }, 450)
  }
  function tdNotesInput(event) {
    tdNotes.set(event.target.value)
    if (tdTodo()) tdTasks.update(tdTodo().id, { notes: event.target.value }, 500)
  }
  function tdEditNotesNow() { tdEditNotes.set(true); focusField('todo-notes') }
  function tdNotesClick(event) {
    const box = event.target.closest('button[data-line]')
    if (box) {
      const next = toggleCheckLine(tdNotes(), Number(box.getAttribute('data-line')))
      tdNotes.set(next)
      tdTasks.update(tdTodo().id, { notes: next }, 300)
      return
    }
    if (event.target.closest('a')) return
    tdEditNotesNow()
  }
  function tdNotesBlur() { if (tdNotes().trim()) tdEditNotes.set(false) }
  function tdSetWhen(choice) { tdTasks.update(tdTodo().id, whenPatch(choice)) }
  function tdSetDate(event) { if (event.target.value) tdSetWhen({ date: event.target.value }) }
  function tdSetDeadline(event) { tdTasks.update(tdTodo().id, { deadline: event.target.value || null }) }
  function tdSetRepeat(event) { tdTasks.update(tdTodo().id, { repeat: event.target.value }) }
  function tdSetPlace(event) {
    const value = event.target.value
    const id = Number(value.slice(2))
    tdTasks.update(tdTodo().id, { project_id: value.startsWith('p:') ? id : null, area_id: value.startsWith('a:') ? id : null })
  }
  function tdAddTags(event) {
    event.preventDefault()
    const next = parseTagInput(tdTagText(), tdTodo().tags)
    tdTagText.set('')
    if (next.length !== tdTodo().tags.length) tdTasks.update(tdTodo().id, { tags: next })
  }
  function tdTagKey(event) { if (event.key === ',') tdAddTags(event) }
  function tdDropTag(tag) { tdTasks.update(tdTodo().id, { tags: tdTodo().tags.filter(t => t !== tag) }) }
  async function tdAddCheck(event) {
    event.preventDefault()
    const title = tdCheckText()
    tdCheckText.set('')
    await tdTasks.addCheck(tdTodo().id, title)
  }
  function tdRenameCheck(item, event) {
    const title = event.target.value.trim()
    if (!title) { event.target.value = item.title; return }
    if (title !== item.title) tdTasks.setCheck(tdTodo().id, item.id, { title })
  }
  function tdAskDelete() {
    const id = tdTodo().id
    tdWs.confirm('Delete this to-do?', 'It will be removed from all your lists.', 'Delete to-do', () => tdTasks.remove(id))
  }
</script>

<section class="k-pane k-detail" aria-label="To-do details">
  <EmptyState :if="!tdTodo()" icon="i-hugeicons-task-01" text="Select a to-do to see its details." />

  <div :if="tdTodo()" class="k-scroll">
    <header class="k-head" style="align-items: flex-start; padding-top: 20px">
      <button type="button" class="k-icon-btn k-back k-back-detail" aria-label="Back to the list" @click="tdWs.back()"><i class="k-ico i-hugeicons-arrow-left-01" aria-hidden="true"></i></button>
      <button type="button" class="k-check" style="margin-top: 7px" role="checkbox" :aria-checked="tdDone() ? 'true' : 'false'" :aria-label="tdDone() ? 'Mark not done' : 'Complete'" @click="tdTasks.toggle(tdTodo())"><i class="k-tick i-hugeicons-tick-02" aria-hidden="true"></i></button>
      <div style="flex: 1; min-width: 0">
        <label class="sr-only" for="td-title">Title</label>
        <input id="td-title" class="k-title-input" data-focus="todo-title" type="text" :value="tdTitle()" placeholder="New to-do" @input="tdTitleInput($event)">
        <p class="k-sub" :if="tdDone()" style="margin: 4px 0 0">Completed <span :text="tdCompletedLabel()"></span></p>
      </div>
    </header>

    <div class="k-detail-body">
      <div :if="tdShowRendered()" class="md" role="button" tabindex="0" aria-label="Notes. Press Enter to edit." :html="tdRendered()" @click="tdNotesClick($event)" @keydown="$event.key === 'Enter' && tdEditNotesNow()" style="min-height: 48px; padding: 8px 0"></div>
      <div :if="!tdShowRendered()">
        <label class="sr-only" for="td-notes">Notes</label>
        <textarea id="td-notes" class="k-notes" data-focus="todo-notes" :value="tdNotes()" placeholder="Notes. Markdown works, including - [ ] checklists." @input="tdNotesInput($event)" @blur="tdNotesBlur()"></textarea>
      </div>

      <div class="k-row-field" style="margin-top: 8px; align-items: flex-start; padding: 10px 0">
        <i class="k-ico i-hugeicons-calendar-03" style="margin-top: 6px" aria-hidden="true"></i>
        <span class="k-fieldname" id="td-when" style="padding-top: 6px">When</span>
        <div class="k-control">
          <div class="k-pills" role="radiogroup" aria-labelledby="td-when">
            <button type="button" class="k-pill" role="radio" :aria-checked="tdIsToday() && tdTodo().when !== 'evening' ? 'true' : 'false'" @click="tdSetWhen('today')"><i class="k-ico k-star i-hugeicons-star" style="width: 15px; height: 15px" aria-hidden="true"></i>Today</button>
            <button type="button" class="k-pill" role="radio" :aria-checked="tdTodo().when === 'evening' ? 'true' : 'false'" @click="tdSetWhen('evening')"><i class="k-ico i-hugeicons-moon-02" style="width: 15px; height: 15px" aria-hidden="true"></i>This Evening</button>
            <button type="button" class="k-pill" role="radio" :aria-checked="tdIsAnytime() ? 'true' : 'false'" @click="tdSetWhen('anytime')">Anytime</button>
            <button type="button" class="k-pill" role="radio" :aria-checked="tdTodo().when === 'someday' ? 'true' : 'false'" @click="tdSetWhen('someday')">Someday</button>
          </div>
          <div style="display: flex; align-items: center; gap: 8px; margin-top: 8px">
            <label class="k-sub" for="td-date">On a date</label>
            <input id="td-date" class="k-input" type="date" style="width: auto; min-height: 36px" :value="tdScheduled()" @change="tdSetDate($event)">
          </div>
        </div>
      </div>

      <div class="k-row-field">
        <i class="k-ico i-hugeicons-flag-02" aria-hidden="true"></i>
        <label for="td-deadline">Deadline</label>
        <div class="k-control" style="display: flex; align-items: center; gap: 8px">
          <input id="td-deadline" class="k-input" type="date" style="width: auto; min-height: 36px" :value="tdTodo().deadline || ''" @change="tdSetDeadline($event)">
          <button type="button" class="k-btn k-btn-quiet" :if="tdTodo().deadline" @click="tdTasks.update(tdTodo().id, { deadline: null })">Clear</button>
        </div>
      </div>

      <div class="k-row-field">
        <i class="k-ico i-hugeicons-repeat" aria-hidden="true"></i>
        <label for="td-repeat">Repeat</label>
        <div class="k-control">
          <select id="td-repeat" class="k-select" style="width: auto; min-height: 36px" :value="tdTodo().repeat" @change="tdSetRepeat($event)">
            <option value="none">Never</option><option value="daily">Daily</option><option value="weekly">Weekly</option><option value="monthly">Monthly</option><option value="yearly">Yearly</option>
          </select>
        </div>
      </div>

      <div class="k-row-field">
        <i class="k-ico i-hugeicons-folder-02" aria-hidden="true"></i>
        <label for="td-place">List</label>
        <div class="k-control">
          <select id="td-place" class="k-select" style="width: auto; max-width: 100%; min-height: 36px" :value="tdPlace()" @change="tdSetPlace($event)">
            <option value="">No project or area</option>
            <option :for="area in tdWs.areas()" :key="'a' + area.id" :value="'a:' + area.id" :text="'Area: ' + area.title"></option>
            <option :for="project in tdWs.projects()" :key="'p' + project.id" :value="'p:' + project.id" :text="'Project: ' + project.title"></option>
          </select>
        </div>
      </div>

      <div class="k-row-field" style="align-items: flex-start; padding: 8px 0">
        <i class="k-ico i-hugeicons-tag-01" style="margin-top: 10px" aria-hidden="true"></i>
        <label for="td-tags" style="padding-top: 8px">Tags</label>
        <div class="k-control">
          <div class="k-pills">
            <span class="k-chip k-chip-accent" :for="tag in tdTodo().tags" :key="tag" style="min-height: 30px">
              <span :text="tag"></span>
              <button type="button" class="k-icon-btn" style="width: 22px; height: 22px" :aria-label="'Remove tag ' + tag" @click="tdDropTag(tag)"><i class="k-ico i-hugeicons-cancel-01" style="width: 12px; height: 12px" aria-hidden="true"></i></button>
            </span>
          </div>
          <form @submit="tdAddTags($event)" style="margin-top: 6px">
            <input id="td-tags" class="k-input" type="text" list="td-taglist" x-model="tdTagText" placeholder="Add a tag" style="min-height: 36px" @keydown="tdTagKey($event)">
            <datalist id="td-taglist"><option :for="tag in tdTasks.tags()" :key="tag" :value="tag"></option></datalist>
          </form>
        </div>
      </div>

      <h2 class="k-section" style="padding-left: 0; padding-top: 22px">Checklist <span class="k-sub" :if="tdTodo().checklist.length" :text="tdCheckDone() + ' of ' + tdTodo().checklist.length"></span></h2>
      <ul style="list-style: none; margin: 0; padding: 0" role="list">
        <li class="k-check-item" :for="(item, index) in tdTodo().checklist" :key="item.id" :data-done="item.done ? 'true' : 'false'">
          <button type="button" class="k-check k-check-sm" role="checkbox" :aria-checked="item.done ? 'true' : 'false'" :aria-label="(item.done ? 'Mark not done: ' : 'Done: ') + item.title" @click="tdTasks.setCheck(tdTodo().id, item.id, { done: !item.done })"><i class="k-tick i-hugeicons-tick-02" aria-hidden="true"></i></button>
          <input class="k-bare" type="text" :value="item.title" :aria-label="'Checklist item ' + (index + 1)" @change="tdRenameCheck(item, $event)">
          <span class="k-item-tools">
            <button type="button" class="k-icon-btn" :aria-label="'Move up: ' + item.title" :disabled="index === 0" @click="tdTasks.moveCheck(tdTodo().id, item.id, -1)"><i class="k-ico i-hugeicons-arrow-up-02" aria-hidden="true"></i></button>
            <button type="button" class="k-icon-btn" :aria-label="'Move down: ' + item.title" :disabled="index === tdTodo().checklist.length - 1" @click="tdTasks.moveCheck(tdTodo().id, item.id, 1)"><i class="k-ico i-hugeicons-arrow-down-02" aria-hidden="true"></i></button>
            <button type="button" class="k-icon-btn" :aria-label="'Delete: ' + item.title" @click="tdTasks.removeCheck(tdTodo().id, item.id)"><i class="k-ico i-hugeicons-delete-02" aria-hidden="true"></i></button>
          </span>
        </li>
      </ul>
      <form class="k-check-item" @submit="tdAddCheck($event)">
        <i class="k-ico i-hugeicons-plus-sign" style="color: var(--text-3)" aria-hidden="true"></i>
        <label class="sr-only" for="td-check">Add a checklist item</label>
        <input id="td-check" class="k-bare" type="text" x-model="tdCheckText" placeholder="Add a checklist item">
      </form>

      <div style="display: flex; gap: 8px; margin-top: 28px; padding-top: 16px; border-top: 1px solid var(--line)">
        <button type="button" class="k-btn" :if="tdDone()" @click="tdTasks.reopen(tdTodo().id)"><i class="k-ico i-hugeicons-delete-put-back" aria-hidden="true"></i>Reopen</button>
        <button type="button" class="k-btn k-btn-danger" style="margin-left: auto" @click="tdAskDelete()"><i class="k-ico i-hugeicons-delete-02" aria-hidden="true"></i>Delete</button>
      </div>
    </div>
  </div>
</section>
