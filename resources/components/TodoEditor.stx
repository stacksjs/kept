<script client>
  import { focusField } from '../functions/kept/client'
  import { dayLabel, deadlineLabel } from '../functions/kept/format'
  import { renderMarkdown, toggleCheckLine } from '../functions/kept/markdown'
  import { safe } from '../functions/kept/safe'
  import { parseTagInput, whenLabel, whenPatch } from '../functions/kept/todos'

  const teWs = useStore('workspace')
  const teTasks = useStore('tasks')
  const teTodo = teTasks.selected
  const teTitle = state('')
  const teNotes = state('')
  const teEditNotes = state(false)
  const teTab = state('')
  const teTagText = state('')
  const teCheckText = state('')
  let teLast = 0

  effect(() => {
    const todo = teTodo()
    if (todo && todo.id !== teLast) {
      teLast = todo.id
      teTitle.set(todo.title)
      teNotes.set(todo.notes)
      teEditNotes.set(false)
      teTab.set('')
      teTagText.set('')
      teCheckText.set('')
    }
    if (!todo) teLast = 0
  })

  effect(() => { const wanted = teTasks.editorTab(); if (wanted && teTodo()) { teTab.set(wanted); teTasks.editorTab.set('') } })

  const teToday = teTasks.today
  const teDone = derived(() => !!(teTodo() && teTodo().completed_at))
  const teRendered = derived(() => renderMarkdown(teNotes()))
  const teShowRendered = derived(() => !teEditNotes() && teNotes().trim().length > 0)
  const teIsToday = derived(() => { const t = teTodo(); return !!t && (t.when === 'today' || (t.when === 'anytime' && !!t.start_date && t.start_date <= teToday())) })
  const teIsAnytime = derived(() => { const t = teTodo(); return !!t && t.when === 'anytime' && !t.start_date })
  const teScheduled = derived(() => { const t = teTodo(); return t && t.start_date && t.start_date > teToday() ? t.start_date : '' })
  const tePlace = derived(() => { const t = teTodo(); return t ? (t.project_id ? 'p:' + t.project_id : t.area_id ? 'a:' + t.area_id : '') : '' })
  const teWhen = derived(() => { const t = teTodo(); return t ? (teScheduled() ? dayLabel(teScheduled(), teToday()) : whenLabel(t, teToday())) : '' })
  const teCheckDone = derived(() => (teTodo() ? teTodo().checklist.filter(i => i.done).length : 0))
  const teShowCheck = derived(() => !!teTodo() && (teTodo().checklist.length > 0 || teTab() === 'checklist'))

  const teToggle = (tab) => teTab.update(current => (current === tab ? '' : tab))
  function teTitleInput(event) {
    teTitle.set(event.target.value)
    if (teTodo()) teTasks.update(teTodo().id, { title: event.target.value }, 450)
  }
  function teTitleKey(event) {
    if (event.key === 'Enter') { event.preventDefault(); teClose() }
  }
  function teNotesInput(event) {
    teNotes.set(event.target.value)
    if (teTodo()) teTasks.update(teTodo().id, { notes: event.target.value }, 500)
  }
  function teEditNotesNow() { teEditNotes.set(true); focusField('todo-notes') }
  function teNotesClick(event) {
    const box = event.target.closest('button[data-line]')
    if (box) {
      const next = toggleCheckLine(teNotes(), Number(box.getAttribute('data-line')))
      teNotes.set(next)
      teTasks.update(teTodo().id, { notes: next }, 300)
      return
    }
    if (event.target.closest('a')) return
    teEditNotesNow()
  }
  function teNotesBlur() { if (teNotes().trim()) teEditNotes.set(false) }
  function teClose() { teTasks.flushAll(); teWs.openItem(null) }
  function teSetWhen(choice) { teTasks.update(teTodo().id, whenPatch(choice)) }
  function teSetDate(event) { if (event.target.value) teSetWhen({ date: event.target.value }) }
  function teSetDeadline(event) { teTasks.update(teTodo().id, { deadline: event.target.value || null }) }
  function teSetRepeat(event) { teTasks.update(teTodo().id, { repeat: event.target.value }) }
  function teSetPlace(event) {
    const value = event.target.value
    const id = Number(value.slice(2))
    teTasks.update(teTodo().id, { project_id: value.startsWith('p:') ? id : null, area_id: value.startsWith('a:') ? id : null })
  }
  function teAddTags(event) {
    event.preventDefault()
    const next = parseTagInput(teTagText(), teTodo().tags)
    teTagText.set('')
    if (next.length !== teTodo().tags.length) teTasks.update(teTodo().id, { tags: next })
  }
  function teTagKey(event) { if (event.key === ',') teAddTags(event) }
  function teDropTag(tag) { teTasks.update(teTodo().id, { tags: teTodo().tags.filter(t => t !== tag) }) }
  async function teAddCheck(event) {
    event.preventDefault()
    const title = teCheckText()
    teCheckText.set('')
    await teTasks.addCheck(teTodo().id, title)
  }
  function teRenameCheck(item, event) {
    const title = event.target.value.trim()
    if (!title) { event.target.value = item.title; return }
    if (title !== item.title) teTasks.setCheck(teTodo().id, item.id, { title })
  }
  function teAskDelete() {
    const id = teTodo().id
    teWs.confirm('Delete this to-do?', 'It will be removed from all your lists.', 'Delete to-do', () => teTasks.remove(id))
  }
</script>

<div :if="teTodo()" data-todo-editor @keydown="$event.key === 'Escape' && teClose()">
  <div style="display: flex; gap: 10px; align-items: flex-start">
    <button type="button" class="k-check" role="checkbox" :aria-checked="teDone() ? 'true' : 'false'" :aria-label="teDone() ? 'Mark not done' : 'Complete'" @click="teTasks.toggle(teTodo())"><i class="k-tick i-hugeicons-tick-02" aria-hidden="true"></i></button>
    <div style="flex: 1; min-width: 0">
      <label class="sr-only" for="te-title">Title</label>
      <input id="te-title" class="k-card-title" data-focus="todo-title" type="text" :value="teTitle()" placeholder="New to-do" @input="teTitleInput($event)" @keydown="teTitleKey($event)">

      <div :if="teShowRendered()" class="md" role="button" tabindex="0" aria-label="Notes. Press Enter to edit." :html="teRendered()" @click="teNotesClick($event)" @keydown="$event.key === 'Enter' && teEditNotesNow()" style="min-height: 28px; padding: 4px 0; color: var(--text-2); font-size: 14px"></div>
      <div :if="!teShowRendered()">
        <label class="sr-only" for="te-notes">Notes</label>
        <textarea id="te-notes" class="k-notes" style="min-height: 28px; padding: 4px 0; font-size: 14px" data-focus="todo-notes" :value="teNotes()" placeholder="Notes" @input="teNotesInput($event)" @blur="teNotesBlur()"></textarea>
      </div>

      <div :if="teShowCheck()" style="margin: 6px 0 2px">
        <ul style="list-style: none; margin: 0; padding: 0" role="list">
          <li class="k-check-item" :for="(item, index) in teTodo().checklist" :key="item.id" :data-done="item.done ? 'true' : 'false'">
            <button type="button" class="k-check k-check-sm" role="checkbox" :aria-checked="item.done ? 'true' : 'false'" :aria-label="safe((item.done ? 'Mark not done: ' : 'Done: ') + item.title)" @click="teTasks.setCheck(teTodo().id, item.id, { done: !item.done })"><i class="k-tick i-hugeicons-tick-02" aria-hidden="true"></i></button>
            <input class="k-bare" type="text" :value="item.title" :aria-label="'Checklist item ' + (index + 1)" style="font-size: 14px" @change="teRenameCheck(item, $event)">
            <span class="k-item-tools">
              <button type="button" class="k-icon-btn" :aria-label="safe('Move up: ' + item.title)" :disabled="index === 0" @click="teTasks.moveCheck(teTodo().id, item.id, -1)"><i class="k-ico i-hugeicons-arrow-up-02" aria-hidden="true"></i></button>
              <button type="button" class="k-icon-btn" :aria-label="safe('Move down: ' + item.title)" :disabled="index === teTodo().checklist.length - 1" @click="teTasks.moveCheck(teTodo().id, item.id, 1)"><i class="k-ico i-hugeicons-arrow-down-02" aria-hidden="true"></i></button>
              <button type="button" class="k-icon-btn" :aria-label="safe('Delete: ' + item.title)" @click="teTasks.removeCheck(teTodo().id, item.id)"><i class="k-ico i-hugeicons-delete-02" aria-hidden="true"></i></button>
            </span>
          </li>
        </ul>
        <form class="k-check-item" @submit="teAddCheck($event)">
          <i class="k-ico i-hugeicons-plus-sign" style="color: var(--text-3); width: 14px; height: 14px" aria-hidden="true"></i>
          <label class="sr-only" for="te-check">Add a checklist item</label>
          <input id="te-check" class="k-bare" type="text" data-focus="todo-check" x-model="teCheckText" placeholder="Add a checklist item" style="font-size: 14px">
        </form>
      </div>

      <div class="k-meta" style="margin-top: 8px">
        <button type="button" class="k-chip" :class="teIsToday() ? 'k-chip-accent' : ''" @click="teToggle('when')"><i class="k-ico" style="width: 13px; height: 13px" :class="teTodo().when === 'evening' ? 'i-f7-moon-fill' : teIsToday() ? 'i-f7-star-fill' : 'i-hugeicons-calendar-03'" aria-hidden="true"></i><span :text="teWhen()"></span></button>
        <button type="button" class="k-chip" :if="teTodo().deadline" @click="teToggle('deadline')"><i class="k-ico i-hugeicons-flag-02" style="width: 13px; height: 13px" aria-hidden="true"></i><span :text="deadlineLabel(teTodo().deadline, teToday())"></span></button>
        <span class="k-chip k-chip-accent" :for="tag in teTodo().tags" :key="tag"><span :text="safe(tag)"></span>
          <button type="button" class="k-icon-btn" style="width: 20px; height: 20px" :aria-label="safe('Remove tag ' + tag)" @click="teDropTag(tag)"><i class="k-ico i-hugeicons-cancel-01" style="width: 11px; height: 11px" aria-hidden="true"></i></button>
        </span>
        <span class="k-chip" :if="teTodo().repeat !== 'none'" :text="'Repeats ' + teTodo().repeat"></span>
      </div>

      <div class="k-card-panel" :if="teTab() === 'when'">
        <div class="k-pills" role="radiogroup" aria-label="When">
          <button type="button" class="k-pill" role="radio" :aria-checked="teIsToday() && teTodo().when !== 'evening' ? 'true' : 'false'" @click="teSetWhen('today')"><i class="k-ico i-f7-star-fill k-gl-today" style="width: 15px; height: 15px" aria-hidden="true"></i>Today</button>
          <button type="button" class="k-pill" role="radio" :aria-checked="teTodo().when === 'evening' ? 'true' : 'false'" @click="teSetWhen('evening')"><i class="k-ico i-f7-moon-fill k-gl-evening" style="width: 15px; height: 15px" aria-hidden="true"></i>This Evening</button>
          <button type="button" class="k-pill" role="radio" :aria-checked="teIsAnytime() ? 'true' : 'false'" @click="teSetWhen('anytime')">Anytime</button>
          <button type="button" class="k-pill" role="radio" :aria-checked="teTodo().when === 'someday' ? 'true' : 'false'" @click="teSetWhen('someday')">Someday</button>
        </div>
        <div style="display: flex; align-items: center; gap: 8px; margin-top: 8px">
          <label class="k-sub" for="te-date">On a date</label>
          <input id="te-date" class="k-input" type="date" style="width: auto; min-height: 34px" :value="teScheduled()" @change="teSetDate($event)">
        </div>
      </div>
      <div class="k-card-panel" :if="teTab() === 'deadline'" style="display: flex; align-items: center; gap: 8px">
        <label class="k-sub" for="te-deadline">Deadline</label>
        <input id="te-deadline" class="k-input" type="date" style="width: auto; min-height: 34px" :value="teTodo().deadline || ''" @change="teSetDeadline($event)">
        <button type="button" class="k-btn k-btn-quiet" :if="teTodo().deadline" @click="teTasks.update(teTodo().id, { deadline: null })">Clear</button>
      </div>
      <form class="k-card-panel" :if="teTab() === 'tags'" @submit="teAddTags($event)">
        <label class="sr-only" for="te-tags">Add a tag</label>
        <input id="te-tags" class="k-input" type="text" data-focus="todo-tags" list="te-taglist" x-model="teTagText" placeholder="Add a tag and press Enter" style="min-height: 34px" @keydown="teTagKey($event)">
        <datalist id="te-taglist"><option :for="tag in teTasks.tags()" :key="tag" :value="tag"></option></datalist>
      </form>
      <div class="k-card-panel" :if="teTab() === 'more'" style="display: grid; gap: 10px">
        <div style="display: flex; align-items: center; gap: 8px"><label class="k-sub" for="te-repeat" style="width: 60px">Repeat</label>
          <select id="te-repeat" class="k-select" style="width: auto; min-height: 34px" :value="teTodo().repeat" @change="teSetRepeat($event)">
            <option value="none">Never</option><option value="daily">Daily</option><option value="weekly">Weekly</option><option value="monthly">Monthly</option><option value="yearly">Yearly</option>
          </select></div>
        <div style="display: flex; align-items: center; gap: 8px"><label class="k-sub" for="te-place" style="width: 60px">List</label>
          <select id="te-place" class="k-select" style="width: auto; max-width: 100%; min-height: 34px" :value="tePlace()" @change="teSetPlace($event)">
            <option value="">No project or area</option>
            <option :for="area in teWs.areas()" :key="'a' + area.id" :value="'a:' + area.id" :text="safe('Area: ' + area.title)"></option>
            <option :for="project in teWs.projects()" :key="'p' + project.id" :value="'p:' + project.id" :text="safe('Project: ' + project.title)"></option>
          </select></div>
        <div style="display: flex; gap: 8px">
          <button type="button" class="k-btn" :if="teDone()" @click="teTasks.reopen(teTodo().id)"><i class="k-ico i-hugeicons-delete-put-back" aria-hidden="true"></i>Reopen</button>
          <button type="button" class="k-btn k-btn-danger" @click="teAskDelete()"><i class="k-ico i-hugeicons-delete-02" aria-hidden="true"></i>Delete</button>
        </div>
      </div>

      <div class="k-card-tools">
        <button type="button" class="k-icon-btn" :aria-pressed="teTab() === 'when' ? 'true' : 'false'" aria-label="When" title="When" @click="teToggle('when')"><i class="k-ico i-hugeicons-calendar-03" aria-hidden="true"></i></button>
        <button type="button" class="k-icon-btn" :aria-pressed="teTab() === 'tags' ? 'true' : 'false'" aria-label="Tags" title="Tags" @click="teToggle('tags')"><i class="k-ico i-hugeicons-tag-01" aria-hidden="true"></i></button>
        <button type="button" class="k-icon-btn" :aria-pressed="teTab() === 'checklist' ? 'true' : 'false'" aria-label="Checklist" title="Checklist" @click="teToggle('checklist'); focusField('todo-check')"><i class="k-ico i-hugeicons-check-list" aria-hidden="true"></i></button>
        <button type="button" class="k-icon-btn" :aria-pressed="teTab() === 'deadline' ? 'true' : 'false'" aria-label="Deadline" title="Deadline" @click="teToggle('deadline')"><i class="k-ico i-hugeicons-flag-02" aria-hidden="true"></i></button>
        <button type="button" class="k-icon-btn" :aria-pressed="teTab() === 'more' ? 'true' : 'false'" aria-label="More" title="More" @click="teToggle('more')"><i class="k-ico i-hugeicons-more-horizontal" aria-hidden="true"></i></button>
        <span style="flex: 1"></span>
        <span class="k-sub" :if="teTodo().checklist.length" style="margin-right: 8px" :text="teCheckDone() + ' of ' + teTodo().checklist.length"></span>
        <button type="button" class="k-btn k-btn-quiet" style="min-height: 30px" @click="teClose()">Done</button>
      </div>
    </div>
  </div>
</div>
