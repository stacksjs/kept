<script client>
  import { libraryColor, libraryIcon } from '../functions/kept/promptview'
  import { safe } from '../functions/kept/safe'
  import { initials } from '../functions/kept/format'

  const sbWs = useStore('workspace')
  const sbTasks = useStore('tasks')
  const sbNotes = useStore('notes')
  const sbSession = useStore('account')
  const sbColor = useColorMode()
  const sbPref = state(sbColor.preference)
  const sbAdding = state('')
  const sbDraft = state('')

  const sbTop = [{ name: 'inbox', label: 'Inbox', icon: 'i-f7-tray-fill' }]
  const sbMiddle = [
    { name: 'today', label: 'Today', icon: 'i-f7-star-fill' },
    { name: 'upcoming', label: 'Upcoming', icon: 'i-f7-calendar' },
    { name: 'anytime', label: 'Anytime', icon: 'i-f7-layers-fill' },
    { name: 'someday', label: 'Someday', icon: 'i-f7-archivebox-fill' },
  ]
  const sbLog = [{ name: 'logbook', label: 'Logbook', icon: 'i-f7-checkmark-square-fill' }]

  const sbCount = (name) => (name === 'logbook' ? 0 : (sbTasks.totals()[name] || 0))
  const sbSection = sbWs.section
  const sbIsList = (name) => { const r = sbWs.route(); return r.section === 'todos' && r.view.kind === 'list' && r.view.name === name }
  const sbIsKind = (kind, id) => { const r = sbWs.route(); return r.section === 'todos' && r.view.kind === kind && r.view.id === id }
  const sbIsFolder = (id) => { const r = sbWs.route(); return r.section === 'notes' && (r.folder === id) }
  const sbIsLibrary = (id) => { const r = sbWs.route(); return r.section === 'prompts' && r.library === id }

  const sbGroups = derived(() => {
    const projects = sbWs.projects()
    return [
      { id: 0, title: '', projects: projects.filter(p => !p.area_id) },
      ...sbWs.areas().map(a => ({ id: a.id, title: a.title, projects: projects.filter(p => p.area_id === a.id) })),
    ]
  })
  const sbFolderCount = (id) => sbNotes.items().filter(note => note.note_folder_id === id).length
  const sbOwned = derived(() => sbWs.libraries().owned)
  const sbShared = derived(() => sbWs.libraries().shared)
  const sbName = derived(() => (sbSession.user() ? safe(sbSession.user().name || sbSession.user().email) : ''))
  const sbInitials = derived(() => initials(sbName()))
  const sbThemeIcon = derived(() => (sbPref() === 'dark' ? 'i-hugeicons-moon-02' : sbPref() === 'light' ? 'i-hugeicons-sun-03' : 'i-hugeicons-computer'))
  const sbThemeLabel = derived(() => (sbPref() === 'dark' ? 'Dark' : sbPref() === 'light' ? 'Light' : 'System'))

  function sbSetTheme(mode) {
    sbColor.set(mode)
    sbPref.set(mode)
  }

  const sbList = (name) => sbWs.open({ section: 'todos', view: { kind: 'list', name }, item: null })
  const sbOpenKind = (kind, id) => sbWs.open({ section: 'todos', view: { kind, id }, item: null })
  const sbOpenNotes = (folder) => sbWs.open({ section: 'notes', folder, item: null })
  const sbOpenLibrary = (id) => sbWs.open({ section: 'prompts', library: id, item: null })

  function sbStart(kind) { sbAdding.set(kind); sbDraft.set(''); focusSoon() }
  function focusSoon() { void nextTick(() => { const el = sbInput.current; if (el) el.focus() }) }
  const sbInput = useRef('sbInput')
  async function sbCommit(event) {
    event.preventDefault()
    const kind = sbAdding()
    const title = sbDraft()
    sbAdding.set('')
    if (kind === 'project') await sbWs.createProject(title)
    else if (kind === 'area') await sbWs.createArea(title)
    else if (kind === 'folder') await sbWs.createFolder(title)
    else if (kind === 'library') await sbWs.createLibrary(title)
  }
  function sbKey(event) { if (event.key === 'Escape') { event.stopPropagation(); sbAdding.set('') } }
</script>

<div class="k-pane k-side" style="flex: 1">
  <nav class="k-scroll" aria-label="Library">
    <div class="k-nav" style="padding-top: 18px">
      <div :for="group in [sbTop, sbMiddle, sbLog]" :key="group[0].name">
        <button type="button" class="k-nav-item" :for="item in group" :key="item.name" :aria-current="sbSection() === 'todos' && sbIsList(item.name) ? 'page' : null" @click="sbList(item.name)">
          <i class="k-gl" :class="[item.icon, 'k-gl-' + item.name]" aria-hidden="true"></i>
          <span :text="item.label"></span>
          <span class="k-count" :if="sbCount(item.name) > 0" :text="sbCount(item.name)"></span>
        </button>
        <div class="k-nav-gap"></div>
      </div>

      <div :for="group in sbGroups()" :key="group.id">
        <button type="button" class="k-nav-item" :if="group.id" :aria-current="sbIsKind('area', group.id) ? 'page' : null" @click="sbOpenKind('area', group.id)" style="font-weight: 600">
          <i class="i-hugeicons-folder-02 k-ico" style="color: var(--text-3)" aria-hidden="true"></i>
          <span :text="safe(group.title)"></span>
          <span class="k-count" :if="sbTasks.areaCount(group.id) > 0" :text="sbTasks.areaCount(group.id)"></span>
        </button>
        <button type="button" class="k-nav-item" :for="project in group.projects" :key="project.id" :style="group.id ? 'padding-left: 28px' : ''" :aria-current="sbIsKind('project', project.id) ? 'page' : null" @click="sbOpenKind('project', project.id)">
          <ProgressRing :value="sbTasks.ring(project.id)" />
          <span :text="safe(project.title)" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap"></span>
          <span class="k-count" :if="sbTasks.openCount(project.id) > 0" :text="sbTasks.openCount(project.id)"></span>
        </button>
      </div>
      <form :if="sbAdding() === 'project' || sbAdding() === 'area'" @submit="sbCommit($event)" style="padding: 4px 4px 0">
        <label class="sr-only" for="sb-new">New name</label>
        <input id="sb-new" ref="sbInput" class="k-input" type="text" x-model="sbDraft" :placeholder="sbAdding() === 'area' ? 'Area name' : 'Project name'" @keydown="sbKey($event)" @blur="sbAdding.set('')">
      </form>

      <div class="k-nav-group"><span>Notes</span><button type="button" class="k-icon-btn" style="width: 24px; height: 24px" aria-label="New notes folder" title="New folder" @click="sbStart('folder')"><i class="i-hugeicons-folder-add k-ico" style="width: 15px; height: 15px" aria-hidden="true"></i></button></div>
      <button type="button" class="k-nav-item" :aria-current="sbIsFolder('all') ? 'page' : null" @click="sbOpenNotes('all')">
        <i class="i-hugeicons-note-01 k-ico" style="color: #e0a82e" aria-hidden="true"></i><span>All notes</span>
        <span class="k-count" :if="sbNotes.items().length > 0" :text="sbNotes.items().length"></span>
      </button>
      <button type="button" class="k-nav-item" :for="folder in sbWs.folders()" :key="folder.id" :aria-current="sbIsFolder(folder.id) ? 'page' : null" @click="sbOpenNotes(folder.id)">
        <i class="i-hugeicons-folder-01 k-ico" style="color: #e0a82e" aria-hidden="true"></i><span :text="safe(folder.title)"></span>
        <span class="k-count" :if="sbFolderCount(folder.id) > 0" :text="sbFolderCount(folder.id)"></span>
      </button>
      <button type="button" class="k-nav-item" :for="tag in sbNotes.tagList()" :key="'t' + tag.name" :aria-current="sbIsFolder('tag:' + tag.name) ? 'page' : null" @click="sbOpenNotes('tag:' + tag.name)">
        <i class="i-hugeicons-tag-01 k-ico" style="color: var(--text-3)" aria-hidden="true"></i><span :text="safe('#' + tag.name)"></span>
        <span class="k-count" :text="tag.count"></span>
      </button>
      <button type="button" class="k-nav-item" :aria-current="sbIsFolder('trash') ? 'page' : null" @click="sbOpenNotes('trash')">
        <i class="i-hugeicons-delete-02 k-ico" style="color: var(--text-3)" aria-hidden="true"></i><span>Recently deleted</span>
        <span class="k-count" :if="sbNotes.trashed().length > 0" :text="sbNotes.trashed().length"></span>
      </button>
      <form :if="sbAdding() === 'folder'" @submit="sbCommit($event)" style="padding: 4px 4px 0">
        <label class="sr-only" for="sb-folder">Folder name</label>
        <input id="sb-folder" ref="sbInput" class="k-input" type="text" x-model="sbDraft" placeholder="Folder name" @keydown="sbKey($event)" @blur="sbAdding.set('')">
      </form>

      <div class="k-nav-group"><span>Prompt libraries</span></div>
      <button type="button" class="k-nav-item" :for="lib in sbOwned()" :key="lib.id" :aria-current="sbIsLibrary(lib.id) ? 'page' : null" @click="sbOpenLibrary(lib.id)">
        <i class="k-ico" :class="libraryIcon(lib.icon)" :style="'color:' + libraryColor(lib.color)" aria-hidden="true"></i><span :text="safe(lib.title)"></span>
        <span class="k-count" :if="lib.prompts > 0" :text="lib.prompts"></span>
      </button>
      <div class="k-nav-group" :if="sbShared().length"><span>Shared with me</span></div>
      <button type="button" class="k-nav-item" :for="lib in sbShared()" :key="'s' + lib.id" :aria-current="sbIsLibrary(lib.id) ? 'page' : null" @click="sbOpenLibrary(lib.id)">
        <i class="k-ico" :class="libraryIcon(lib.icon)" :style="'color:' + libraryColor(lib.color)" aria-hidden="true"></i><span :text="safe(lib.title)"></span>
      </button>
      <form :if="sbAdding() === 'library'" @submit="sbCommit($event)" style="padding: 4px 4px 0">
        <label class="sr-only" for="sb-lib">Library name</label>
        <input id="sb-lib" ref="sbInput" class="k-input" type="text" x-model="sbDraft" placeholder="Library name" @keydown="sbKey($event)" @blur="sbAdding.set('')">
      </form>
    </div>
  </nav>

  <div class="k-sbar">
    <MoreMenu :up="true" label="Add new" kind="add" text="New List">
      <button type="button" role="menuitem" @click="sbStart('project')"><i class="i-hugeicons-task-add-01 k-ico" aria-hidden="true"></i>New project</button>
      <button type="button" role="menuitem" @click="sbStart('area')"><i class="i-hugeicons-folder-add k-ico" aria-hidden="true"></i>New area</button>
      <button type="button" role="menuitem" @click="sbStart('folder')"><i class="i-hugeicons-note-add k-ico" aria-hidden="true"></i>New notes folder</button>
      <button type="button" role="menuitem" @click="sbStart('library')"><i class="i-hugeicons-book-02 k-ico" aria-hidden="true"></i>New prompt library</button>
    </MoreMenu>
    <MoreMenu :up="true" label="Account and appearance" kind="settings">
      <div class="k-menu-label" :text="sbName()"></div>
      <button type="button" role="menuitemradio" :aria-checked="sbPref() === 'auto' ? 'true' : 'false'" @click="sbSetTheme('auto')"><i class="i-hugeicons-computer k-ico" aria-hidden="true"></i>System appearance</button>
      <button type="button" role="menuitemradio" :aria-checked="sbPref() === 'light' ? 'true' : 'false'" @click="sbSetTheme('light')"><i class="i-hugeicons-sun-03 k-ico" aria-hidden="true"></i>Light</button>
      <button type="button" role="menuitemradio" :aria-checked="sbPref() === 'dark' ? 'true' : 'false'" @click="sbSetTheme('dark')"><i class="i-hugeicons-moon-02 k-ico" aria-hidden="true"></i>Dark</button>
      <button type="button" role="menuitem" @click="sbSession.signOut()"><i class="i-hugeicons-logout-01 k-ico" aria-hidden="true"></i>Sign out</button>
    </MoreMenu>
  </div>
</div>
