<script client>
import { today as deviceDay } from '../functions/kept/api'
import { toggleCheckLine } from '../functions/kept/markdown'
import { apiOrigin, desktop, keychainSession, nativeApi, nativeCraft, palette, readCache, requestCompletion, saveAccount, savedAccount, writeCache } from '../functions/kept/native-kept'
import { acceptCompletion, appendCheckLine, checkLines, COMPLETION_DELAY, completionRequest, eventText, eventValue, fillPrompt, findLibrary, formatNote, isOfflineError, navId, navTitle, NEW_PROMPT_BODY, noteDateGroups, noteSnippet, noteStamp, noteTagCounts, notesIn, parseDayField, parseNav, projectProgress, promptVariables, quickEntry, REPEATS, resolveDay, rowMarks, shareLink, SMART_LISTS, sidebarSections, todoBlocks, toggleChecklist, whenChip } from '../functions/kept/native-model'
import { daysLeft, normalizeNote } from '../functions/kept/notes'
import { filterPrompts, normalizePrompt } from '../functions/kept/promptview'
import { counts, normalizeTodo, parseTagInput, serializeChanges, whenPatch } from '../functions/kept/todos'

const session = keychainSession()
const api = nativeApi(session, () => signedOutHere())

// Who and where
const scheme = state(nativeCraft().appearance.colorScheme())
const colors = derived(() => palette(scheme()))
const account = state(savedAccount())
const signedIn = state(!!session.token())
const authBusy = state(false)
const authError = state('')
const signOuts = state(0)
const today = state(deviceDay())
const nav = state({ section: 'todos', view: { kind: 'list', name: 'today' } })
const search = state('')
const searching = state(false)
const offline = state(false)
const flash = state('')
const loading = state(false)

// Data
const sidebar = state(null)
const libraries = state(null)
const open = state([])
const logbook = state([])
const todosLoaded = state(false)
const notes = state([])
const notesLoaded = state(false)
const trash = state([])
const trashDays = state(30)
const prompts = state([])
const promptRole = state('owner')

// The open to-do (Things opens it in place)
const todoId = state(0)
const drafting = state(false)
const draft = state('')
const dTitle = state('')
const dNotes = state('')
const dStart = state('')
const dDeadline = state('')
const dTags = state('')
const dCheck = state('')
const dHint = state('')
const showDate = state(false)
const showDeadline = state(false)
const showTags = state(false)
const showChecklist = state(false)

// Notes
const noteId = state(0)
const noteBody = state('')

// Prompts
const promptId = state(0)
const pTitle = state('')
const pDesc = state('')
const pTags = state('')
const pBody = state('')
const pDirty = state(false)
const useOpen = state(false)
const useValues = state({})
const historyOpen = state(false)
const versions = state([])
const shareOpen = state(false)
const shares = state({ link: null, people: [] })
const shareEmail = state('')
const shareRole = state('viewer')

// Inline completion: which editor shows it, and the text
const ghost = state({ field: '', text: '' })

const view = derived(() => nav().section === 'todos' ? nav().view : null)
const progress = derived(() => projectProgress(open(), logbook()))
const tags = derived(() => noteTagCounts(notes()))
const sections = derived(() => sidebarSections(sidebar(), libraries(), { counts: todosLoaded() ? counts(open(), today()) : undefined, progress: progress(), tags: tags(), trash: trash().length }))
const selectedNav = derived(() => navId(nav()))
const title = derived(() => navTitle(nav(), sidebar(), libraries()))
const smart = derived(() => view()?.kind === 'list' ? SMART_LISTS.find(list => list.name === view().name) : null)
const headerSymbol = derived(() => smart()?.icon ?? (view()?.kind === 'area' ? 'shippingbox' : 'circle'))
const headerColor = derived(() => smart()?.color ?? (view()?.kind === 'area' ? '#8e8e93' : '#2f6fe4'))
const projectTitle = id => sidebar()?.projects.find(p => p.id === id)?.title
const blocks = derived(() => view() ? todoBlocks(view(), open(), logbook(), today(), sidebar()?.projects ?? [], search(), progress()) : [])
const listCount = derived(() => blocks().reduce((total, b) => total + b.items.length, 0))
const canAdd = derived(() => !!view() && !(view().kind === 'list' && view().name === 'logbook'))
const selectedTodo = derived(() => open().find(t => t.id === todoId()) ?? logbook().find(t => t.id === todoId()) ?? null)
const editing = derived(() => drafting() || !!selectedTodo())
const chip = derived(() => selectedTodo() ? whenChip(selectedTodo(), today()) : null)
const notesHeight = derived(() => Math.min(220, Math.max(40, (dNotes().split('\n').length + 1) * 19)))
const inTrash = derived(() => nav().section === 'notes' && nav().folder === 'trash')
const noteGroups = derived(() => nav().section !== 'notes' ? [] : noteDateGroups(inTrash() ? notesIn(trash(), 'all', search()) : notesIn(notes(), nav().folder, search())))
const noteCount = derived(() => noteGroups().reduce((total, g) => total + g.notes.length, 0))
const selectedNote = derived(() => (inTrash() ? trash() : notes()).find(n => n.id === noteId()) ?? null)
const noteChecks = derived(() => checkLines(noteBody()))
const folderName = id => sidebar()?.note_folders.find(f => f.id === id)?.title ?? ''
const library = derived(() => nav().section === 'prompts' ? findLibrary(libraries(), nav().library) : null)
const canEdit = derived(() => !!library()?.canEdit && promptRole() !== 'viewer')
const shownPrompts = derived(() => filterPrompts(prompts(), offline() ? search() : '', false))
const selectedPrompt = derived(() => prompts().find(p => p.id === promptId()) ?? null)
const variables = derived(() => promptVariables(pBody()))
const filled = derived(() => fillPrompt(pBody(), useValues()))
const linkUrl = derived(() => shares().link?.token ? shareLink(apiOrigin(), shares().link.token) : '')

/** A row inside a project block does not repeat the project's name. */
function marksFor(todo, inProject = false) {
  return rowMarks(todo, view() ?? { kind: 'list', name: 'inbox' }, today(), inProject ? undefined : projectTitle)
}

function say(text) {
  flash.set(text)
  setTimeout(() => { if (flash() === text) flash.set('') }, 5000)
}

/** Report a failure the way it happened: offline keeps the saved copy, anything else says what the server said. */
function failed(error, doing) {
  if (isOfflineError(error)) { offline.set(true); say(`You are offline. ${doing} needs a connection.`); return }
  if (error?.status === 401) return
  say(error?.message || `${doing} did not work.`)
}

// Loading, with the saved copy drawn first

function hydrate() {
  const who = account()
  sidebar.set(readCache(who, 'sidebar'))
  libraries.set(readCache(who, 'libraries'))
  const todos = readCache(who, 'todos')
  if (todos) { open.set(todos.open || []); logbook.set(todos.logbook || []); todosLoaded.set(true) }
  const saved = readCache(who, 'notes')
  if (saved) { notes.set(saved); notesLoaded.set(true) }
  trash.set(readCache(who, 'trash') || [])
}

async function loadSidebar() {
  const [data, libs] = await Promise.all([api.sidebar(today()), api.libraries()])
  sidebar.set(data)
  libraries.set(libs)
  writeCache(account(), 'sidebar', data)
  writeCache(account(), 'libraries', libs)
}

function saveTodos() { writeCache(account(), 'todos', { open: open(), logbook: logbook() }) }

async function loadTodos() {
  const names = ['inbox', 'today', 'upcoming', 'anytime', 'someday']
  const [lists, log] = await Promise.all([Promise.all(names.map(name => api.list(name, today()))), api.list('logbook', today())])
  const seen = new Map()
  for (const list of lists) for (const row of list.todos) seen.set(row.id, normalizeTodo(row))
  open.set([...seen.values()])
  logbook.set(log.todos.map(row => normalizeTodo(row)).filter(t => t.completed_at || t.canceled_at))
  todosLoaded.set(true)
  saveTodos()
}

async function loadNotes() {
  notes.set((await api.notes()).map(row => normalizeNote(row)))
  notesLoaded.set(true)
  writeCache(account(), 'notes', notes())
}

async function loadTrash() {
  const result = await api.notesTrash()
  trash.set(result.notes.map(row => normalizeNote(row)))
  trashDays.set(result.days || 30)
  writeCache(account(), 'trash', trash())
}

async function loadPrompts(id, text = '') {
  if (!text) {
    const saved = readCache(account(), `prompts.${id}`)
    if (saved && !prompts().length) { prompts.set(saved.prompts || []); promptRole.set(saved.role || 'owner') }
  }
  try {
    const result = await api.prompts(id, text)
    if (nav().section !== 'prompts' || nav().library !== id) return
    prompts.set(result.prompts.map(row => normalizePrompt(row)))
    promptRole.set(result.role || 'owner')
    if (!text) writeCache(account(), `prompts.${id}`, { role: result.role, prompts: prompts() })
    offline.set(false)
  }
  catch (error) { failed(error, 'Loading prompts') }
}

async function refreshAll() {
  if (!signedIn()) return
  loading.set(true)
  today.set(deviceDay())
  try {
    await Promise.all([loadSidebar(), loadTodos(), loadNotes(), loadTrash()])
    offline.set(false)
    if (nav().section === 'prompts') await loadPrompts(nav().library)
  }
  catch (error) {
    if (isOfflineError(error)) offline.set(true)
    else if (error?.status !== 401) say(error?.message || 'Could not refresh.')
  }
  finally { loading.set(false) }
}

// Account

async function signInWith(form) {
  authBusy.set(true)
  authError.set('')
  try {
    const user = form.mode === 'register' ? await api.signUp(form.name, form.email, form.password) : await api.signIn(form.email, form.password)
    startSession(user)
  }
  catch (error) {
    authError.set(isOfflineError(error) ? 'Library cannot reach the server. Check your connection and try again.' : (error?.message || 'Those details did not work.'))
  }
  finally { authBusy.set(false) }
}

function startSession(user) {
  if (user) { account.set(user); saveAccount(user) }
  signedIn.set(true)
  hydrate()
  refreshAll()
  api.me().then((me) => { account.set(me); saveAccount(me) }).catch(() => {})
}

function clearData() {
  sidebar.set(null); libraries.set(null); open.set([]); logbook.set([]); notes.set([]); trash.set([]); prompts.set([])
  todosLoaded.set(false); notesLoaded.set(false); todoId.set(0); drafting.set(false); noteId.set(0); promptId.set(0)
  useOpen.set(false); historyOpen.set(false); shareOpen.set(false)
  nav.set({ section: 'todos', view: { kind: 'list', name: 'today' } })
}

function signedOutHere() {
  signedIn.set(false)
  signOuts.set(signOuts() + 1)
  clearData()
}

async function signOut() {
  try { await api.signOut() }
  catch { session.save(null) }
  saveAccount(null)
  account.set(null)
  signedOutHere()
}

function openSettings() {
  desktop().openWindow({ name: 'settings', route: 'Settings', title: 'Settings', width: 520, height: 420, minWidth: 460, minHeight: 360 })
}

// Navigation

async function pickNav(id) {
  const next = parseNav(String(id))
  if (!next) return
  await leavePrompt()
  closeTodo()
  flushNote()
  nav.set(next)
  search.set('')
  searching.set(false)
  if (next.section === 'notes') {
    const pool = next.folder === 'trash' ? trash() : notes()
    selectNote(noteDateGroups(notesIn(pool, next.folder === 'trash' ? 'all' : next.folder, ''))[0]?.notes[0] ?? null)
    if (!notesLoaded()) loadNotes().catch(error => failed(error, 'Loading notes'))
    if (next.folder === 'trash') loadTrash().catch(error => failed(error, 'Loading Recently Deleted'))
  }
  if (next.section === 'prompts') {
    prompts.set([])
    selectPrompt(null)
    await loadPrompts(next.library)
    selectPrompt(prompts()[0] ?? null)
  }
}

// To-dos

function replaceTodo(todo) {
  const swap = row => (row.id === todo.id ? todo : row)
  open.set(open().map(swap))
  logbook.set(logbook().map(swap))
  saveTodos()
}

async function toggleTodo(todo) {
  if (!todo) return
  try {
    if (todo.completed_at || todo.canceled_at) {
      const result = await api.reopenTodo(todo.id)
      const back = { ...normalizeTodo(result.todo), checklist: todo.checklist }
      logbook.set(logbook().filter(t => t.id !== todo.id))
      open.set([...open().filter(t => t.id !== todo.id), back])
    }
    else {
      const result = await api.completeTodo(todo.id, today())
      const finished = { ...normalizeTodo(result.todo), checklist: todo.checklist }
      open.set([...open().filter(t => t.id !== todo.id), ...(result.next ? [normalizeTodo(result.next)] : [])])
      logbook.set([finished, ...logbook().filter(t => t.id !== todo.id)])
      if (result.next) say(`Done. It comes back on ${result.next.start_date || 'its next date'}.`)
    }
    saveTodos()
    loadSidebar().catch(() => {})
  }
  catch (error) { failed(error, 'Completing a to-do') }
}

/** Open a to-do in place. Clicking the open one again closes it. */
function openTodo(todo) {
  if (todo && todo.id === todoId()) { closeTodo(); return }
  closeTodo()
  if (!todo) return
  todoId.set(todo.id)
  dTitle.set(todo.title)
  dNotes.set(todo.notes || '')
  dStart.set(todo.start_date || '')
  dDeadline.set(todo.deadline || '')
  dTags.set((todo.tags || []).join(', '))
  dCheck.set('')
  dHint.set('')
  showDate.set(!!todo.start_date && todo.start_date > today())
  showDeadline.set(!!todo.deadline)
  showTags.set(!!todo.tags?.length)
  showChecklist.set(!!todo.checklist?.length)
}

function closeTodo() {
  flushTodo()
  todoId.set(0)
  if (drafting()) commitDraft()
  if (ghost().field === 'todo') ghost.set({ field: '', text: '' })
}

async function saveTodo(changes, todo = selectedTodo()) {
  if (!todo || !Object.keys(changes).length) return
  try {
    const saved = normalizeTodo(await api.updateTodo(todo.id, serializeChanges(changes)))
    const current = open().find(t => t.id === todo.id) ?? logbook().find(t => t.id === todo.id) ?? todo
    replaceTodo({ ...current, ...saved, checklist: current.checklist })
  }
  catch (error) { failed(error, 'Saving the to-do') }
}

let todoTimer = 0
/** What the typed fields change, compared with the saved to-do; nothing for a date that is half typed. */
function typedChanges() {
  const todo = selectedTodo()
  if (!todo) return {}
  const changes = {}
  if (dTitle().trim() && dTitle().trim() !== todo.title) changes.title = dTitle().trim()
  if (dNotes() !== (todo.notes || '')) changes.notes = dNotes()
  const tagList = parseTagInput(dTags())
  if (tagList.join('\n') !== (todo.tags || []).join('\n')) changes.tags = tagList
  const start = parseDayField(dStart())
  const deadline = parseDayField(dDeadline())
  dHint.set(start.ok && deadline.ok ? '' : 'Dates look like 2026-11-04, or type today or tomorrow.')
  if (start.ok && resolveDay(start.value, today()) !== (todo.start_date || null)) {
    if (start.value) { changes.start_date = resolveDay(start.value, today()); if (todo.when === 'inbox') changes.when = 'anytime' }
    else changes.start_date = null
  }
  if (deadline.ok && resolveDay(deadline.value, today()) !== (todo.deadline || null)) changes.deadline = resolveDay(deadline.value, today())
  return changes
}

function flushTodo() {
  clearTimeout(todoTimer)
  if (selectedTodo()) saveTodo(typedChanges())
}

/** Template handlers see a signal's value, not the signal, so fields are named. */
const todoFields = { title: dTitle, notes: dNotes, start: dStart, deadline: dDeadline, tags: dTags }
const promptFields = { title: pTitle, description: pDesc, tags: pTags, body: pBody }

function editTodo(name, event) {
  todoFields[name].set(eventText(event))
  clearTimeout(todoTimer)
  todoTimer = setTimeout(() => saveTodo(typedChanges()), 700)
  if (name === 'notes') suggest('todo', 'todo-notes', dNotes(), dTitle())
}

async function whenMenu(todo = selectedTodo()) {
  if (!todo) return
  const choice = await desktop().contextMenu([
    { id: 'today', title: 'Today', icon: 'star.fill' },
    { id: 'evening', title: 'This Evening', icon: 'moon.fill' },
    { id: 'tomorrow', title: 'Tomorrow', icon: 'sunrise' },
    { id: 'date', title: 'Choose a Date', icon: 'calendar' },
    { separator: true },
    { id: 'anytime', title: 'Anytime', icon: 'square.stack.3d.up' },
    { id: 'someday', title: 'Someday', icon: 'archivebox' },
    { id: 'inbox', title: 'Clear (Inbox)', icon: 'tray' },
  ])
  if (!choice) return
  if (choice === 'date') { showDate.set(true); setTimeout(() => desktop().focus('detail-start'), 30); return }
  dStart.set(choice === 'tomorrow' ? resolveDay('tomorrow', today()) : '')
  showDate.set(choice === 'tomorrow')
  const patch = choice === 'tomorrow' ? whenPatch({ date: resolveDay('tomorrow', today()) }) : choice === 'inbox' ? { when: 'inbox', start_date: null } : whenPatch(choice)
  await saveTodo(patch, todo)
}

async function repeatMenu(todo = selectedTodo()) {
  if (!todo) return
  const choice = await desktop().contextMenu(REPEATS.map(r => ({ id: r.value, title: r.label, checked: (todo.repeat || 'none') === r.value })))
  if (choice) await saveTodo({ repeat: choice }, todo)
}

async function moveMenu(todo = selectedTodo()) {
  if (!todo) return
  const data = sidebar()
  const items = [{ id: 'inbox', title: 'Inbox', icon: 'tray' }, { separator: true }]
  for (const p of data?.projects ?? []) items.push({ id: `project:${p.id}`, title: p.title, icon: 'circle', checked: todo.project_id === p.id })
  for (const a of data?.areas ?? []) items.push({ id: `area:${a.id}`, title: a.title, icon: 'shippingbox', checked: todo.area_id === a.id && !todo.project_id })
  const choice = await desktop().contextMenu(items)
  if (!choice) return
  if (choice === 'inbox') await saveTodo({ project_id: null, area_id: null, when: todo.when === 'anytime' ? 'inbox' : todo.when }, todo)
  else if (choice.startsWith('project:')) await saveTodo({ project_id: Number(choice.slice(8)), area_id: null }, todo)
  else await saveTodo({ area_id: Number(choice.slice(5)), project_id: null }, todo)
}

async function moreMenu(todo = selectedTodo()) {
  if (!todo) return
  const done = !!(todo.completed_at || todo.canceled_at)
  const choice = await desktop().contextMenu([
    { id: 'toggle', title: done ? 'Mark as Open' : 'Complete', icon: 'checkmark.square' },
    { id: 'repeat', title: 'Repeat', icon: 'repeat' },
    { id: 'when', title: 'When', icon: 'calendar' },
    { id: 'deadline', title: 'Add Deadline', icon: 'flag' },
    { separator: true },
    { id: 'delete', title: 'Delete To-Do', icon: 'trash' },
  ])
  if (choice === 'toggle') await toggleTodo(todo)
  if (choice === 'repeat') await repeatMenu(todo)
  if (choice === 'when') await whenMenu(todo)
  if (choice === 'deadline') { showDeadline.set(true); setTimeout(() => desktop().focus('detail-deadline'), 30) }
  if (choice === 'delete') await deleteTodo(todo)
}

function openChecklist() {
  showChecklist.set(true)
  setTimeout(() => desktop().focus('detail-check-input'), 30)
}

async function addCheckItem() {
  const todo = selectedTodo()
  const text = dCheck().trim()
  if (!todo || !text) return
  dCheck.set('')
  try {
    const item = await api.createChecklistItem(todo.id, text)
    replaceTodo({ ...todo, checklist: [...todo.checklist, { ...item, done: !!item.done }] })
  }
  catch (error) { dCheck.set(text); failed(error, 'Adding a checklist item') }
}

async function toggleCheckItem(item) {
  const todo = selectedTodo()
  if (!todo) return
  try {
    await api.updateChecklistItem(item.id, { done: !item.done })
    replaceTodo({ ...todo, checklist: todo.checklist.map(i => (i.id === item.id ? { ...i, done: !item.done } : i)) })
  }
  catch (error) { failed(error, 'Updating the checklist') }
}

async function deleteCheckItem(item) {
  const todo = selectedTodo()
  if (!todo) return
  try {
    await api.deleteChecklistItem(item.id)
    replaceTodo({ ...todo, checklist: todo.checklist.filter(i => i.id !== item.id) })
  }
  catch (error) { failed(error, 'Removing the checklist item') }
}

function confirmDelete(what, message) {
  return nativeCraft().dialog.confirm({ title: `Delete ${what}?`, message, confirmText: 'Delete', confirmLabel: 'Delete', cancelText: 'Cancel', cancelLabel: 'Cancel', destructive: true })
}

async function deleteTodo(todo = selectedTodo()) {
  if (!todo || !await confirmDelete(`"${todo.title}"`, 'The to-do and its checklist are removed.')) return
  try {
    await api.deleteTodo(todo.id)
    open.set(open().filter(t => t.id !== todo.id))
    logbook.set(logbook().filter(t => t.id !== todo.id))
    if (todoId() === todo.id) todoId.set(0)
    saveTodos()
    loadSidebar().catch(() => {})
  }
  catch (error) { failed(error, 'Deleting the to-do') }
}

async function todoMenu(todo) {
  const done = !!(todo.completed_at || todo.canceled_at)
  const choice = await desktop().contextMenu([
    { id: 'open', title: 'Open', icon: 'square.and.pencil' },
    { id: 'toggle', title: done ? 'Mark as Open' : 'Complete', icon: 'checkmark.square' },
    { separator: true },
    { id: 'today', title: 'Today', icon: 'star' },
    { id: 'evening', title: 'This Evening', icon: 'moon' },
    { id: 'anytime', title: 'Anytime', icon: 'square.stack.3d.up' },
    { id: 'someday', title: 'Someday', icon: 'archivebox' },
    { separator: true },
    { id: 'move', title: 'Move', icon: 'arrow.right' },
    { id: 'delete', title: 'Delete To-Do', icon: 'trash' },
  ])
  if (choice === 'open') openTodo(todo)
  if (choice === 'toggle') await toggleTodo(todo)
  if (choice === 'move') await moveMenu(todo)
  if (choice === 'delete') await deleteTodo(todo)
  if (['today', 'evening', 'anytime', 'someday'].includes(choice)) await saveTodo(whenPatch(choice), todo)
}

/** New To-Do opens an empty one in place at the top of the list, the way Things does. */
function newTodo() {
  if (!canAdd()) pickNav('list:inbox')
  closeTodo()
  draft.set('')
  drafting.set(true)
  setTimeout(() => desktop().focus('draft-title'), 60)
}

async function commitDraft() {
  const fields = quickEntry(view() ?? { kind: 'list', name: 'inbox' }, draft(), today())
  drafting.set(false)
  draft.set('')
  if (!fields) return
  const bottom = Math.max(0, ...open().map(t => t.sort_order || 0))
  try {
    const todo = normalizeTodo(await api.createTodo({ ...fields, sort_order: bottom + 1 }))
    open.set([...open(), todo])
    saveTodos()
    loadSidebar().catch(() => {})
  }
  catch (error) { failed(error, 'Adding a to-do') }
}

async function renameList(event) {
  const name = eventText(event).trim()
  const current = view()
  if (!name || !current || current.kind === 'list' || name === title()) return
  try {
    if (current.kind === 'project') await api.updateProject(current.id, { title: name })
    else await api.updateArea(current.id, { title: name })
    await loadSidebar()
  }
  catch (error) { failed(error, 'Renaming') }
}

async function newList() {
  const choice = await desktop().contextMenu([
    { id: 'project', title: 'New Project', icon: 'circle' },
    { id: 'area', title: 'New Area', icon: 'shippingbox' },
  ])
  if (!choice) return
  try {
    const created = choice === 'project' ? await api.createProject({ title: 'New Project', when: 'anytime' }) : await api.createArea('New Area')
    await loadSidebar()
    await pickNav(`${choice}:${created.id}`)
    setTimeout(() => desktop().focus('list-title'), 60)
  }
  catch (error) { failed(error, 'Creating the list') }
}

// Notes

let noteTimer = 0
/** Typed text not saved yet, kept with the note it was typed into, so a save never lands on a note selected since. */
let pendingNote = null

async function writeNote(id, body, extra = {}) {
  try {
    const saved = normalizeNote(await api.saveNote({ id, body, ...extra }))
    notes.set(notes().map(n => (n.id === saved.id ? saved : n)))
    writeCache(account(), 'notes', notes())
  }
  catch (error) { failed(error, 'Saving the note') }
}

function flushNote() {
  clearTimeout(noteTimer)
  const pending = pendingNote
  pendingNote = null
  if (pending) return writeNote(pending.id, pending.body)
}

async function saveNote(extra = {}) {
  const note = selectedNote()
  if (!note || inTrash()) return
  const pending = pendingNote?.id === note.id
  clearTimeout(noteTimer)
  pendingNote = null
  if (!pending && noteBody() === note.body && !Object.keys(extra).length) return
  await writeNote(note.id, noteBody(), extra)
}

function selectNote(note) {
  flushNote()
  noteId.set(note?.id ?? 0)
  noteBody.set(note?.body ?? '')
  if (ghost().field === 'note') ghost.set({ field: '', text: '' })
}

function editNote(event) {
  if (inTrash() || !noteId()) return
  noteBody.set(eventText(event))
  pendingNote = { id: noteId(), body: noteBody() }
  clearTimeout(noteTimer)
  noteTimer = setTimeout(() => flushNote(), 800)
  suggest('note', 'note', noteBody(), selectedNote()?.title ?? '')
}

function setNoteBody(body) {
  noteBody.set(body)
  saveNote()
}

async function formatMenu() {
  if (!selectedNote() || inTrash()) return
  const choice = await desktop().contextMenu([
    { id: 'title', title: 'Title', icon: 'textformat.size.larger' },
    { id: 'heading', title: 'Heading', icon: 'textformat.size' },
    { separator: true },
    { id: 'bold', title: 'Bold', icon: 'bold' },
    { id: 'italic', title: 'Italic', icon: 'italic' },
    { separator: true },
    { id: 'list', title: 'Bulleted List', icon: 'list.bullet' },
    { id: 'check', title: 'Checklist', icon: 'checklist' },
  ])
  if (choice) setNoteBody(formatNote(noteBody(), choice))
}

async function newNote() {
  if (nav().section !== 'notes' || inTrash()) await pickNav('notes:all')
  flushNote()
  const folder = typeof nav().folder === 'number' ? nav().folder : null
  try {
    const note = normalizeNote(await api.saveNote({ body: 'New Note', note_folder_id: folder }))
    notes.set([note, ...notes()])
    search.set('')
    selectNote(note)
    writeCache(account(), 'notes', notes())
    loadSidebar().catch(() => {})
    setTimeout(() => desktop().focus('note-editor'), 60)
  }
  catch (error) { failed(error, 'Creating a note') }
}

/** Delete moves a note to Recently Deleted, as in Notes; no question asked. */
async function deleteNote(note = selectedNote()) {
  if (!note) return
  if (inTrash()) { await purgeNote(note); return }
  try {
    await api.deleteNote(note.id)
    notes.set(notes().filter(n => n.id !== note.id))
    trash.set([{ ...note, deleted_at: new Date().toISOString() }, ...trash()])
    if (noteId() === note.id) selectNote(noteDateGroups(notesIn(notes(), nav().folder, search()))[0]?.notes[0] ?? null)
    writeCache(account(), 'notes', notes())
    loadSidebar().catch(() => {})
    say('Moved to Recently Deleted.')
  }
  catch (error) { failed(error, 'Deleting the note') }
}

async function restoreNote(note = selectedNote()) {
  if (!note) return
  try {
    const back = normalizeNote(await api.restoreNote(note.id))
    trash.set(trash().filter(n => n.id !== note.id))
    notes.set([back, ...notes().filter(n => n.id !== back.id)])
    selectNote(trash()[0] ?? null)
    loadSidebar().catch(() => {})
    say(`"${back.title || 'Note'}" is back in your notes.`)
  }
  catch (error) { failed(error, 'Restoring the note') }
}

async function purgeNote(note = selectedNote()) {
  if (!note || !await confirmDelete(`"${note.title || 'this note'}" now`, 'It cannot be brought back.')) return
  try {
    await api.purgeNote(note.id)
    trash.set(trash().filter(n => n.id !== note.id))
    selectNote(trash()[0] ?? null)
  }
  catch (error) { failed(error, 'Deleting the note') }
}

async function togglePin(note = selectedNote()) {
  if (!note || inTrash()) return
  if (note.id !== noteId()) selectNote(note)
  await saveNote({ pinned: !note.pinned })
}

async function noteMenu(note) {
  selectNote(note)
  const choice = await desktop().contextMenu(inTrash()
    ? [{ id: 'restore', title: 'Recover', icon: 'arrow.uturn.backward' }, { id: 'purge', title: 'Delete Now', icon: 'trash' }]
    : [{ id: 'pin', title: note.pinned ? 'Unpin Note' : 'Pin Note', icon: 'pin' }, { separator: true }, { id: 'delete', title: 'Delete', icon: 'trash' }])
  if (choice === 'pin') await togglePin(note)
  if (choice === 'delete') await deleteNote(note)
  if (choice === 'restore') await restoreNote(note)
  if (choice === 'purge') await purgeNote(note)
}

// Prompts

function selectPrompt(prompt) {
  promptId.set(prompt?.id ?? 0)
  pTitle.set(prompt?.title ?? '')
  pDesc.set(prompt?.description ?? '')
  pTags.set((prompt?.tags ?? []).join(', '))
  pBody.set(prompt?.body ?? '')
  pDirty.set(false)
  if (ghost().field === 'prompt') ghost.set({ field: '', text: '' })
}

function editPrompt(name, event) {
  promptFields[name].set(eventText(event))
  pDirty.set(true)
  if (name === 'body' && canEdit()) suggest('prompt', 'prompt', pBody(), pTitle())
}

async function savePrompt() {
  const prompt = selectedPrompt()
  if (!prompt || !canEdit() || !pDirty()) return
  try {
    const saved = normalizePrompt(await api.savePrompt({ id: prompt.id, title: pTitle().trim() || 'Untitled prompt', description: pDesc(), body: pBody(), tags: parseTagInput(pTags()) }))
    prompts.set(prompts().map(p => (p.id === saved.id ? saved : p)))
    pDirty.set(false)
    say(saved.version > prompt.version ? `Saved as version ${saved.version}.` : 'Saved.')
  }
  catch (error) { failed(error, 'Saving the prompt') }
}

/** Unsaved prompt edits are kept when you move on, the way the note editor keeps its text. */
async function leavePrompt() {
  if (pDirty() && canEdit()) await savePrompt()
}

async function choosePrompt(prompt) {
  await leavePrompt()
  selectPrompt(prompt)
}

async function newPrompt() {
  if (nav().section !== 'prompts') {
    const first = libraries()?.owned[0]
    if (!first) { say('Create a prompt library on the web first.'); return }
    await pickNav(`library:${first.id}`)
  }
  if (!canEdit()) { say('You can read this library but not add to it.'); return }
  await leavePrompt()
  try {
    const prompt = normalizePrompt(await api.savePrompt({ library_id: nav().library, title: 'Untitled prompt', body: NEW_PROMPT_BODY, tags: [] }))
    prompts.set([prompt, ...prompts()])
    selectPrompt(prompt)
    loadSidebar().catch(() => {})
    setTimeout(() => desktop().focus('prompt-title'), 60)
  }
  catch (error) { failed(error, 'Creating a prompt') }
}

async function deletePrompt(prompt = selectedPrompt()) {
  if (!prompt || !canEdit() || !await confirmDelete(`"${prompt.title}"`, 'Everyone this library is shared with loses it too.')) return
  try {
    await api.deletePrompt(prompt.id)
    prompts.set(prompts().filter(p => p.id !== prompt.id))
    selectPrompt(prompts()[0] ?? null)
    loadSidebar().catch(() => {})
  }
  catch (error) { failed(error, 'Deleting the prompt') }
}

function openUse() {
  if (!selectedPrompt()) return
  useValues.set({})
  useOpen.set(true)
}

function setVariable(name, event) {
  useValues.set({ ...useValues(), [name]: eventText(event) })
}

async function copyFilled() {
  const prompt = selectedPrompt()
  if (!prompt) return
  try {
    await nativeCraft().clipboard.write(filled())
    useOpen.set(false)
    say('Copied to the clipboard.')
    const result = await api.usePrompt(prompt.id)
    prompts.set(prompts().map(p => (p.id === prompt.id ? { ...p, uses: result.uses } : p)))
  }
  catch (error) { failed(error, 'Copying the prompt') }
}

async function openHistory() {
  if (!selectedPrompt()) return
  // Loaded before the sheet opens: the host sizes a sheet once, when it appears.
  try {
    versions.set((await api.promptVersions(selectedPrompt().id)).versions)
    historyOpen.set(true)
  }
  catch (error) { failed(error, 'Loading the history') }
}

async function restoreVersion(version) {
  const prompt = selectedPrompt()
  if (!prompt || !canEdit()) return
  try {
    const saved = normalizePrompt(await api.savePrompt({ id: prompt.id, title: version.title, body: version.body, description: prompt.description, tags: prompt.tags }))
    prompts.set(prompts().map(p => (p.id === saved.id ? saved : p)))
    selectPrompt(saved)
    historyOpen.set(false)
    say(`Restored version ${version.version} as version ${saved.version}.`)
  }
  catch (error) { failed(error, 'Restoring the version') }
}

async function openShare() {
  if (nav().section !== 'prompts' || !library()?.owned) { say('Only the owner can share a library.'); return }
  shareEmail.set('')
  shareRole.set('viewer')
  try {
    shares.set(await api.shares(nav().library))
    shareOpen.set(true)
  }
  catch (error) { failed(error, 'Loading sharing') }
}

async function invite() {
  const email = shareEmail().trim()
  if (!email) return
  try {
    const result = await api.share(nav().library, email, shareRole())
    shareEmail.set('')
    shares.set(await api.shares(nav().library))
    say(result.joined ? `${email} can open the library now.` : `${email} gets it when they sign up.`)
  }
  catch (error) { failed(error, 'Inviting') }
}

async function removeShare(person) {
  try {
    await api.unshare(person.id)
    shares.set({ ...shares(), people: shares().people.filter(p => p.id !== person.id) })
  }
  catch (error) { failed(error, 'Removing access') }
}

async function setLink(event) {
  const on = eventValue(event) === true
  try { shares.set({ ...shares(), link: (await api.setLink(nav().library, on)).link }) }
  catch (error) { failed(error, 'Changing the link') }
}

async function copyLink() {
  if (!linkUrl()) return
  await nativeCraft().clipboard.write(linkUrl())
  say('Link copied.')
}

async function promptMenu(prompt) {
  await choosePrompt(prompt)
  const choice = await desktop().contextMenu([
    { id: 'use', title: 'Use Prompt', icon: 'doc.on.clipboard' },
    { id: 'history', title: 'Version History', icon: 'clock.arrow.circlepath' },
    { separator: true },
    { id: 'delete', title: 'Delete Prompt', icon: 'trash', disabled: !canEdit() },
  ])
  if (choice === 'use') openUse()
  if (choice === 'history') await openHistory()
  if (choice === 'delete') await deletePrompt(prompt)
}

// Inline completion: ask once typing stops, drop stale answers, show nothing on failure.
let ghostTimer = 0
let ghostSeq = 0
function suggest(field, kind, text, context) {
  if (ghost().text) ghost.set({ field: '', text: '' })
  clearTimeout(ghostTimer)
  const seq = ++ghostSeq
  const request = completionRequest(kind, text, context)
  if (!request) return
  ghostTimer = setTimeout(async () => {
    const completion = await requestCompletion(session, request)
    // Shown exactly as it would be inserted, with the joining space, so the ghost reads as the next words.
    if (seq === ghostSeq && completion) ghost.set({ field, text: acceptCompletion(text, completion).slice(text.length) })
  }, COMPLETION_DELAY)
}

function acceptGhost(field, event) {
  const completion = eventText(event) || ghost().text
  ghost.set({ field: '', text: '' })
  if (!completion) return
  if (field === 'note') setNoteBody(acceptCompletion(noteBody(), completion))
  if (field === 'prompt') { pBody.set(acceptCompletion(pBody(), completion)); pDirty.set(true) }
  if (field === 'todo') { dNotes.set(acceptCompletion(dNotes(), completion)); saveTodo(typedChanges()) }
}

const ghostFor = field => (ghost().field === field ? ghost().text : '')

// Search: prompts ask the server; to-dos and notes filter what is loaded.
let searchTimer = 0
function editSearch(event) {
  search.set(eventText(event))
  if (nav().section !== 'prompts') return
  clearTimeout(searchTimer)
  const text = search().trim()
  const id = nav().library
  searchTimer = setTimeout(() => loadPrompts(id, text), 250)
}

function toggleSearch() {
  searching.set(!searching())
  if (!searching()) search.set('')
  else setTimeout(() => desktop().focus('search'), 50)
}

// Commands

function command(id) {
  if (id === 'appearance') { scheme.set(nativeCraft().appearance.colorScheme()); return }
  if (id === 'settings') { openSettings(); return }
  if (!signedIn()) return
  const section = nav().section
  if (id.startsWith('go:')) pickNav(id.slice(3))
  else if (id === 'new') { if (section === 'notes') newNote(); else if (section === 'prompts') newPrompt(); else newTodo() }
  else if (id === 'new-todo') newTodo()
  else if (id === 'new-note') newNote()
  else if (id === 'new-prompt') newPrompt()
  else if (id === 'new-list') newList()
  else if (id === 'find') { if (section === 'todos') { searching.set(true) } setTimeout(() => desktop().focus('search'), 50) }
  else if (id === 'refresh') refreshAll()
  else if (id === 'sign-out') signOut()
  else if (id === 'save') { if (section === 'prompts') savePrompt(); else if (section === 'notes') saveNote(); else flushTodo() }
  else if (id === 'complete' && section === 'todos') toggleTodo(selectedTodo())
  else if (id === 'close-todo') closeTodo()
  else if (id === 'toggle-check' && section === 'notes' && selectedNote()) setNoteBody(toggleChecklist(noteBody()))
  else if (id === 'format' && section === 'notes') formatMenu()
  else if (id === 'pin' && section === 'notes') togglePin()
  else if (id === 'use-prompt' && section === 'prompts') openUse()
  else if (id === 'history' && section === 'prompts') openHistory()
  else if (id === 'share') openShare()
  else if (id === 'delete') { if (section === 'todos') deleteTodo(); else if (section === 'notes') deleteNote(); else deletePrompt() }
}

onMount(async () => {
  onDestroy(desktop().onCommand(command))
  onDestroy(nativeCraft().session.onChange((token) => {
    session.adopt(token)
    if (!token && signedIn()) signedOutHere()
    if (token && !signedIn() && !authBusy()) startSession(null)
  }))
  const refresher = setInterval(() => { if (signedIn()) refreshAll() }, 5 * 60 * 1000)
  onDestroy(() => clearInterval(refresher))
  await desktop().setMenus([
    { label: 'File', items: [
      { id: 'new', label: 'New', shortcut: 'cmd+n' },
      { id: 'new-todo', label: 'New To-Do', shortcut: 'ctrl+cmd+n' },
      { id: 'new-note', label: 'New Note', shortcut: 'shift+cmd+n' },
      { id: 'new-prompt', label: 'New Prompt', shortcut: 'alt+cmd+n' },
      { id: 'new-list', label: 'New List' },
      { separator: true },
      { id: 'save', label: 'Save', shortcut: 'cmd+s' },
      { separator: true },
      { id: 'sign-out', label: 'Sign Out' },
    ] },
    { label: 'View', items: [
      ...SMART_LISTS.map(list => ({ id: `go:list:${list.name}`, label: list.label, shortcut: list.shortcut })),
      { id: 'go:notes:all', label: 'All Notes', shortcut: 'cmd+7' },
      { id: 'go:notes:trash', label: 'Recently Deleted' },
      { separator: true },
      { id: 'find', label: 'Find', shortcut: 'cmd+f' },
      { id: 'refresh', label: 'Refresh', shortcut: 'cmd+r' },
    ] },
    { label: 'Item', items: [
      { id: 'complete', label: 'Complete To-Do', shortcut: 'cmd+k' },
      { id: 'close-todo', label: 'Close To-Do' },
      { separator: true },
      { id: 'format', label: 'Format', shortcut: 'shift+cmd+t' },
      { id: 'toggle-check', label: 'Toggle Checklist', shortcut: 'shift+cmd+l' },
      { id: 'pin', label: 'Pin Note' },
      { separator: true },
      { id: 'use-prompt', label: 'Use Prompt', shortcut: 'cmd+u' },
      { id: 'history', label: 'Version History' },
      { id: 'share', label: 'Share Library' },
      { separator: true },
      { id: 'delete', label: 'Delete' },
    ] },
  ])
  if (signedIn()) startSession(null)
})
</script>

<View class="flex-1 flex-row" testID="main-shell">
  <KeptMacSignIn :if="!signedIn()" class="flex-1" :error="authError()" :busy="authBusy()" :origin="apiOrigin()" :epoch="signOuts()" @submit="signInWith($event)" />

  <View :if="signedIn()" class="flex-col shrink-0 w-[240px] border-r" style="border-color: separator" material="sidebar" testID="sidebar-pane">
    <NativeSidebar class="flex-1" :sections="sections()" :selected="selectedNav()" @change="pickNav(eventValue($event))" testID="sidebar" />
    <View class="flex-row items-center px-[12px] h-[40px] border-t" style="border-color: separator">
      <Button title="New List" symbol="plus" variant="ghost" class="text-[13px]" style="color: secondaryLabel" testID="new-list" @click="newList()" />
      <View class="flex-1" />
      <ToolbarButton label="Settings" symbol="slider.horizontal.3" style="color: #8e8e93" testID="sidebar-settings" @click="openSettings()" />
    </View>
  </View>

  <View :if="signedIn() && nav().section === 'todos'" class="flex-1 flex-col min-w-0" :style="{backgroundColor: editing() ? colors().dimmed : colors().list}" testID="todos-pane">
    <ScrollView class="flex-1" testID="todo-list">
      <View class="flex-col pb-[24px] pl-[48px] pr-[40px] pt-[30px]">
        <View class="flex-row gap-[10px] items-center pl-[12px] h-[36px]">
          <Icon :symbol="headerSymbol()" class="h-[24px] w-[24px]" :style="{color: headerColor()}" />
          <Text :if="view()?.kind === 'list'" class="flex-1 font-bold text-[24px]" :numberOfLines="1" :text="title()" testID="list-title" />
          <View :if="view()?.kind !== 'list'" class="flex-1"><TextInput class="h-[32px] font-bold text-[24px]" :bordered="false" :value="title()" @submit="renameList($event)" @blur="renameList($event)" testID="list-title" /></View>
        </View>
        <View :if="searching()" class="pl-[12px] pt-[14px]"><TextInput type="search" class="h-[26px] text-[13px]" placeholder="Search this list" :value="search()" @input="editSearch($event)" testID="search" /></View>
        <View :if="offline()" class="flex-row gap-[6px] items-center pl-[12px] pt-[10px]" testID="offline-note">
          <Icon symbol="wifi.slash" class="h-[12px] w-[12px]" style="color: secondaryLabel" />
          <Text class="text-[12px]" style="color: secondaryLabel" :text="'Offline, showing saved items'" />
        </View>
        <View class="h-[16px]" />

        <View :if="drafting()" class="flex-col gap-[6px] mb-[10px] px-[12px] py-[12px] border rounded-[12px]" :style="{backgroundColor: colors().card, borderColor: colors().hairline}" testID="draft-card">
          <View class="flex-row gap-[9px] items-center">
            <View class="h-[14px] w-[14px] border rounded-[3px]" :style="{borderColor: colors().checkbox}" />
            <View class="flex-1"><TextInput class="h-[24px] text-[15px]" :bordered="false" placeholder="New To-Do" :value="draft()" @input="draft.set(eventText($event))" @submit="commitDraft()" testID="draft-title" /></View>
          </View>
        </View>

        <View :for="b in blocks()" :key="b.key" class="flex-col">
          <View :if="b.kind === 'project'" class="flex-row gap-[8px] items-center mb-[4px] pb-[6px] pl-[10px] pt-[22px] border-b" :style="{borderColor: colors().hairline}">
            <Icon :symbol="b.symbol" class="h-[18px] w-[18px]" style="color: #2f6fe4" />
            <Text class="font-bold text-[16px]" :numberOfLines="1" :text="b.label" />
          </View>
          <View :if="b.kind === 'evening'" class="flex-row gap-[7px] items-center mb-[4px] pb-[6px] pl-[11px] pt-[22px] border-b" :style="{borderColor: colors().hairline}">
            <Icon symbol="moon.fill" class="h-[15px] w-[15px]" style="color: #4f6bd8" />
            <Text class="font-bold text-[16px]" :text="b.label" />
          </View>
          <View :if="b.kind === 'day'" class="flex-row gap-[6px] items-end pb-[4px] pl-[12px] pt-[22px]">
            <Text class="font-bold text-[24px]" :text="b.number" />
            <View class="flex-1 flex-col gap-[3px]">
              <View class="h-[1px]" :style="{backgroundColor: colors().hairline}" />
              <Text class="pb-[2px] font-bold text-[15px]" style="color: secondaryLabel" :text="b.label" />
            </View>
          </View>
          <View :if="b.kind === 'month'" class="flex-row gap-[8px] items-end pb-[4px] pl-[12px] pt-[24px]">
            <Text class="font-bold text-[20px]" :text="b.label" />
            <View class="flex-1 mb-[8px] h-[1px]" :style="{backgroundColor: colors().hairline}" />
          </View>
          <Text :if="b.kind === 'logday'" class="pb-[4px] pl-[12px] pt-[16px] font-bold text-[13px]" style="color: secondaryLabel" :text="b.label" />
          <View :if="b.kind === 'day' && !b.items.length" class="h-[26px]" />

          <View :for="todo in b.items" :key="todo.id" class="flex-col">
            <KeptMacTodoRow :if="todo.id !== todoId()" :item="todo" :marks="marksFor(todo, b.kind === 'project')" :selected="false" :colors="colors()" @choose="openTodo(todo)" @toggle="toggleTodo(todo)" @menu="todoMenu(todo)" />
            <View :if="todo.id === todoId()" class="flex-col gap-[4px] my-[10px] pb-[8px] pt-[10px] px-[12px] border rounded-[12px]" :style="{backgroundColor: colors().card, borderColor: colors().hairline}" testID="todo-editor">
              <View class="flex-row gap-[9px] items-center">
                <Pressable class="items-center justify-center shrink-0 h-[14px] w-[14px] border rounded-[3px]" :style="{borderColor: todo.completed_at ? colors().accent : colors().checkbox, backgroundColor: todo.completed_at ? colors().accent : 'transparent'}" testID="detail-check" @click="toggleTodo(todo)">
                  <Icon :if="todo.completed_at" symbol="checkmark" class="h-[9px] w-[9px]" style="color: #ffffff" />
                </Pressable>
                <View class="flex-1"><TextInput class="h-[24px] text-[15px]" :bordered="false" :value="dTitle()" placeholder="New To-Do" @input="editTodo('title', $event)" @submit="closeTodo()" @blur="flushTodo()" testID="detail-title" /></View>
              </View>
              <View class="pl-[14px]">
                <TextInput class="text-[14px]" :style="{height: notesHeight()}" :multiline="true" :bordered="false" :value="dNotes()" placeholder="Notes" :ghostText="ghostFor('todo')" @input="editTodo('notes', $event)" @blur="flushTodo()" @accept-completion="acceptGhost('todo', $event)" testID="detail-notes" />
              </View>
              <View :if="showChecklist() || todo.checklist.length" class="flex-col pl-[23px] pr-[4px] pt-[2px]">
                <View :for="item in todo.checklist" :key="item.id" class="flex-row gap-[8px] items-center h-[26px] border-b" :style="{borderColor: colors().hairline}">
                  <Pressable class="items-center justify-center h-[12px] w-[12px] border rounded-[6px]" :style="{borderColor: item.done ? colors().accent : colors().checkbox, backgroundColor: item.done ? colors().accent : 'transparent'}" :testID="'checkitem-' + item.id" @click="toggleCheckItem(item)">
                    <Icon :if="item.done" symbol="checkmark" class="h-[7px] w-[7px]" style="color: #ffffff" />
                  </Pressable>
                  <Text class="flex-1 text-[13px]" :numberOfLines="1" :style="{color: item.done ? 'secondaryLabel' : 'label', textDecorationLine: item.done ? 'line-through' : 'none'}" :text="item.title" />
                  <ToolbarButton label="Remove item" symbol="xmark" class="text-[11px]" @click="deleteCheckItem(item)" />
                </View>
                <View class="flex-row gap-[8px] items-center h-[26px]">
                  <View class="h-[12px] w-[12px] border rounded-[6px]" :style="{borderColor: colors().checkbox}" />
                  <View class="flex-1"><TextInput class="h-[22px] text-[13px]" :bordered="false" :value="dCheck()" placeholder="Add checklist item" @input="dCheck.set(eventText($event))" @submit="addCheckItem()" testID="detail-check-input" /></View>
                </View>
              </View>
              <View :if="showDate()" class="flex-row gap-[8px] items-center pl-[19px] h-[26px]">
                <Icon symbol="calendar" class="h-[13px] w-[13px]" style="color: #f2404f" />
                <View class="w-[160px]"><TextInput class="h-[22px] text-[13px]" :value="dStart()" placeholder="2026-11-04 or tomorrow" @input="editTodo('start', $event)" @submit="flushTodo()" @blur="flushTodo()" testID="detail-start" /></View>
              </View>
              <View :if="showDeadline()" class="flex-row gap-[8px] items-center pl-[19px] h-[26px]">
                <Icon symbol="flag.fill" class="h-[12px] w-[12px]" style="color: #e5484d" />
                <Text class="text-[13px]" style="color: secondaryLabel" :text="'Deadline'" />
                <View class="w-[160px]"><TextInput class="h-[22px] text-[13px]" :value="dDeadline()" placeholder="2026-11-20" @input="editTodo('deadline', $event)" @submit="flushTodo()" @blur="flushTodo()" testID="detail-deadline" /></View>
              </View>
              <View :if="showTags()" class="flex-row gap-[8px] items-center pl-[19px] h-[26px]">
                <Icon symbol="tag" class="h-[12px] w-[12px]" style="color: secondaryLabel" />
                <View class="flex-1"><TextInput class="h-[22px] text-[13px]" :value="dTags()" placeholder="Tags, separated by commas" @input="editTodo('tags', $event)" @submit="flushTodo()" @blur="flushTodo()" testID="detail-tags" /></View>
              </View>
              <Text :if="dHint()" class="pl-[19px] text-[11.5px]" style="color: secondaryLabel" :text="dHint()" testID="detail-hint" />
              <View class="flex-row gap-[2px] items-center pl-[13px] pt-[8px]">
                <Pressable class="flex-row gap-[6px] items-center px-[6px] h-[26px] rounded-[6px]" testID="detail-when" @click="whenMenu(todo)">
                  <Icon :symbol="chip()?.symbol || 'calendar'" class="h-[14px] w-[14px]" :style="{color: chip()?.color || '#8e8e93'}" />
                  <Text class="text-[14px]" :style="{color: chip()?.label === 'When' ? 'secondaryLabel' : 'label'}" :text="chip()?.label || 'When'" />
                </Pressable>
                <Pressable :if="todo.repeat && todo.repeat !== 'none'" class="flex-row gap-[4px] items-center px-[6px] h-[26px]" testID="detail-repeat" @click="repeatMenu(todo)">
                  <Icon symbol="repeat" class="h-[12px] w-[12px]" style="color: secondaryLabel" />
                  <Text class="text-[13px]" style="color: secondaryLabel" :text="REPEATS.find(r => r.value === todo.repeat)?.label || ''" />
                </Pressable>
                <View class="flex-1" />
                <ToolbarButton label="Tags" style="color: #a1a1a6" symbol="tag" testID="detail-tags-button" @click="showTags.set(!showTags())" />
                <ToolbarButton label="Checklist" style="color: #a1a1a6" symbol="checklist" testID="detail-checklist-button" @click="openChecklist()" />
                <ToolbarButton label="Deadline" style="color: #a1a1a6" symbol="flag" testID="detail-deadline-button" @click="showDeadline.set(!showDeadline())" />
              </View>
            </View>
          </View>
        </View>

        <View :if="!listCount() && !drafting()" class="gap-[10px] items-center pt-[110px]" testID="empty-list">
          <Icon :symbol="headerSymbol()" class="h-[72px] w-[72px]" :style="{color: colors().hairline}" />
          <Text :if="search() || (loading() && !todosLoaded())" class="text-[13px]" style="color: secondaryLabel" :text="search() ? 'Nothing matches your search.' : 'Loading your to-dos'" />
        </View>
      </View>
    </ScrollView>
    <Text :if="flash()" class="pl-[60px] pr-[40px] py-[6px] text-[12px]" style="color: secondaryLabel" :text="flash()" testID="status-message" />
    <View class="flex-row gap-[72px] items-center justify-center h-[40px] border-t" :style="{borderColor: colors().hairline, backgroundColor: colors().list}" testID="todo-toolbar">
      <ToolbarButton style="color: #9a9aa0" :if="!selectedTodo()" label="New To-Do" symbol="plus" :disabled="!canAdd()" testID="toolbar-new" @click="newTodo()" />
      <ToolbarButton style="color: #9a9aa0" :if="!selectedTodo()" label="When" symbol="calendar" :disabled="true" testID="toolbar-when" />
      <ToolbarButton style="color: #9a9aa0" label="Move" symbol="arrow.right" :disabled="!selectedTodo()" testID="toolbar-move" @click="moveMenu()" />
      <ToolbarButton style="color: #9a9aa0" :if="selectedTodo()" label="Delete" symbol="trash" testID="toolbar-delete" @click="deleteTodo()" />
      <ToolbarButton style="color: #9a9aa0" :if="selectedTodo()" label="More" symbol="ellipsis" testID="toolbar-more" @click="moreMenu()" />
      <ToolbarButton style="color: #9a9aa0" :if="!selectedTodo()" label="Search" symbol="magnifyingglass" testID="toolbar-search" @click="toggleSearch()" />
    </View>
  </View>

  <View :if="signedIn() && nav().section === 'notes'" class="flex-col shrink-0 w-[300px] border-r" :style="{backgroundColor: colors().list, borderColor: 'separator'}" testID="notes-pane">
    <View class="flex-row gap-[8px] items-center pb-[8px] pt-[14px] px-[16px]">
      <View class="flex-1 flex-col">
        <Text class="font-bold text-[15px]" :numberOfLines="1" :text="title()" testID="list-title" />
        <Text class="text-[12px]" style="color: secondaryLabel" :text="noteCount() === 1 ? '1 note' : noteCount() + ' notes'" testID="note-count" />
      </View>
      <ToolbarButton style="color: #8e8e93" :if="!inTrash()" label="New Note" symbol="square.and.pencil" testID="new-note" @click="newNote()" />
    </View>
    <View class="pb-[6px] px-[12px]"><TextInput type="search" class="h-[26px] text-[13px]" placeholder="Search" :value="search()" @input="editSearch($event)" testID="search" /></View>
    <View :if="offline()" class="flex-row gap-[6px] items-center pb-[6px] px-[16px]" testID="offline-note">
      <Icon symbol="wifi.slash" class="h-[12px] w-[12px]" style="color: secondaryLabel" />
      <Text class="text-[12px]" style="color: secondaryLabel" :text="'Offline, showing saved items'" />
    </View>
    <Text :if="inTrash()" class="pb-[6px] px-[16px] text-[11.5px]" style="color: secondaryLabel" :text="'Notes are removed for good after ' + trashDays() + ' days.'" />
    <ScrollView class="flex-1" testID="note-list">
      <View class="flex-col pb-[12px] px-[8px]">
        <View :for="group in noteGroups()" :key="group.key" class="flex-col">
          <Text class="pb-[4px] pt-[12px] px-[14px] font-bold text-[13px]" :text="group.label" />
          <KeptMacListRow :for="note in group.notes" :key="note.id" :rowId="'note-' + note.id" :title="note.title" :subtitle="noteSnippet(note)" :meta="inTrash() ? daysLeft(note.deleted_at, trashDays()) + ' days' : noteStamp(note.updated_at)" :folder="nav().folder === 'all' && note.note_folder_id ? folderName(note.note_folder_id) : ''" :symbol="note.pinned && group.key !== 'pinned' ? 'pin.fill' : ''" :selected="note.id === noteId()" :fill="colors().noteSelection" @choose="selectNote(note)" @menu="noteMenu(note)" />
        </View>
        <Text :if="!noteCount()" class="p-[16px] text-[12.5px]" style="color: secondaryLabel" :text="search() ? 'No notes match.' : inTrash() ? 'Nothing was deleted recently.' : 'No notes. Press Command N to start one.'" testID="notes-empty" />
      </View>
    </ScrollView>
  </View>

  <View :if="signedIn() && nav().section === 'notes'" class="flex-1 flex-col min-w-0" :style="{backgroundColor: colors().list}" testID="note-editor-pane">
    <View class="flex-row gap-[4px] items-center px-[14px] h-[44px] border-b" :style="{borderColor: colors().hairline}">
      <ToolbarButton style="color: #8e8e93" :if="!inTrash()" label="Format" symbol="textformat" :disabled="!selectedNote()" testID="note-format" @click="formatMenu()" />
      <ToolbarButton style="color: #8e8e93" :if="!inTrash()" label="Checklist" symbol="checklist" :disabled="!selectedNote()" testID="note-checklist" @click="setNoteBody(appendCheckLine(noteBody()))" />
      <ToolbarButton style="color: #8e8e93" :if="!inTrash()" :label="selectedNote()?.pinned ? 'Unpin' : 'Pin'" :symbol="selectedNote()?.pinned ? 'pin.slash' : 'pin'" :disabled="!selectedNote()" testID="note-pin" @click="togglePin()" />
      <View class="flex-1" />
      <Text :if="selectedNote()" class="text-[12px]" style="color: secondaryLabel" :text="inTrash() ? 'In Recently Deleted' : 'Edited ' + noteStamp(selectedNote().updated_at)" />
      <View class="flex-1" />
      <Button :if="inTrash() && selectedNote()" title="Recover" testID="note-restore" @click="restoreNote()" />
      <ToolbarButton style="color: #9a9aa0" label="Delete" symbol="trash" :disabled="!selectedNote()" testID="note-delete" @click="deleteNote()" />
      <ToolbarButton style="color: #8e8e93" :if="!inTrash()" label="New Note" symbol="square.and.pencil" testID="note-new" @click="newNote()" />
    </View>
    <View :if="selectedNote()" class="flex-1 flex-col pt-[18px] px-[28px]">
      <TextInput class="flex-1 text-[15px]" :multiline="true" :bordered="false" :disabled="inTrash()" :value="noteBody()" placeholder="Start writing" :ghostText="ghostFor('note')" @input="editNote($event)" @blur="flushNote()" @accept-completion="acceptGhost('note', $event)" testID="note-editor" />
    </View>
    <View :if="selectedNote() && noteChecks().length && !inTrash()" class="flex-col gap-[1px] px-[28px] py-[10px] border-t" :style="{borderColor: colors().hairline}" testID="note-checks">
      <Pressable :for="check in noteChecks()" :key="check.line" class="flex-row gap-[8px] items-center h-[24px]" :testID="'note-check-' + check.line" @click="setNoteBody(toggleCheckLine(noteBody(), check.line))">
        <View class="items-center justify-center h-[15px] w-[15px] border rounded-[8px]" :style="{borderColor: check.done ? '#e8a10c' : colors().checkbox, backgroundColor: check.done ? '#e8a10c' : 'transparent'}">
          <Icon :if="check.done" symbol="checkmark" class="h-[8px] w-[8px]" style="color: #ffffff" />
        </View>
        <Text class="flex-1 text-[13.5px]" :numberOfLines="1" :style="{color: check.done ? 'secondaryLabel' : 'label', textDecorationLine: check.done ? 'line-through' : 'none'}" :text="check.text || 'Empty item'" />
      </Pressable>
    </View>
    <View :if="!selectedNote()" class="flex-1 gap-[8px] items-center justify-center">
      <Icon symbol="note.text" class="h-[56px] w-[56px]" :style="{color: colors().hairline}" />
      <Text class="text-[13px]" style="color: secondaryLabel" :text="inTrash() ? 'No note selected' : 'Choose a note, or press Command N.'" />
    </View>
    <Text :if="flash()" class="px-[28px] py-[6px] text-[12px] border-t" :style="{borderColor: colors().hairline}" style="color: secondaryLabel" :text="flash()" testID="status-message" />
  </View>

  <View :if="signedIn() && nav().section === 'prompts'" class="flex-col shrink-0 w-[300px] border-r" :style="{backgroundColor: colors().list, borderColor: 'separator'}" testID="prompts-pane">
    <View class="flex-row gap-[8px] items-center pb-[2px] pt-[14px] px-[16px]">
      <Text class="flex-1 font-bold text-[15px]" :numberOfLines="1" :text="title()" testID="list-title" />
      <ToolbarButton style="color: #8e8e93" :if="library()?.owned" label="Share Library" symbol="person.crop.circle.badge.plus" testID="share-library" @click="openShare()" />
      <ToolbarButton style="color: #8e8e93" :if="canEdit()" label="New Prompt" symbol="square.and.pencil" testID="new-prompt" @click="newPrompt()" />
    </View>
    <Text class="pb-[8px] px-[16px] text-[12px]" style="color: secondaryLabel" :text="library()?.owned ? (library().library.description || 'Your library') : ('Shared by ' + (library()?.library.owner || 'someone') + (canEdit() ? ', you can edit' : ', view only'))" testID="library-role" />
    <View class="pb-[6px] px-[12px]"><TextInput type="search" class="h-[26px] text-[13px]" placeholder="Search prompts" :value="search()" @input="editSearch($event)" testID="search" /></View>
    <View :if="offline()" class="flex-row gap-[6px] items-center pb-[6px] px-[16px]" testID="offline-note">
      <Icon symbol="wifi.slash" class="h-[12px] w-[12px]" style="color: secondaryLabel" />
      <Text class="text-[12px]" style="color: secondaryLabel" :text="'Offline, showing saved items'" />
    </View>
    <ScrollView class="flex-1" testID="prompt-list">
      <View class="flex-col gap-[1px] pb-[12px] px-[8px]">
        <KeptMacListRow :for="prompt in shownPrompts()" :key="prompt.id" :rowId="'prompt-' + prompt.id" :title="prompt.title" :subtitle="prompt.description || prompt.body" :meta="prompt.uses ? (prompt.uses === 1 ? '1 use' : prompt.uses + ' uses') : ''" :symbol="prompt.favorite ? 'star.fill' : ''" :selected="prompt.id === promptId()" :fill="colors().selection" @choose="choosePrompt(prompt)" @menu="promptMenu(prompt)" />
        <Text :if="!shownPrompts().length" class="p-[16px] text-[12.5px]" style="color: secondaryLabel" :text="search() ? 'No prompts match.' : 'No prompts in this library yet.'" testID="prompts-empty" />
      </View>
    </ScrollView>
  </View>

  <View :if="signedIn() && nav().section === 'prompts'" class="flex-1 flex-col min-w-0" :style="{backgroundColor: colors().list}" testID="prompt-editor-pane">
    <View :if="selectedPrompt()" class="flex-row gap-[6px] items-center px-[14px] h-[44px] border-b" :style="{borderColor: colors().hairline}">
      <Text class="flex-1 text-[12px]" style="color: secondaryLabel" :text="selectedPrompt() ? 'Version ' + selectedPrompt().version + (pDirty() ? ', edited' : '') : ''" testID="prompt-version" />
      <Button :if="canEdit()" title="Save" :disabled="!pDirty()" testID="prompt-save" @click="savePrompt()" />
      <ToolbarButton style="color: #8e8e93" label="Version History" symbol="clock.arrow.circlepath" testID="prompt-history" @click="openHistory()" />
      <ToolbarButton style="color: #8e8e93" :if="canEdit()" label="Delete Prompt" symbol="trash" testID="prompt-delete" @click="deletePrompt()" />
      <Button title="Use" symbol="doc.on.clipboard" variant="primary" testID="prompt-use" @click="openUse()" />
    </View>
    <View :if="selectedPrompt()" class="flex-1 flex-col gap-[10px] px-[28px] py-[18px]">
      <TextInput class="h-[30px] font-bold text-[20px]" :bordered="false" :value="pTitle()" :disabled="!canEdit()" placeholder="Prompt title" @input="editPrompt('title', $event)" @submit="savePrompt()" testID="prompt-title" />
      <TextInput class="h-[22px] text-[13px]" :bordered="false" :value="pDesc()" :disabled="!canEdit()" placeholder="What it is for" @input="editPrompt('description', $event)" @submit="savePrompt()" testID="prompt-description" />
      <TextInput class="h-[22px] text-[13px]" :bordered="false" :value="pTags()" :disabled="!canEdit()" placeholder="Tags, separated by commas" @input="editPrompt('tags', $event)" @submit="savePrompt()" testID="prompt-tags" />
      <View class="h-[1px]" :style="{backgroundColor: colors().hairline}" />
      <TextInput class="flex-1 text-[14px]" :multiline="true" :bordered="false" :value="pBody()" :disabled="!canEdit()" placeholder="Write the prompt. Put a variable in double braces where details go." :ghostText="ghostFor('prompt')" @input="editPrompt('body', $event)" @accept-completion="acceptGhost('prompt', $event)" testID="prompt-body" />
      <View class="flex-row gap-[6px] items-center" testID="prompt-variables">
        <Text class="text-[12px]" style="color: secondaryLabel" :text="variables().length ? 'Variables' : 'No variables yet. Wrap a name in double braces to add one.'" />
        <View :for="name in variables()" :key="name" class="justify-center px-[7px] h-[20px] rounded-[6px]" :style="{backgroundColor: colors().variableFill}">
          <Text class="text-[12px]" :style="{color: colors().variable}" :text="name" />
        </View>
      </View>
    </View>
    <View :if="!selectedPrompt()" class="flex-1 gap-[8px] items-center justify-center">
      <Icon symbol="text.book.closed" class="h-[56px] w-[56px]" :style="{color: colors().hairline}" />
      <Text class="text-[13px]" style="color: secondaryLabel" :text="'Choose a prompt to read, edit or use.'" />
    </View>
    <Text :if="flash()" class="px-[28px] py-[6px] text-[12px]" style="color: secondaryLabel" :text="flash()" testID="status-message" />
  </View>

  <Modal :if="useOpen()" :visible="true" title="Use Prompt" testID="use-sheet">
    <View class="flex-col gap-[12px] p-[24px]">
      <Text class="font-bold text-[17px]" :text="selectedPrompt()?.title || 'Prompt'" />
      <Text :if="!variables().length" class="text-[12.5px]" style="color: secondaryLabel" :text="'This prompt has no variables. Copy it as it is.'" />
      <View :for="name in variables()" :key="name" class="flex-row gap-[12px] items-center">
        <Text class="w-[110px] text-[12.5px]" :numberOfLines="1" :text="name" />
        <View class="flex-1"><TextInput class="h-[24px] text-[13px]" :value="useValues()[name] || ''" :placeholder="name" @input="setVariable(name, $event)" @submit="copyFilled()" :testID="'use-var-' + name" /></View>
      </View>
      <Text class="pt-[4px] font-bold text-[11px]" style="color: secondaryLabel" :text="'PREVIEW'" />
      <View class="p-[12px] rounded-[8px]" :style="{backgroundColor: colors().hover}">
        <Text class="text-[13px]" :text="filled()" testID="use-preview" />
      </View>
      <View class="flex-row gap-[8px] justify-end pt-[4px]">
        <Button title="Cancel" testID="use-cancel" @click="useOpen.set(false)" />
        <Button title="Copy" symbol="doc.on.doc" variant="primary" testID="use-copy" @click="copyFilled()" />
      </View>
    </View>
  </Modal>

  <Modal :if="historyOpen()" :visible="true" title="Version History" testID="history-sheet">
    <View class="flex-col gap-[12px] p-[24px]">
      <Text class="font-bold text-[17px]" :text="'Version History'" />
      <Text :if="!versions().length" class="text-[12.5px]" style="color: secondaryLabel" :text="'No earlier versions.'" />
      <View :for="version in versions()" :key="version.id" class="flex-row gap-[12px] items-start py-[8px] border-b" :style="{borderColor: colors().hairline}" :testID="'version-' + version.version">
        <View class="flex-1 flex-col gap-[2px]">
          <Text class="font-bold text-[13px]" :text="'Version ' + version.version + (version.author ? ', by ' + version.author : '')" />
          <Text class="text-[12px]" style="color: secondaryLabel" :numberOfLines="2" :text="version.body" />
        </View>
        <Button :if="canEdit() && version.version !== selectedPrompt()?.version" title="Restore" :testID="'restore-' + version.version" @click="restoreVersion(version)" />
      </View>
      <View class="flex-row justify-end pt-[4px]"><Button title="Done" testID="history-done" @click="historyOpen.set(false)" /></View>
    </View>
  </Modal>

  <Modal :if="shareOpen()" :visible="true" title="Share Library" testID="share-sheet">
    <View class="flex-col gap-[12px] p-[24px]">
      <Text class="font-bold text-[17px]" :text="'Share ' + title()" />
      <View class="flex-row gap-[8px] items-center">
        <View class="flex-1"><TextInput class="h-[24px] text-[13px]" :value="shareEmail()" placeholder="Email address" @input="shareEmail.set(eventText($event))" @submit="invite()" testID="share-email" /></View>
        <View class="w-[100px]"><Picker :value="shareRole()" :options="[{value:'viewer',label:'Viewer'},{value:'editor',label:'Editor'}]" @change="shareRole.set(String(eventValue($event)))" testID="share-role" /></View>
        <Button title="Invite" variant="primary" :disabled="!shareEmail().trim()" testID="share-invite" @click="invite()" />
      </View>
      <Text :if="!shares().people.length" class="text-[12.5px]" style="color: secondaryLabel" :text="'Nobody else has this library yet.'" />
      <View :for="person in shares().people" :key="person.id" class="flex-row gap-[8px] items-center py-[4px]" :testID="'share-person-' + person.id">
        <View class="flex-1 flex-col">
          <Text class="text-[13px]" :numberOfLines="1" :text="person.name || person.email" />
          <Text class="text-[11.5px]" style="color: secondaryLabel" :numberOfLines="1" :text="person.email + (person.accepted ? '' : ', invited')" />
        </View>
        <Text class="text-[12px]" style="color: secondaryLabel" :text="person.role === 'editor' ? 'Editor' : 'Viewer'" />
        <ToolbarButton label="Remove access" symbol="xmark.circle" :testID="'share-remove-' + person.id" @click="removeShare(person)" />
      </View>
      <View class="flex-row gap-[8px] items-center pt-[8px] border-t" :style="{borderColor: colors().hairline}">
        <Switch :value="!!shares().link" @change="setLink($event)" testID="share-link-toggle" />
        <Text class="flex-1 text-[13px]" :text="'Anyone with the link can view'" />
        <Button :if="linkUrl()" title="Copy Link" symbol="link" testID="share-copy-link" @click="copyLink()" />
      </View>
      <Text :if="linkUrl()" class="text-[11.5px]" style="color: secondaryLabel" :text="linkUrl()" testID="share-link" />
      <View class="flex-row justify-end pt-[4px]"><Button title="Done" testID="share-done" @click="shareOpen.set(false)" /></View>
    </View>
  </Modal>
</View>
