<script client>
import { today as deviceDay } from '../functions/kept/api'
import { toggleCheckLine } from '../functions/kept/markdown'
import { apiOrigin, desktop, keychainSession, nativeApi, nativeCraft, palette, readCache, saveAccount, savedAccount, writeCache } from '../functions/kept/native-kept'
import { appendCheckLine, checkLines, NEW_PROMPT_BODY, chipColors, eventText, eventValue, fillPrompt, findLibrary, isOfflineError, navId, navTitle, noteStamp, parseDayField, parseNav, promptVariables, quickEntry, REPEATS, resolveDay, shareLink, SMART_LISTS, sidebarSections, todoChips, todoGroups, toggleChecklist, WHEN_CHOICES } from '../functions/kept/native-model'
import { filterNotes, groupNotes, normalizeNote } from '../functions/kept/notes'
import { filterPrompts, normalizePrompt } from '../functions/kept/promptview'
import { counts, normalizeTodo, parseTagInput, serializeChanges, whenPatch } from '../functions/kept/todos'

const session = keychainSession()
const api = nativeApi(session, () => signedOutHere())

// Who and where
const scheme = state(nativeCraft().appearance.colorScheme())
const colors = derived(() => palette(scheme()))
const account = state(savedAccount())
const signedIn = state(!!session.token())
const authBusy = state(false)
const authError = state('')
const signOuts = state(0)
const today = state(deviceDay())
const nav = state({ section: 'todos', view: { kind: 'list', name: 'today' } })
const search = state('')
const offline = state(false)
const flash = state('')
const loading = state(false)

// Data
const sidebar = state(null)
const libraries = state(null)
const open = state([])
const logbook = state([])
const todosLoaded = state(false)
const notes = state([])
const notesLoaded = state(false)
const prompts = state([])
const promptRole = state('owner')

// To-dos
const quick = state('')
const todoId = state(0)
const dTitle = state('')
const dNotes = state('')
const dWhen = state('inbox')
const dStart = state('')
const dDeadline = state('')
const dTags = state('')
const dRepeat = state('none')
const dCheck = state('')
const dHint = state('')

// Notes
const noteId = state(0)
const noteBody = state('')

// Prompts
const promptId = state(0)
const pTitle = state('')
const pDesc = state('')
const pTags = state('')
const pBody = state('')
const pDirty = state(false)
const useOpen = state(false)
const useValues = state({})
const historyOpen = state(false)
const versions = state([])
const shareOpen = state(false)
const shares = state({ link: null, people: [] })
const shareEmail = state('')
const shareRole = state('viewer')

const view = derived(() => nav().section === 'todos' ? nav().view : null)
const sections = derived(() => sidebarSections(sidebar(), libraries(), todosLoaded() ? counts(open(), today()) : undefined))
const selectedNav = derived(() => navId(nav()))
const title = derived(() => navTitle(nav(), sidebar(), libraries()))
const smart = derived(() => view()?.kind === 'list' ? SMART_LISTS.find(list => list.name === view().name) : null)
const headerSymbol = derived(() => nav().section === 'notes' ? 'note.text' : nav().section === 'prompts' ? 'text.book.closed' : smart()?.icon ?? (view()?.kind === 'area' ? 'square.stack.3d.up' : 'circle.dashed'))
const headerColor = derived(() => smart()?.color ?? '#1a7cf5')
const projectTitle = id => sidebar()?.projects.find(p => p.id === id)?.title
const groups = derived(() => view() ? todoGroups(view(), open(), logbook(), today(), search()) : [])
const listCount = derived(() => groups().reduce((total, group) => total + group.items.length, 0))
const canAdd = derived(() => !!view() && !(view().kind === 'list' && view().name === 'logbook'))
const selectedTodo = derived(() => open().find(t => t.id === todoId()) ?? logbook().find(t => t.id === todoId()) ?? null)
const noteSections = derived(() => nav().section === 'notes' ? groupNotes(filterNotes(notes(), nav().folder, search())) : [])
const noteCount = derived(() => noteSections().reduce((total, group) => total + group.notes.length, 0))
const selectedNote = derived(() => notes().find(n => n.id === noteId()) ?? null)
const noteChecks = derived(() => checkLines(noteBody()))
const library = derived(() => nav().section === 'prompts' ? findLibrary(libraries(), nav().library) : null)
const canEdit = derived(() => !!library()?.canEdit && promptRole() !== 'viewer')
const shownPrompts = derived(() => filterPrompts(prompts(), offline() ? search() : '', false))
const selectedPrompt = derived(() => prompts().find(p => p.id === promptId()) ?? null)
const variables = derived(() => promptVariables(pBody()))
const filled = derived(() => fillPrompt(pBody(), useValues()))
const linkUrl = derived(() => shares().link?.token ? shareLink(apiOrigin(), shares().link.token) : '')

function chipsFor(todo) {
  return todoChips(todo, view() ?? { kind: 'list', name: 'inbox' }, today(), projectTitle).slice(0, 4).map(chip => ({ ...chip, ...chipColors(chip.tone, colors().dark) }))
}

function say(text) {
  flash.set(text)
  setTimeout(() => { if (flash() === text) flash.set('') }, 5000)
}

/** Report a failure the way it happened: offline keeps the saved copy, anything else says what the server said. */
function failed(error, doing) {
  if (isOfflineError(error)) { offline.set(true); say(`You are offline. ${doing} needs a connection.`); return }
  if (error?.status === 401) return
  say(error?.message || `${doing} did not work.`)
}

// Loading, with the saved copy drawn first

function hydrate() {
  const who = account()
  sidebar.set(readCache(who, 'sidebar'))
  libraries.set(readCache(who, 'libraries'))
  const todos = readCache(who, 'todos')
  if (todos) { open.set(todos.open || []); logbook.set(todos.logbook || []); todosLoaded.set(true) }
  const saved = readCache(who, 'notes')
  if (saved) { notes.set(saved); notesLoaded.set(true) }
}

async function loadSidebar() {
  const [data, libs] = await Promise.all([api.sidebar(today()), api.libraries()])
  sidebar.set(data); libraries.set(libs)
  writeCache(account(), 'sidebar', data); writeCache(account(), 'libraries', libs)
}

function saveTodos() { writeCache(account(), 'todos', { open: open(), logbook: logbook() }) }

async function loadTodos() {
  const names = ['inbox', 'today', 'upcoming', 'anytime', 'someday']
  const [lists, log] = await Promise.all([Promise.all(names.map(name => api.list(name, today()))), api.list('logbook', today())])
  const seen = new Map()
  for (const list of lists) for (const row of list.todos) seen.set(row.id, normalizeTodo(row))
  open.set([...seen.values()])
  logbook.set(log.todos.map(row => normalizeTodo(row)).filter(t => t.completed_at || t.canceled_at))
  todosLoaded.set(true)
  saveTodos()
}

async function loadNotes() {
  notes.set((await api.notes()).map(row => normalizeNote(row)))
  notesLoaded.set(true)
  writeCache(account(), 'notes', notes())
}

async function loadPrompts(id, text = '') {
  if (!text) {
    const saved = readCache(account(), `prompts.${id}`)
    if (saved && !prompts().length) { prompts.set(saved.prompts || []); promptRole.set(saved.role || 'owner') }
  }
  try {
    const result = await api.prompts(id, text)
    if (nav().section !== 'prompts' || nav().library !== id) return
    prompts.set(result.prompts.map(row => normalizePrompt(row)))
    promptRole.set(result.role || 'owner')
    if (!text) writeCache(account(), `prompts.${id}`, { role: result.role, prompts: prompts() })
    offline.set(false)
  }
  catch (error) { failed(error, 'Loading prompts') }
}

async function refreshAll() {
  if (!signedIn()) return
  loading.set(true)
  today.set(deviceDay())
  try {
    await Promise.all([loadSidebar(), loadTodos(), loadNotes()])
    offline.set(false)
    if (nav().section === 'prompts') await loadPrompts(nav().library)
  }
  catch (error) {
    if (isOfflineError(error)) offline.set(true)
    else if (error?.status !== 401) say(error?.message || 'Could not refresh.')
  }
  finally { loading.set(false) }
}

// Account

async function signInWith(form) {
  authBusy.set(true)
  authError.set('')
  try {
    const user = form.mode === 'register' ? await api.signUp(form.name, form.email, form.password) : await api.signIn(form.email, form.password)
    startSession(user)
  }
  catch (error) {
    authError.set(isOfflineError(error) ? 'Kept cannot reach the server. Check your connection and try again.' : (error?.message || 'Those details did not work.'))
  }
  finally { authBusy.set(false) }
}

function startSession(user) {
  if (user) { account.set(user); saveAccount(user) }
  signedIn.set(true)
  hydrate()
  refreshAll()
  api.me().then((me) => { account.set(me); saveAccount(me) }).catch(() => {})
}

function clearData() {
  sidebar.set(null); libraries.set(null); open.set([]); logbook.set([]); notes.set([]); prompts.set([])
  todosLoaded.set(false); notesLoaded.set(false); todoId.set(0); noteId.set(0); promptId.set(0)
  useOpen.set(false); historyOpen.set(false); shareOpen.set(false)
  nav.set({ section: 'todos', view: { kind: 'list', name: 'today' } })
}

function signedOutHere() {
  signedIn.set(false)
  signOuts.set(signOuts() + 1)
  clearData()
}

async function signOut() {
  try { await api.signOut() }
  catch { session.save(null) }
  saveAccount(null)
  account.set(null)
  signedOutHere()
}

function openSettings() {
  desktop().openWindow({ name: 'settings', route: 'Settings', title: 'Settings', width: 520, height: 420, minWidth: 460, minHeight: 360 })
}

// Navigation

async function pickNav(id) {
  const next = parseNav(String(id))
  if (!next) return
  await leavePrompt()
  flushTodo()
  nav.set(next)
  search.set('')
  if (next.section === 'notes') {
    const first = groupNotes(filterNotes(notes(), next.folder, ''))[0]?.notes[0]
    selectNote(first ?? null)
    if (!notesLoaded()) loadNotes().catch(error => failed(error, 'Loading notes'))
  }
  if (next.section === 'prompts') {
    prompts.set([])
    selectPrompt(null)
    await loadPrompts(next.library)
    selectPrompt(prompts()[0] ?? null)
  }
  if (next.section === 'todos') todoId.set(0)
}

// To-dos

function replaceTodo(todo) {
  const swap = row => (row.id === todo.id ? todo : row)
  open.set(open().map(swap))
  logbook.set(logbook().map(swap))
  saveTodos()
}

async function addQuick() {
  const fields = quickEntry(view(), quick(), today())
  if (!fields) return
  const bottom = Math.max(0, ...open().map(t => t.sort_order || 0))
  quick.set('')
  try {
    const todo = normalizeTodo(await api.createTodo({ ...fields, sort_order: bottom + 1 }))
    open.set([...open(), todo])
    saveTodos()
    loadSidebar().catch(() => {})
  }
  catch (error) { quick.set(fields.title); failed(error, 'Adding a to-do') }
}

async function toggleTodo(todo) {
  if (!todo) return
  try {
    if (todo.completed_at || todo.canceled_at) {
      const result = await api.reopenTodo(todo.id)
      const back = { ...normalizeTodo(result.todo), checklist: todo.checklist }
      logbook.set(logbook().filter(t => t.id !== todo.id))
      open.set([...open().filter(t => t.id !== todo.id), back])
    }
    else {
      const result = await api.completeTodo(todo.id, today())
      const finished = { ...normalizeTodo(result.todo), checklist: todo.checklist }
      open.set([...open().filter(t => t.id !== todo.id), ...(result.next ? [normalizeTodo(result.next)] : [])])
      logbook.set([finished, ...logbook().filter(t => t.id !== todo.id)])
      if (result.next) say(`Done. It comes back on ${result.next.start_date || 'its next date'}.`)
    }
    saveTodos()
    loadSidebar().catch(() => {})
  }
  catch (error) { failed(error, 'Completing a to-do') }
}

function selectTodo(todo) {
  flushTodo()
  todoId.set(todo?.id ?? 0)
  if (!todo) return
  dTitle.set(todo.title)
  dNotes.set(todo.notes || '')
  dWhen.set(todo.when || 'inbox')
  dStart.set(todo.start_date || '')
  dDeadline.set(todo.deadline || '')
  dTags.set((todo.tags || []).join(', '))
  dRepeat.set(todo.repeat || 'none')
  dCheck.set('')
  dHint.set('')
}

async function saveTodo(changes, todo = selectedTodo()) {
  if (!todo || !Object.keys(changes).length) return
  try {
    const saved = normalizeTodo(await api.updateTodo(todo.id, serializeChanges(changes)))
    const current = open().find(t => t.id === todo.id) ?? logbook().find(t => t.id === todo.id) ?? todo
    replaceTodo({ ...current, ...saved, checklist: current.checklist })
  }
  catch (error) { failed(error, 'Saving the to-do') }
}

let todoTimer = 0
/** What the typed fields change, compared with the saved to-do; nothing for a date that is half typed. */
function typedChanges() {
  const todo = selectedTodo()
  if (!todo) return {}
  const changes = {}
  if (dTitle().trim() && dTitle().trim() !== todo.title) changes.title = dTitle().trim()
  if (dNotes() !== (todo.notes || '')) changes.notes = dNotes()
  const tags = parseTagInput(dTags())
  if (tags.join('\n') !== (todo.tags || []).join('\n')) changes.tags = tags
  const start = parseDayField(dStart())
  const deadline = parseDayField(dDeadline())
  dHint.set(start.ok && deadline.ok ? '' : 'Dates look like 2026-11-04, or type tomorrow.')
  if (start.ok && resolveDay(start.value, today()) !== (todo.start_date || null)) {
    if (start.value) { changes.start_date = resolveDay(start.value, today()); if (todo.when === 'inbox') changes.when = 'anytime' }
    else changes.start_date = null
  }
  if (deadline.ok && resolveDay(deadline.value, today()) !== (todo.deadline || null)) changes.deadline = resolveDay(deadline.value, today())
  return changes
}

function flushTodo() {
  clearTimeout(todoTimer)
  if (selectedTodo()) saveTodo(typedChanges())
}

/** Template handlers see a signal's value, not the signal, so fields are named. */
const todoFields = { title: dTitle, notes: dNotes, start: dStart, deadline: dDeadline, tags: dTags }
const promptFields = { title: pTitle, description: pDesc, tags: pTags, body: pBody }

function editTodo(name, event) {
  todoFields[name].set(eventText(event))
  clearTimeout(todoTimer)
  todoTimer = setTimeout(() => saveTodo(typedChanges()), 650)
}

function chooseWhen(event) {
  const value = String(eventValue(event))
  dWhen.set(value)
  dStart.set('')
  saveTodo(value === 'inbox' ? { when: 'inbox', start_date: null } : whenPatch(value))
}

function chooseRepeat(event) {
  const value = String(eventValue(event))
  dRepeat.set(value)
  saveTodo({ repeat: value })
}

async function addCheckItem() {
  const todo = selectedTodo()
  const text = dCheck().trim()
  if (!todo || !text) return
  dCheck.set('')
  try {
    const item = await api.createChecklistItem(todo.id, text)
    replaceTodo({ ...todo, checklist: [...todo.checklist, { ...item, done: !!item.done }] })
  }
  catch (error) { dCheck.set(text); failed(error, 'Adding a checklist item') }
}

async function toggleCheckItem(item) {
  const todo = selectedTodo()
  if (!todo) return
  try {
    await api.updateChecklistItem(item.id, { done: !item.done })
    replaceTodo({ ...todo, checklist: todo.checklist.map(i => (i.id === item.id ? { ...i, done: !item.done } : i)) })
  }
  catch (error) { failed(error, 'Updating the checklist') }
}

async function deleteCheckItem(item) {
  const todo = selectedTodo()
  if (!todo) return
  try {
    await api.deleteChecklistItem(item.id)
    replaceTodo({ ...todo, checklist: todo.checklist.filter(i => i.id !== item.id) })
  }
  catch (error) { failed(error, 'Removing the checklist item') }
}

function confirmDelete(what, message) {
  return nativeCraft().dialog.confirm({ title: `Delete ${what}?`, message, confirmText: 'Delete', confirmLabel: 'Delete', cancelText: 'Cancel', cancelLabel: 'Cancel', destructive: true })
}

async function deleteTodo(todo = selectedTodo()) {
  if (!todo || !await confirmDelete(`"${todo.title}"`, 'The to-do and its checklist are removed.')) return
  try {
    await api.deleteTodo(todo.id)
    open.set(open().filter(t => t.id !== todo.id))
    logbook.set(logbook().filter(t => t.id !== todo.id))
    if (todoId() === todo.id) todoId.set(0)
    saveTodos()
    loadSidebar().catch(() => {})
  }
  catch (error) { failed(error, 'Deleting the to-do') }
}

async function todoMenu(todo) {
  selectTodo(todo)
  const done = !!(todo.completed_at || todo.canceled_at)
  const choice = await desktop().contextMenu([
    { id: 'toggle', title: done ? 'Mark as Not Done' : 'Complete', icon: done ? 'circle' : 'checkmark.circle' },
    { separator: true },
    { id: 'today', title: 'Today', icon: 'star' },
    { id: 'evening', title: 'This Evening', icon: 'moon' },
    { id: 'anytime', title: 'Anytime', icon: 'square.stack' },
    { id: 'someday', title: 'Someday', icon: 'archivebox' },
    { separator: true },
    { id: 'delete', title: 'Delete To-Do', icon: 'trash' },
  ])
  if (choice === 'toggle') await toggleTodo(todo)
  if (choice === 'delete') await deleteTodo(todo)
  if (['today', 'evening', 'anytime', 'someday'].includes(choice)) { dWhen.set(choice); dStart.set(''); await saveTodo(whenPatch(choice), todo) }
}

function newTodo() {
  if (!canAdd()) pickNav('list:inbox')
  setTimeout(() => desktop().focus('quick-entry'), 50)
}

// Notes

let noteTimer = 0
async function saveNote(extra = {}) {
  const note = selectedNote()
  clearTimeout(noteTimer)
  if (!note) return
  const body = noteBody()
  if (body === note.body && !Object.keys(extra).length) return
  try {
    const saved = normalizeNote(await api.saveNote({ id: note.id, body, ...extra }))
    notes.set(notes().map(n => (n.id === saved.id ? saved : n)))
    writeCache(account(), 'notes', notes())
  }
  catch (error) { failed(error, 'Saving the note') }
}

function flushNote() {
  clearTimeout(noteTimer)
  if (selectedNote() && noteBody() !== selectedNote().body) saveNote()
}

function selectNote(note) {
  flushNote()
  noteId.set(note?.id ?? 0)
  noteBody.set(note?.body ?? '')
}

function editNote(event) {
  noteBody.set(eventText(event))
  clearTimeout(noteTimer)
  noteTimer = setTimeout(() => saveNote(), 800)
}

function setNoteBody(body) {
  noteBody.set(body)
  saveNote()
}

async function newNote() {
  if (nav().section !== 'notes') await pickNav('notes:all')
  flushNote()
  const folder = nav().folder === 'all' ? null : nav().folder
  try {
    const note = normalizeNote(await api.saveNote({ body: 'New Note', note_folder_id: folder }))
    notes.set([note, ...notes()])
    search.set('')
    selectNote(note)
    writeCache(account(), 'notes', notes())
    loadSidebar().catch(() => {})
    setTimeout(() => desktop().focus('note-editor'), 50)
  }
  catch (error) { failed(error, 'Creating a note') }
}

async function deleteNote(note = selectedNote()) {
  if (!note || !await confirmDelete(`"${note.title || 'this note'}"`, 'The note is removed from every device.')) return
  try {
    await api.deleteNote(note.id)
    notes.set(notes().filter(n => n.id !== note.id))
    if (noteId() === note.id) { noteId.set(0); noteBody.set('') }
    writeCache(account(), 'notes', notes())
    loadSidebar().catch(() => {})
  }
  catch (error) { failed(error, 'Deleting the note') }
}

async function togglePin(note = selectedNote()) {
  if (!note) return
  if (note.id !== noteId()) selectNote(note)
  await saveNote({ pinned: !note.pinned })
}

async function noteMenu(note) {
  selectNote(note)
  const choice = await desktop().contextMenu([
    { id: 'pin', title: note.pinned ? 'Unpin Note' : 'Pin Note', icon: 'pin' },
    { separator: true },
    { id: 'delete', title: 'Delete Note', icon: 'trash' },
  ])
  if (choice === 'pin') await togglePin(note)
  if (choice === 'delete') await deleteNote(note)
}

// Prompts

function selectPrompt(prompt) {
  promptId.set(prompt?.id ?? 0)
  pTitle.set(prompt?.title ?? '')
  pDesc.set(prompt?.description ?? '')
  pTags.set((prompt?.tags ?? []).join(', '))
  pBody.set(prompt?.body ?? '')
  pDirty.set(false)
}

function editPrompt(name, event) {
  promptFields[name].set(eventText(event))
  pDirty.set(true)
}

async function savePrompt() {
  const prompt = selectedPrompt()
  if (!prompt || !canEdit() || !pDirty()) return
  try {
    const saved = normalizePrompt(await api.savePrompt({ id: prompt.id, title: pTitle().trim() || 'Untitled prompt', description: pDesc(), body: pBody(), tags: parseTagInput(pTags()) }))
    prompts.set(prompts().map(p => (p.id === saved.id ? saved : p)))
    pDirty.set(false)
    say(saved.version > prompt.version ? `Saved as version ${saved.version}.` : 'Saved.')
  }
  catch (error) { failed(error, 'Saving the prompt') }
}

/** Unsaved prompt edits are kept when you move on, the way the note editor keeps its text. */
async function leavePrompt() {
  if (pDirty() && canEdit()) await savePrompt()
}

async function choosePrompt(prompt) {
  await leavePrompt()
  selectPrompt(prompt)
}

async function newPrompt() {
  if (nav().section !== 'prompts') {
    const first = libraries()?.owned[0]
    if (!first) { say('Create a prompt library on the web first.'); return }
    await pickNav(`library:${first.id}`)
  }
  if (!canEdit()) { say('You can read this library but not add to it.'); return }
  await leavePrompt()
  try {
    const prompt = normalizePrompt(await api.savePrompt({ library_id: nav().library, title: 'Untitled prompt', body: NEW_PROMPT_BODY, tags: [] }))
    prompts.set([prompt, ...prompts()])
    selectPrompt(prompt)
    loadSidebar().catch(() => {})
    setTimeout(() => desktop().focus('prompt-title'), 50)
  }
  catch (error) { failed(error, 'Creating a prompt') }
}

async function deletePrompt(prompt = selectedPrompt()) {
  if (!prompt || !canEdit() || !await confirmDelete(`"${prompt.title}"`, 'Everyone this library is shared with loses it too.')) return
  try {
    await api.deletePrompt(prompt.id)
    prompts.set(prompts().filter(p => p.id !== prompt.id))
    selectPrompt(prompts()[0] ?? null)
    loadSidebar().catch(() => {})
  }
  catch (error) { failed(error, 'Deleting the prompt') }
}

function openUse() {
  if (!selectedPrompt()) return
  useValues.set({})
  useOpen.set(true)
}

function setVariable(name, event) {
  useValues.set({ ...useValues(), [name]: eventText(event) })
}

async function copyFilled() {
  const prompt = selectedPrompt()
  if (!prompt) return
  try {
    await nativeCraft().clipboard.write(filled())
    useOpen.set(false)
    say('Copied to the clipboard.')
    const result = await api.usePrompt(prompt.id)
    prompts.set(prompts().map(p => (p.id === prompt.id ? { ...p, uses: result.uses } : p)))
  }
  catch (error) { failed(error, 'Copying the prompt') }
}

async function openHistory() {
  if (!selectedPrompt()) return
  // Loaded before the sheet opens: the host sizes a sheet once, when it appears.
  try {
    versions.set((await api.promptVersions(selectedPrompt().id)).versions)
    historyOpen.set(true)
  }
  catch (error) { failed(error, 'Loading the history') }
}

async function restoreVersion(version) {
  const prompt = selectedPrompt()
  if (!prompt || !canEdit()) return
  try {
    const saved = normalizePrompt(await api.savePrompt({ id: prompt.id, title: version.title, body: version.body, description: prompt.description, tags: prompt.tags }))
    prompts.set(prompts().map(p => (p.id === saved.id ? saved : p)))
    selectPrompt(saved)
    historyOpen.set(false)
    say(`Restored version ${version.version} as version ${saved.version}.`)
  }
  catch (error) { failed(error, 'Restoring the version') }
}

async function openShare() {
  if (nav().section !== 'prompts' || !library()?.owned) { say('Only the owner can share a library.'); return }
  shareEmail.set('')
  shareRole.set('viewer')
  try {
    shares.set(await api.shares(nav().library))
    shareOpen.set(true)
  }
  catch (error) { failed(error, 'Loading sharing') }
}

async function invite() {
  const email = shareEmail().trim()
  if (!email) return
  try {
    const result = await api.share(nav().library, email, shareRole())
    shareEmail.set('')
    shares.set(await api.shares(nav().library))
    say(result.joined ? `${email} can open the library now.` : `${email} gets it when they sign up.`)
  }
  catch (error) { failed(error, 'Inviting') }
}

async function removeShare(person) {
  try {
    await api.unshare(person.id)
    shares.set({ ...shares(), people: shares().people.filter(p => p.id !== person.id) })
  }
  catch (error) { failed(error, 'Removing access') }
}

async function setLink(event) {
  const on = eventValue(event) === true
  try { shares.set({ ...shares(), link: (await api.setLink(nav().library, on)).link }) }
  catch (error) { failed(error, 'Changing the link') }
}

async function copyLink() {
  if (!linkUrl()) return
  await nativeCraft().clipboard.write(linkUrl())
  say('Link copied.')
}

async function promptMenu(prompt) {
  await choosePrompt(prompt)
  const choice = await desktop().contextMenu([
    { id: 'use', title: 'Use Prompt', icon: 'doc.on.clipboard' },
    { id: 'history', title: 'Version History', icon: 'clock.arrow.circlepath' },
    { separator: true },
    { id: 'delete', title: 'Delete Prompt', icon: 'trash', disabled: !canEdit() },
  ])
  if (choice === 'use') openUse()
  if (choice === 'history') await openHistory()
  if (choice === 'delete') await deletePrompt(prompt)
}

// Search: prompts ask the server; to-dos and notes filter what is loaded.
let searchTimer = 0
function editSearch(event) {
  search.set(eventText(event))
  if (nav().section !== 'prompts') return
  clearTimeout(searchTimer)
  const text = search().trim()
  const id = nav().library
  searchTimer = setTimeout(() => loadPrompts(id, text), 250)
}

// Commands

function command(id) {
  if (id === 'appearance') { scheme.set(nativeCraft().appearance.colorScheme()); return }
  if (id === 'settings') { openSettings(); return }
  if (!signedIn()) return
  const section = nav().section
  if (id.startsWith('go:')) pickNav(id.slice(3))
  else if (id === 'new-todo') newTodo()
  else if (id === 'new-note') newNote()
  else if (id === 'new-prompt') newPrompt()
  else if (id === 'find') desktop().focus('search')
  else if (id === 'refresh') refreshAll()
  else if (id === 'sign-out') signOut()
  else if (id === 'save') { if (section === 'prompts') savePrompt(); else if (section === 'notes') saveNote(); else flushTodo() }
  else if (id === 'complete' && section === 'todos') toggleTodo(selectedTodo())
  else if (id === 'toggle-check' && section === 'notes' && selectedNote()) setNoteBody(toggleChecklist(noteBody()))
  else if (id === 'pin' && section === 'notes') togglePin()
  else if (id === 'use-prompt' && section === 'prompts') openUse()
  else if (id === 'history' && section === 'prompts') openHistory()
  else if (id === 'share') openShare()
  else if (id === 'delete') { if (section === 'todos') deleteTodo(); else if (section === 'notes') deleteNote(); else deletePrompt() }
}

onMount(async () => {
  onDestroy(desktop().onCommand(command))
  onDestroy(nativeCraft().session.onChange((token) => {
    session.adopt(token)
    if (!token && signedIn()) signedOutHere()
    if (token && !signedIn() && !authBusy()) startSession(null)
  }))
  const refresher = setInterval(() => { if (signedIn()) refreshAll() }, 5 * 60 * 1000)
  onDestroy(() => clearInterval(refresher))
  await desktop().setMenus([
    { label: 'File', items: [
      { id: 'new-todo', label: 'New To-Do', shortcut: 'cmd+n' },
      { id: 'new-note', label: 'New Note', shortcut: 'shift+cmd+n' },
      { id: 'new-prompt', label: 'New Prompt', shortcut: 'alt+cmd+n' },
      { separator: true },
      { id: 'save', label: 'Save', shortcut: 'cmd+s' },
      { separator: true },
      { id: 'sign-out', label: 'Sign Out' },
    ] },
    { label: 'View', items: [
      ...SMART_LISTS.map(list => ({ id: `go:list:${list.name}`, label: list.label, shortcut: list.shortcut })),
      { id: 'go:notes:all', label: 'All Notes', shortcut: 'cmd+7' },
      { separator: true },
      { id: 'find', label: 'Find', shortcut: 'cmd+f' },
      { id: 'refresh', label: 'Refresh', shortcut: 'cmd+r' },
    ] },
    { label: 'Item', items: [
      { id: 'complete', label: 'Complete To-Do', shortcut: 'cmd+k' },
      { id: 'toggle-check', label: 'Toggle Checklist', shortcut: 'shift+cmd+l' },
      { id: 'pin', label: 'Pin Note' },
      { separator: true },
      { id: 'use-prompt', label: 'Use Prompt', shortcut: 'cmd+u' },
      { id: 'history', label: 'Version History' },
      { id: 'share', label: 'Share Library' },
      { separator: true },
      { id: 'delete', label: 'Delete' },
    ] },
  ])
  if (signedIn()) startSession(null)
})
</script>

<View class="flex-1 flex-row" testID="main-shell">
  <KeptMacSignIn :if="!signedIn()" class="flex-1" :error="authError()" :busy="authBusy()" :origin="apiOrigin()" :epoch="signOuts()" @submit="signInWith($event)" />

  <View :if="signedIn()" class="flex-col shrink-0 w-[232px] border-r" style="border-color: separator" material="sidebar" testID="sidebar-pane">
    <NativeSidebar class="flex-1" :sections="sections()" :selected="selectedNav()" @change="pickNav(eventValue($event))" testID="sidebar" />
    <View class="flex-row gap-1 items-center pb-3 pt-1 px-3">
      <ToolbarButton label="New To-Do" symbol="plus" testID="sidebar-new-todo" @click="newTodo()" />
      <View class="flex-1" />
      <ToolbarButton label="Settings" symbol="gearshape" testID="sidebar-settings" @click="openSettings()" />
    </View>
  </View>

  <View :if="signedIn() && nav().section === 'todos'" class="flex-1 flex-col min-w-0" :style="{backgroundColor: colors().list}" testID="todos-pane">
    <View class="flex-row gap-3 items-center pb-1 pt-5 px-6">
      <Icon :symbol="headerSymbol()" class="h-[24px] w-[24px]" :style="{color: headerColor()}" />
      <Text class="flex-1 font-semibold text-[24px]" :numberOfLines="1" :text="title()" testID="list-title" />
      <View class="w-[190px]"><TextInput type="search" class="h-[26px] text-[12px]" placeholder="Search" :value="search()" @input="editSearch($event)" testID="search" /></View>
    </View>
    <Text class="pb-3 px-6 text-[11.5px]" style="color: secondaryLabel" :text="listCount() === 1 ? '1 to-do' : listCount() + ' to-dos'" testID="list-count" />
    <View :if="offline()" class="pb-2 px-6" testID="offline-note">
      <View class="flex-row gap-2 items-center px-3 py-[5px] rounded-[7px]" :style="{backgroundColor: colors().hover}">
        <Icon symbol="wifi.slash" class="h-[13px] w-[13px]" style="color: secondaryLabel" />
        <Text class="text-[11.5px]" style="color: secondaryLabel" :text="'Offline, showing saved items'" />
      </View>
    </View>
    <View :if="canAdd()" class="pb-1 px-4">
      <View class="flex-row gap-2 items-center pl-2 pr-1 h-[34px] rounded-[8px]" :style="{backgroundColor: colors().hover}">
      <Icon symbol="plus.circle" class="h-[17px] w-[17px]" style="color: accent" />
      <View class="flex-1"><TextInput class="h-[22px] text-[13px]" :multiline="true" :bordered="false" placeholder="New To-Do, press Return to add" :value="quick()" @input="quick.set(eventText($event))" @submit="addQuick()" testID="quick-entry" /></View>
      <Button :if="quick().trim()" title="Add" variant="ghost" class="text-[12px]" testID="quick-add" @click="addQuick()" />
      </View>
    </View>
    <ScrollView class="flex-1" testID="todo-list">
      <View class="flex-col pb-6 pt-1 px-4">
        <View :for="group in groups()" :key="group.key" class="flex-col">
          <View :if="group.label" class="flex-row gap-2 items-end pb-1 pt-5 px-2 border-b" style="border-color: separator">
            <Text class="font-semibold text-[15px]" :text="group.label" />
            <Text :if="group.sub" class="text-[11.5px]" style="color: secondaryLabel" :text="group.sub" />
          </View>
          <KeptMacTodoRow :for="todo in group.items" :key="todo.id" :item="todo" :chips="chipsFor(todo)" :selected="todo.id === todoId()" :colors="colors()" @choose="selectTodo(todo)" @toggle="toggleTodo(todo)" @menu="todoMenu(todo)" />
        </View>
        <View :if="!listCount()" class="gap-2 items-center pt-16" testID="empty-list">
          <Icon :symbol="headerSymbol()" class="h-[36px] w-[36px]" style="color: secondaryLabel" />
          <Text class="text-[13px]" style="color: secondaryLabel" :text="search() ? 'Nothing matches your search.' : loading() && !todosLoaded() ? 'Loading your to-dos' : 'Nothing here. Enjoy the calm.'" />
        </View>
      </View>
    </ScrollView>
    <Text :if="flash()" class="px-6 py-2 text-[11.5px] border-t" style="color: secondaryLabel; border-color: separator" :text="flash()" testID="status-message" />
  </View>

  <View :if="signedIn() && nav().section === 'todos' && selectedTodo()" class="flex-col shrink-0 w-[360px] border-l" :style="{backgroundColor: colors().detail, borderColor: 'separator'}" testID="todo-detail">
    <ScrollView class="flex-1">
      <View class="flex-col gap-3 p-5">
        <View class="flex-row gap-2 items-center">
          <Pressable class="items-center justify-center h-[24px] w-[24px]" testID="detail-check" @click="toggleTodo(selectedTodo())">
            <Icon :symbol="selectedTodo()?.completed_at ? 'checkmark.circle.fill' : 'circle'" class="h-[19px] w-[19px]" :style="{color: selectedTodo()?.completed_at ? 'accent' : 'secondaryLabel'}" />
          </Pressable>
          <View class="flex-1"><TextInput class="h-[28px] font-semibold text-[15px]" :value="dTitle()" placeholder="To-do title" @input="editTodo('title', $event)" testID="detail-title" /></View>
        </View>
        <TextInput class="h-[96px] text-[13px]" :multiline="true" :value="dNotes()" placeholder="Notes" @input="editTodo('notes', $event)" testID="detail-notes" />
        <Text class="pt-1 font-semibold text-[11px]" style="color: secondaryLabel" :text="'CHECKLIST'" />
        <View class="flex-col gap-[2px]">
          <View :for="item in (selectedTodo()?.checklist || [])" :key="item.id" class="flex-row gap-2 items-center h-[26px]">
            <Pressable class="items-center justify-center h-[20px] w-[20px]" :testID="'checkitem-' + item.id" @click="toggleCheckItem(item)">
              <Icon :symbol="item.done ? 'checkmark.circle.fill' : 'circle'" class="h-[14px] w-[14px]" :style="{color: item.done ? 'accent' : 'secondaryLabel'}" />
            </Pressable>
            <Text class="flex-1 text-[12.5px]" :numberOfLines="1" :style="{color: item.done ? 'secondaryLabel' : 'label'}" :text="item.title" />
            <ToolbarButton label="Remove item" symbol="xmark" @click="deleteCheckItem(item)" />
          </View>
          <View class="flex-row gap-2 items-center">
            <View class="flex-1"><TextInput class="h-[24px] text-[12.5px]" :multiline="true" :value="dCheck()" placeholder="Add an item, then Return" @input="dCheck.set(eventText($event))" @submit="addCheckItem()" testID="detail-check-input" /></View>
            <ToolbarButton label="Add item" symbol="plus" :disabled="!dCheck().trim()" testID="detail-check-add" @click="addCheckItem()" />
          </View>
        </View>
        <View class="flex-row gap-3 items-center pt-1">
          <Text class="w-[72px] text-[12px]" style="color: secondaryLabel" :text="'When'" />
          <View class="flex-1"><Picker :value="dWhen()" :options="WHEN_CHOICES" @change="chooseWhen($event)" testID="detail-when" /></View>
        </View>
        <View class="flex-row gap-3 items-center">
          <Text class="w-[72px] text-[12px]" style="color: secondaryLabel" :text="'Start date'" />
          <View class="flex-1"><TextInput class="h-[24px] text-[12.5px]" :value="dStart()" placeholder="YYYY-MM-DD" @input="editTodo('start', $event)" testID="detail-start" /></View>
        </View>
        <View class="flex-row gap-3 items-center">
          <Text class="w-[72px] text-[12px]" style="color: secondaryLabel" :text="'Deadline'" />
          <View class="flex-1"><TextInput class="h-[24px] text-[12.5px]" :value="dDeadline()" placeholder="YYYY-MM-DD" @input="editTodo('deadline', $event)" testID="detail-deadline" /></View>
        </View>
        <View class="flex-row gap-3 items-center">
          <Text class="w-[72px] text-[12px]" style="color: secondaryLabel" :text="'Tags'" />
          <View class="flex-1"><TextInput class="h-[24px] text-[12.5px]" :value="dTags()" placeholder="errands, phone" @input="editTodo('tags', $event)" testID="detail-tags" /></View>
        </View>
        <View class="flex-row gap-3 items-center">
          <Text class="w-[72px] text-[12px]" style="color: secondaryLabel" :text="'Repeat'" />
          <View class="flex-1"><Picker :value="dRepeat()" :options="REPEATS" @change="chooseRepeat($event)" testID="detail-repeat" /></View>
        </View>
        <Text :if="dHint()" class="text-[11px]" style="color: secondaryLabel" :text="dHint()" testID="detail-hint" />
        <View class="flex-row justify-end pt-2">
          <Button title="Delete To-Do" symbol="trash" variant="danger" testID="detail-delete" @click="deleteTodo()" />
        </View>
      </View>
    </ScrollView>
  </View>

  <View :if="signedIn() && nav().section === 'notes'" class="flex-col shrink-0 w-[290px] border-r" :style="{backgroundColor: colors().detail, borderColor: 'separator'}" testID="notes-pane">
    <View class="flex-row gap-2 items-center pb-2 pt-4 px-4">
      <Text class="flex-1 font-semibold text-[18px]" :numberOfLines="1" :text="title()" testID="list-title" />
      <ToolbarButton label="New Note" symbol="square.and.pencil" testID="new-note" @click="newNote()" />
    </View>
    <View class="pb-2 px-3"><TextInput type="search" class="h-[26px] text-[12px]" placeholder="Search notes" :value="search()" @input="editSearch($event)" testID="search" /></View>
    <View :if="offline()" class="pb-2 px-3" testID="offline-note">
      <View class="flex-row gap-2 items-center px-3 py-[5px] rounded-[7px]" :style="{backgroundColor: colors().hover}">
        <Icon symbol="wifi.slash" class="h-[13px] w-[13px]" style="color: secondaryLabel" />
        <Text class="text-[11.5px]" style="color: secondaryLabel" :text="'Offline, showing saved items'" />
      </View>
    </View>
    <ScrollView class="flex-1" testID="note-list">
      <View class="flex-col pb-4 px-2">
        <View :for="group in noteSections()" :key="group.key" class="flex-col gap-[1px]">
          <Text :if="group.label" class="pb-1 pt-3 px-3 font-semibold text-[11px]" style="color: secondaryLabel" :text="group.label.toUpperCase()" />
          <KeptMacListRow :for="note in group.notes" :key="note.id" :rowId="'note-' + note.id" :title="note.title" :subtitle="note.snippet" :meta="noteStamp(note.updated_at)" :symbol="note.pinned ? 'pin.fill' : ''" :selected="note.id === noteId()" :colors="colors()" @choose="selectNote(note)" @menu="noteMenu(note)" />
        </View>
        <Text :if="!noteCount()" class="p-4 text-[12px]" style="color: secondaryLabel" :text="search() ? 'No notes match.' : 'No notes yet. Press Shift Command N to start one.'" testID="notes-empty" />
      </View>
    </ScrollView>
  </View>

  <View :if="signedIn() && nav().section === 'notes'" class="flex-1 flex-col min-w-0" :style="{backgroundColor: colors().list}" testID="note-editor-pane">
    <View :if="selectedNote()" class="flex-row gap-1 items-center px-4 h-[44px] border-b" style="border-color: separator">
      <Text class="flex-1 text-[11.5px]" style="color: secondaryLabel" :text="selectedNote() ? 'Edited ' + noteStamp(selectedNote().updated_at) : ''" />
      <ToolbarButton label="Toggle Checklist" symbol="checklist" testID="note-checklist" @click="setNoteBody(toggleChecklist(noteBody()))" />
      <ToolbarButton label="Add Check Item" symbol="plus.circle" testID="note-add-check" @click="setNoteBody(appendCheckLine(noteBody()))" />
      <ToolbarButton :label="selectedNote()?.pinned ? 'Unpin' : 'Pin'" :symbol="selectedNote()?.pinned ? 'pin.slash' : 'pin'" testID="note-pin" @click="togglePin()" />
      <ToolbarButton label="Delete Note" symbol="trash" testID="note-delete" @click="deleteNote()" />
    </View>
    <View :if="selectedNote()" class="flex-1 flex-col pt-3 px-5">
      <TextInput class="flex-1 text-[14px]" :multiline="true" :bordered="false" :value="noteBody()" placeholder="Start writing" @input="editNote($event)" testID="note-editor" />
    </View>
    <View :if="selectedNote() && noteChecks().length" class="flex-col gap-[2px] px-5 py-3 border-t" style="border-color: separator" testID="note-checks">
      <Text class="pb-1 font-semibold text-[11px]" style="color: secondaryLabel" :text="'CHECKLIST'" />
      <Pressable :for="check in noteChecks()" :key="check.line" class="flex-row gap-2 items-center h-[22px]" :testID="'note-check-' + check.line" @click="setNoteBody(toggleCheckLine(noteBody(), check.line))">
        <Icon :symbol="check.done ? 'checkmark.circle.fill' : 'circle'" class="h-[14px] w-[14px]" :style="{color: check.done ? 'accent' : 'secondaryLabel'}" />
        <Text class="flex-1 text-[12.5px]" :numberOfLines="1" :style="{color: check.done ? 'secondaryLabel' : 'label'}" :text="check.text || 'Empty item'" />
      </Pressable>
    </View>
    <View :if="!selectedNote()" class="flex-1 gap-2 items-center justify-center">
      <Icon symbol="note.text" class="h-[38px] w-[38px]" style="color: secondaryLabel" />
      <Text class="text-[13px]" style="color: secondaryLabel" :text="'Choose a note, or start a new one.'" />
      <Button title="New Note" variant="ghost" @click="newNote()" />
    </View>
    <Text :if="flash()" class="px-5 py-2 text-[11.5px] border-t" style="color: secondaryLabel; border-color: separator" :text="flash()" testID="status-message" />
  </View>

  <View :if="signedIn() && nav().section === 'prompts'" class="flex-col shrink-0 w-[300px] border-r" :style="{backgroundColor: colors().detail, borderColor: 'separator'}" testID="prompts-pane">
    <View class="flex-row gap-2 items-center pb-1 pt-4 px-4">
      <Text class="flex-1 font-semibold text-[18px]" :numberOfLines="1" :text="title()" testID="list-title" />
      <ToolbarButton :if="library()?.owned" label="Share Library" symbol="person.crop.circle.badge.plus" testID="share-library" @click="openShare()" />
      <ToolbarButton :if="canEdit()" label="New Prompt" symbol="square.and.pencil" testID="new-prompt" @click="newPrompt()" />
    </View>
    <Text class="pb-2 px-4 text-[11px]" style="color: secondaryLabel" :text="library()?.owned ? (library().library.description || 'Your library') : ('Shared by ' + (library()?.library.owner || 'someone') + (canEdit() ? ', you can edit' : ', view only'))" testID="library-role" />
    <View class="pb-2 px-3"><TextInput type="search" class="h-[26px] text-[12px]" placeholder="Search prompts" :value="search()" @input="editSearch($event)" testID="search" /></View>
    <View :if="offline()" class="pb-2 px-3" testID="offline-note">
      <View class="flex-row gap-2 items-center px-3 py-[5px] rounded-[7px]" :style="{backgroundColor: colors().hover}">
        <Icon symbol="wifi.slash" class="h-[13px] w-[13px]" style="color: secondaryLabel" />
        <Text class="text-[11.5px]" style="color: secondaryLabel" :text="'Offline, showing saved items'" />
      </View>
    </View>
    <ScrollView class="flex-1" testID="prompt-list">
      <View class="flex-col gap-[1px] pb-4 px-2">
        <KeptMacListRow :for="prompt in shownPrompts()" :key="prompt.id" :rowId="'prompt-' + prompt.id" :title="prompt.title" :subtitle="prompt.description || prompt.body" :meta="prompt.uses ? (prompt.uses === 1 ? '1 use' : prompt.uses + ' uses') : ''" :symbol="prompt.favorite ? 'star.fill' : ''" :selected="prompt.id === promptId()" :colors="colors()" @choose="choosePrompt(prompt)" @menu="promptMenu(prompt)" />
        <Text :if="!shownPrompts().length" class="p-4 text-[12px]" style="color: secondaryLabel" :text="search() ? 'No prompts match.' : 'No prompts in this library yet.'" testID="prompts-empty" />
      </View>
    </ScrollView>
  </View>

  <View :if="signedIn() && nav().section === 'prompts'" class="flex-1 flex-col min-w-0" :style="{backgroundColor: colors().list}" testID="prompt-editor-pane">
    <View :if="selectedPrompt()" class="flex-row gap-2 items-center px-4 h-[44px] border-b" style="border-color: separator">
      <Text class="flex-1 text-[11.5px]" style="color: secondaryLabel" :text="selectedPrompt() ? 'Version ' + selectedPrompt().version + (pDirty() ? ', edited' : '') : ''" testID="prompt-version" />
      <Button :if="canEdit()" title="Save" :disabled="!pDirty()" testID="prompt-save" @click="savePrompt()" />
      <ToolbarButton label="Version History" symbol="clock.arrow.circlepath" testID="prompt-history" @click="openHistory()" />
      <ToolbarButton :if="canEdit()" label="Delete Prompt" symbol="trash" testID="prompt-delete" @click="deletePrompt()" />
      <Button title="Use" symbol="doc.on.clipboard" variant="primary" testID="prompt-use" @click="openUse()" />
    </View>
    <View :if="selectedPrompt()" class="flex-1 flex-col gap-3 px-6 py-4">
      <TextInput class="h-[30px] font-semibold text-[17px]" :value="pTitle()" :disabled="!canEdit()" placeholder="Prompt title" @input="editPrompt('title', $event)" testID="prompt-title" />
      <TextInput class="h-[24px] text-[12.5px]" :value="pDesc()" :disabled="!canEdit()" placeholder="What it is for" @input="editPrompt('description', $event)" testID="prompt-description" />
      <TextInput class="h-[24px] text-[12.5px]" :value="pTags()" :disabled="!canEdit()" placeholder="Tags, separated by commas" @input="editPrompt('tags', $event)" testID="prompt-tags" />
      <TextInput class="flex-1 text-[13px]" :multiline="true" :value="pBody()" :disabled="!canEdit()" placeholder="Write the prompt. Put a variable in double braces where details go." @input="editPrompt('body', $event)" testID="prompt-body" />
      <View class="flex-row gap-2 items-center" testID="prompt-variables">
        <Text class="text-[11.5px]" style="color: secondaryLabel" :text="variables().length ? 'Variables' : 'No variables yet. Wrap a name in double braces to add one.'" />
        <View :for="name in variables()" :key="name" class="justify-center px-[7px] h-[20px] rounded-[6px]" :style="{backgroundColor: colors().variableFill}">
          <Text class="text-[11.5px]" :style="{color: colors().variable}" :text="name" />
        </View>
      </View>
    </View>
    <View :if="!selectedPrompt()" class="flex-1 gap-2 items-center justify-center">
      <Icon symbol="text.book.closed" class="h-[38px] w-[38px]" style="color: secondaryLabel" />
      <Text class="text-[13px]" style="color: secondaryLabel" :text="'Choose a prompt to read, edit or use.'" />
    </View>
    <Text :if="flash()" class="px-5 py-2 text-[11.5px] border-t" style="color: secondaryLabel; border-color: separator" :text="flash()" testID="status-message" />
  </View>

  <Modal :if="useOpen()" :visible="true" title="Use Prompt" testID="use-sheet">
    <View class="flex-col gap-3 p-6">
      <Text class="font-semibold text-[17px]" :text="selectedPrompt()?.title || 'Prompt'" />
      <Text :if="!variables().length" class="text-[12px]" style="color: secondaryLabel" :text="'This prompt has no variables. Copy it as it is.'" />
      <View :for="name in variables()" :key="name" class="flex-row gap-3 items-center">
        <Text class="w-[110px] text-[12px]" :numberOfLines="1" :text="name" />
        <View class="flex-1"><TextInput class="h-[24px] text-[12.5px]" :value="useValues()[name] || ''" :placeholder="name" @input="setVariable(name, $event)" :testID="'use-var-' + name" /></View>
      </View>
      <Text class="pt-1 font-semibold text-[11px]" style="color: secondaryLabel" :text="'PREVIEW'" />
      <View class="p-3 rounded-[8px]" :style="{backgroundColor: colors().hover}">
        <Text class="text-[12.5px]" :text="filled()" testID="use-preview" />
      </View>
      <View class="flex-row gap-2 justify-end pt-1">
        <Button title="Cancel" testID="use-cancel" @click="useOpen.set(false)" />
        <Button title="Copy" symbol="doc.on.doc" variant="primary" testID="use-copy" @click="copyFilled()" />
      </View>
    </View>
  </Modal>

  <Modal :if="historyOpen()" :visible="true" title="Version History" testID="history-sheet">
    <View class="flex-col gap-3 p-6">
      <Text class="font-semibold text-[17px]" :text="'Version history'" />
      <Text :if="!versions().length" class="text-[12px]" style="color: secondaryLabel" :text="'No earlier versions.'" />
      <View :for="version in versions()" :key="version.id" class="flex-row gap-3 items-start py-2 border-b" style="border-color: separator" :testID="'version-' + version.version">
        <View class="flex-1 flex-col gap-[2px]">
          <Text class="font-semibold text-[12.5px]" :text="'Version ' + version.version + (version.author ? ', by ' + version.author : '')" />
          <Text class="text-[11.5px]" style="color: secondaryLabel" :numberOfLines="2" :text="version.body" />
        </View>
        <Button :if="canEdit() && version.version !== selectedPrompt()?.version" title="Restore" :testID="'restore-' + version.version" @click="restoreVersion(version)" />
      </View>
      <View class="flex-row justify-end pt-1"><Button title="Done" testID="history-done" @click="historyOpen.set(false)" /></View>
    </View>
  </Modal>

  <Modal :if="shareOpen()" :visible="true" title="Share Library" testID="share-sheet">
    <View class="flex-col gap-3 p-6 min-h-[360px]">
      <Text class="font-semibold text-[17px]" :text="'Share ' + title()" />
      <View class="flex-row gap-2 items-center">
        <View class="flex-1"><TextInput class="h-[24px] text-[12.5px]" :value="shareEmail()" placeholder="Email address" @input="shareEmail.set(eventText($event))" testID="share-email" /></View>
        <View class="w-[100px]"><Picker :value="shareRole()" :options="[{value:'viewer',label:'Viewer'},{value:'editor',label:'Editor'}]" @change="shareRole.set(String(eventValue($event)))" testID="share-role" /></View>
        <Button title="Invite" variant="primary" :disabled="!shareEmail().trim()" testID="share-invite" @click="invite()" />
      </View>
      <Text :if="!shares().people.length" class="text-[12px]" style="color: secondaryLabel" :text="'Nobody else has this library yet.'" />
      <View :for="person in shares().people" :key="person.id" class="flex-row gap-2 items-center py-1" :testID="'share-person-' + person.id">
        <View class="flex-1 flex-col">
          <Text class="text-[12.5px]" :numberOfLines="1" :text="person.name || person.email" />
          <Text class="text-[11px]" style="color: secondaryLabel" :numberOfLines="1" :text="person.email + (person.accepted ? '' : ', invited')" />
        </View>
        <Text class="text-[11.5px]" style="color: secondaryLabel" :text="person.role === 'editor' ? 'Editor' : 'Viewer'" />
        <ToolbarButton label="Remove access" symbol="xmark.circle" :testID="'share-remove-' + person.id" @click="removeShare(person)" />
      </View>
      <View class="flex-row gap-2 items-center pt-2 border-t" style="border-color: separator">
        <Switch :value="!!shares().link" @change="setLink($event)" testID="share-link-toggle" />
        <Text class="flex-1 text-[12.5px]" :text="'Anyone with the link can view'" />
        <Button :if="linkUrl()" title="Copy Link" symbol="link" testID="share-copy-link" @click="copyLink()" />
      </View>
      <Text :if="linkUrl()" class="text-[11px]" style="color: secondaryLabel" :text="linkUrl()" testID="share-link" />
      <View class="flex-row justify-end pt-1"><Button title="Done" testID="share-done" @click="shareOpen.set(false)" /></View>
    </View>
  </Modal>
</View>
