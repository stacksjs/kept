<script client>
const error = useReactiveProp('error', '')
const busy = useReactiveProp('busy', false)
const origin = useReactiveProp('origin', '')
const epoch = useReactiveProp('epoch', 0)
const emit = defineEmits(['submit'])
const creating = state(false)
const name = state('')
const email = state('')
const password = state('')
// A new sign-out clears the password field; the email stays for convenience.
effect(() => { if (epoch()) password.set('') })
const ready = derived(() => !!email().trim() && password().length >= 8 && (!creating() || !!name().trim()))
function send() {
  if (!ready() || busy()) return
  emit('submit', { mode: creating() ? 'register' : 'login', name: name().trim(), email: email().trim(), password: password() })
}
</script>
<View class="flex-1 items-center justify-center" testID="sign-in">
  <View class="gap-3 items-stretch w-[340px]">
    <View class="gap-2 items-stretch pb-2">
      <Icon symbol="checkmark.circle.fill" class="self-center h-[44px] w-[44px]" style="color: accent" />
      <Text class="font-semibold text-[22px] text-center" :text="creating() ? 'Create your Kept account' : 'Sign in to Kept'" testID="sign-in-title" />
      <Text class="text-[12px] text-center" style="color: secondaryLabel" :text="'To-dos, notes and prompts on every device.'" />
    </View>
    <TextInput :if="creating()" x-model="name" placeholder="Name" class="h-[28px]" testID="sign-in-name" />
    <TextInput x-model="email" placeholder="Email" class="h-[28px]" testID="sign-in-email" />
    <TextInput type="password" x-model="password" placeholder="Password (8 or more characters)" class="h-[28px]" testID="sign-in-password" />
    <Text :if="error()" class="text-[12px]" style="color: #c62828" :text="error()" testID="sign-in-error" />
    <Button :title="busy() ? 'One moment' : creating() ? 'Create Account' : 'Sign In'" variant="primary" :disabled="!ready() || busy()" testID="sign-in-submit" @click="send()" />
    <Button :title="creating() ? 'I already have an account' : 'Create an account'" variant="ghost" testID="sign-in-mode" @click="creating.set(!creating())" />
    <Text class="pt-2 text-[10.5px] text-center" style="color: secondaryLabel" :text="'Server: ' + origin()" />
  </View>
</View>
