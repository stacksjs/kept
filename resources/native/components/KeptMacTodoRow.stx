<script client>
const row = useReactiveProp('item', {})
const marks = useReactiveProp('marks', {})
const selected = useReactiveProp('selected', false)
const colors = useReactiveProp('colors', {})
const emit = defineEmits(['choose', 'toggle', 'menu'])
function done() { return !!(row().completed_at || row().canceled_at) }
</script>
<View class="flex-row gap-[9px] items-center px-[12px] h-[28px] rounded-[6px]" :style="{backgroundColor: selected() ? colors().selection : 'transparent'}" :testID="'row-' + row().id">
  <Pressable class="items-center justify-center shrink-0 h-[14px] w-[14px] border rounded-[3px]" :style="{borderColor: done() ? colors().accent : colors().checkbox, backgroundColor: done() ? colors().accent : 'transparent'}" :accessibilityLabel="done() ? 'Mark as not done' : 'Complete'" :testID="'check-' + row().id" @click="emit('toggle')">
    <Icon :if="done()" symbol="checkmark" class="h-[9px] w-[9px]" style="color: #ffffff" />
  </Pressable>
  <Pressable class="flex-1 flex-row gap-[6px] items-center h-[28px] min-w-0" :testID="'todo-' + row().id" @click="emit('choose')" @contextmenu="emit('menu')">
    <Icon :if="marks().star" symbol="star.fill" class="shrink-0 h-[12px] w-[12px]" style="color: #f7c600" />
    <Icon :if="marks().evening" symbol="moon.fill" class="shrink-0 h-[11px] w-[11px]" style="color: #4f6bd8" />
    <Text class="shrink min-w-[60px] text-[15px]" :numberOfLines="1" :style="{color: done() ? 'secondaryLabel' : 'label', textDecorationLine: done() ? 'line-through' : 'none'}" :text="row().title || 'New To-Do'" />
    <Icon :if="marks().notes" symbol="doc" class="shrink-0 h-[11px] w-[10px]" style="color: secondaryLabel" />
    <Icon :if="marks().repeat" symbol="repeat" class="shrink-0 h-[10px] w-[10px]" style="color: secondaryLabel" />
    <Text :if="marks().project" class="shrink-0 text-[12px]" :numberOfLines="1" style="color: secondaryLabel" :text="marks().project" />
    <View class="flex-1" />
    <Text :if="marks().checklist" class="shrink-0 text-[12px]" style="color: secondaryLabel" :text="marks().checklist" />
    <View :for="tag in marks().tags" :key="tag" class="justify-center shrink-0 px-[6px] h-[17px] rounded-[8px]" :style="{backgroundColor: colors().hover}">
      <Text class="text-[11px]" :numberOfLines="1" style="color: secondaryLabel" :text="tag" />
    </View>
    <Text :if="marks().date" class="shrink-0 text-[12px]" style="color: secondaryLabel" :text="marks().date" />
    <View :if="marks().deadline" class="flex-row gap-[3px] items-center shrink-0">
      <Icon symbol="flag.fill" class="h-[10px] w-[10px]" :style="{color: marks().overdue ? '#e5484d' : '#8e8e93'}" />
      <Text class="text-[12px]" :style="{color: marks().overdue ? '#e5484d' : 'secondaryLabel'}" :text="marks().deadline" />
    </View>
  </Pressable>
</View>
